#!/usr/bin/env node
/* eslint-disable no-console */
/**
 * bin/backfill-sharing-rules — write the sharing rule onto document types
 * that predate it (decision C-003, migration 0137).
 *
 * WHAT THIS DOES, AND WHY IT IS SAFE TO RUN LATE
 *
 * Migration 0137 added `document_types.sharing_rule` as a nullable column with
 * no default. A NULL is not "no rule": the portal resolves it at read time
 * from the type's name (shared/sharingRule.ts) -- a Certificate of Analysis
 * reads "send freely", a W-9 reads "locked", a name nobody recognises reads
 * "needs QA approval". So there is no window in which a type is unguarded, and
 * this script changes NOTHING about what may leave the portal.
 *
 * What it changes is that the answer becomes a STORED setting: the value the
 * Document Types screen shows, that an admin can see and change, and that does
 * not move if the name-matching table is ever edited. New types already get a
 * stored rule (POST /api/document-types and both starter-pack appliers); this
 * pass is for the types created before 0137.
 *
 * WHAT IT WRITES, AND WHAT IT REFUSES TO TOUCH
 *
 *   filled      a type whose `sharing_rule` IS NULL gets the rule its name
 *               reads as today. Nothing else about the type is changed.
 *   left alone  a type that already has a stored rule. Never re-decided,
 *               whatever its name suggests.
 *   reported    a type holding a value that is not one of the three words.
 *               Not overwritten (something wrote it); the portal already reads
 *               it as the name default. Shown so a person can look.
 *
 * The UPDATE carries `sharing_rule IS NULL` in its own WHERE, so a rule an
 * admin sets between the dry run and the apply is not overwritten.
 *
 * Documents are not touched. A document's own override
 * (`documents.sharing_rule_override`) is set by a person on the document page,
 * never by a script. The run also counts each organization's active documents
 * with NO type, because those read "locked" and nobody may have expected it.
 *
 * Usage:
 *   bin/backfill-sharing-rules --all                           # dry run, LOCAL, every tenant
 *   bin/backfill-sharing-rules --tenant <id>                   # dry run, LOCAL
 *   bin/backfill-sharing-rules --tenant <id> --remote          # dry run, PRODUCTION
 *   bin/backfill-sharing-rules --tenant <id> --apply           # LOCAL write
 *   bin/backfill-sharing-rules --tenant <id> --remote --apply  # prompts first
 *
 * Flags:
 *   --tenant ID       tenant to fill (required unless --all)
 *   --all             every tenant in the database (reporting only; refuses --apply)
 *   --apply           actually write. Without it this is a dry run.
 *   --remote, -r      target PRODUCTION D1 (with --apply, asks you to type the tenant id)
 *   --persist-to DIR  LOCAL only: use the local D1 state under DIR. A git worktree
 *                     has no .wrangler of its own; point this at the main checkout's.
 *   --yes, -y         skip the production confirmation prompt
 *   --json            emit the plan as JSON instead of prose
 *   -h, --help        this help
 */

const fs = require('fs');
const os = require('os');
const path = require('path');
const { execFileSync } = require('child_process');

const { flattenRows, isReadOnly, PROJECT_ROOT, DEFAULT_DB } = require('./lib/d1');
const { planSharingRuleBackfill, fillToSql, SHARING_RULE_LABELS } = require('./lib/sharingRuleBackfill');

function parseArgs(argv) {
  const opts = { tenant: null, all: false, apply: false, remote: false, yes: false, json: false, persistTo: null };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    switch (a) {
      case '--tenant': opts.tenant = argv[++i]; break;
      case '--all': opts.all = true; break;
      case '--apply': opts.apply = true; break;
      case '--remote':
      case '-r': opts.remote = true; break;
      case '--persist-to': opts.persistTo = argv[++i]; break;
      case '--yes':
      case '-y': opts.yes = true; break;
      case '--json': opts.json = true; break;
      case '-h':
      case '--help': printHelp(); process.exit(0); break;
      default:
        console.error(`Unknown argument: ${a}`);
        process.exit(2);
    }
  }
  if (!opts.tenant && !opts.all) {
    console.error('--tenant <id> is required (or --all). Run with --help for usage.');
    process.exit(2);
  }
  if (opts.tenant && !/^[A-Za-z0-9_-]+$/.test(opts.tenant)) {
    console.error('--tenant must be an id: letters, digits, dashes, underscores.');
    process.exit(2);
  }
  if (opts.all && opts.apply) {
    // Writing every tenant at once removes the one moment where somebody reads
    // the plan for the tenant they meant. Apply is per tenant, always.
    console.error('--all is a reporting mode. Re-run with --tenant <id> --apply to write one tenant.');
    process.exit(2);
  }
  if (opts.persistTo !== null && (!opts.persistTo || opts.persistTo.startsWith('--'))) {
    console.error('--persist-to requires a directory.');
    process.exit(2);
  }
  if (opts.persistTo && opts.remote) {
    console.error('--persist-to is for LOCAL D1 only.');
    process.exit(2);
  }
  return opts;
}

function printHelp() {
  const lines = fs.readFileSync(__filename, 'utf8').split('\n');
  const end = lines.findIndex((l, i) => i > 2 && l.trim() === '*/');
  console.log(lines.slice(3, end).join('\n').replace(/^ \* ?/gm, ''));
}

function sqlStr(v) {
  if (v === null || v === undefined) return 'NULL';
  return `'${String(v).replace(/'/g, "''")}'`;
}

/** Where wrangler should look: production, the default local state, or DIR. */
function targetArgs(opts) {
  if (opts.remote) return ['--remote'];
  return opts.persistTo ? ['--local', `--persist-to=${opts.persistTo}`] : ['--local'];
}

/** A read. Refuses anything that is not a SELECT, like bin/lib/d1.js. */
function query(sql, opts) {
  if (!isReadOnly(sql)) throw new Error(`refusing a non-SELECT read: ${String(sql).slice(0, 80)}`);
  let out;
  try {
    out = execFileSync(
      'npx',
      ['wrangler', 'd1', 'execute', DEFAULT_DB, ...targetArgs(opts), '--json', '--command', sql],
      { cwd: PROJECT_ROOT, stdio: ['ignore', 'pipe', 'pipe'], maxBuffer: 256 * 1024 * 1024 },
    ).toString();
  } catch (err) {
    const stderr = err.stderr ? err.stderr.toString() : '';
    const stdout = err.stdout ? err.stdout.toString() : '';
    throw new Error(`d1 query failed: ${stderr || err.message}${stdout ? `\n${stdout}` : ''}`);
  }
  return flattenRows(out);
}

function execSql(statements, opts, label) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'dox-sharing-rule-backfill-'));
  const file = path.join(dir, `${label}.sql`);
  fs.writeFileSync(file, `${statements.join('\n')}\n`, 'utf8');
  try {
    execFileSync(
      'npx',
      ['wrangler', 'd1', 'execute', DEFAULT_DB, ...targetArgs(opts), `--file=${file}`],
      { cwd: PROJECT_ROOT, stdio: ['ignore', 'pipe', 'pipe'], maxBuffer: 64 * 1024 * 1024 },
    );
  } catch (err) {
    const stderr = err.stderr ? err.stderr.toString() : '';
    throw new Error(`Writing to D1 failed. The SQL is at ${file}\n${stderr || err.message}`);
  }
  fs.rmSync(dir, { recursive: true, force: true });
}

function promptSync(question) {
  process.stdout.write(question);
  let fd;
  try {
    fd = fs.openSync('/dev/tty', 'rs');
  } catch {
    console.error('\nNo terminal to confirm on. Re-run interactively, or pass --yes.');
    process.exit(1);
  }
  const buf = Buffer.alloc(256);
  let out = '';
  for (;;) {
    const n = fs.readSync(fd, buf, 0, buf.length, null);
    if (n === 0) break;
    out += buf.toString('utf8', 0, n);
    if (out.includes('\n')) break;
  }
  fs.closeSync(fd);
  return out.split('\n')[0];
}

function hasColumn(table, column, opts) {
  const rows = query(`SELECT COUNT(*) AS n FROM pragma_table_info('${table}') WHERE name = '${column}'`, opts);
  return Number((rows || [])[0]?.n ?? 0) > 0;
}

function planTenant(tenantId, opts) {
  const types = query(
    `SELECT id, name, slug, active, sharing_rule
       FROM document_types
      WHERE tenant_id = ${sqlStr(tenantId)}
      ORDER BY name`,
    opts,
  );
  const untyped = query(
    `SELECT COUNT(*) AS n
       FROM documents d
       LEFT JOIN document_types dt ON dt.id = d.document_type_id
      WHERE d.tenant_id = ${sqlStr(tenantId)} AND d.status = 'active'
        AND dt.id IS NULL AND d.sharing_rule_override IS NULL`,
    opts,
  );
  return { tenantId, ...planSharingRuleBackfill(types), untyped_documents: Number(untyped[0]?.n ?? 0) };
}

function formatPlan(plan, label) {
  const lines = [];
  const label3 = (rule) => `${rule} (${SHARING_RULE_LABELS[rule]})`;
  lines.push('');
  lines.push(`Sharing rules -- ${label}`);
  lines.push(`  document types:                     ${plan.total}`);
  lines.push(`  already have a stored rule:         ${plan.stored.length}`);
  lines.push(`  would be filled:                    ${plan.fills.length}`);
  if (plan.unreadable.length) {
    lines.push(`  hold a value that is not a rule:    ${plan.unreadable.length}`);
  }
  lines.push(`  active documents with no type:      ${plan.untyped_documents}  (these read locked)`);
  lines.push('');
  for (const rule of ['free', 'qa', 'locked']) {
    const rows = plan.fills.filter((f) => f.rule === rule);
    if (rows.length === 0) continue;
    lines.push(`  FILL as ${label3(rule)}`);
    for (const f of rows) lines.push(`    ${f.name}${f.active ? '' : '  [inactive]'}`);
    lines.push('');
  }
  if (plan.stored.length) {
    lines.push('  LEFT ALONE (already stored)');
    for (const s of plan.stored) lines.push(`    ${s.name} -- ${label3(s.rule)}`);
    lines.push('');
  }
  if (plan.unreadable.length) {
    lines.push('  NOT A RULE (left alone; look at these)');
    for (const u of plan.unreadable) {
      lines.push(`    ${u.name} -- stored "${u.value}", read today as ${label3(u.reads_as)}`);
    }
    lines.push('');
  }
  return lines;
}

function main() {
  const opts = parseArgs(process.argv.slice(2));
  const targetLabel = opts.remote ? 'PRODUCTION' : 'local';

  if (!hasColumn('document_types', 'sharing_rule', opts)) {
    console.error(
      'This database predates migration 0137 -- there is no sharing_rule column.\n' +
      'Apply migrations/0137_sharing_rule.sql on the target first.',
    );
    process.exit(1);
  }

  const tenants = opts.all
    ? query('SELECT id, name FROM tenants ORDER BY name', opts)
    : query(`SELECT id, name FROM tenants WHERE id = ${sqlStr(opts.tenant)}`, opts);

  if (tenants.length === 0) {
    console.error(
      opts.all
        ? 'No tenants in this database. Check the --remote flag.'
        : `No tenant "${opts.tenant}" in this database. Check the id, or the --remote flag.`,
    );
    process.exit(1);
  }

  const plans = tenants.map((t) => ({ tenant: t, plan: planTenant(t.id, opts) }));

  if (opts.json) {
    console.log(JSON.stringify({
      target: targetLabel,
      applied: opts.apply,
      tenants: plans.map(({ tenant, plan }) => ({
        id: tenant.id,
        name: tenant.name,
        total: plan.total,
        stored: plan.stored,
        fills: plan.fills,
        unreadable: plan.unreadable,
        untyped_documents: plan.untyped_documents,
      })),
    }, null, 2));
  } else {
    for (const { tenant, plan } of plans) {
      for (const line of formatPlan(plan, `${tenant.name} (${tenant.id}), ${targetLabel}`)) console.log(line);
    }
    console.log(
      '  Filling writes the rule each type ALREADY reads as, from its name. It does\n' +
      '  not change what may leave the portal; it makes the setting visible and\n' +
      '  editable on the Document Types screen. A type that should read differently\n' +
      '  is changed there, by an admin, after this.',
    );
    console.log('');
  }

  const statements = plans.flatMap(({ tenant, plan }) => plan.fills.map((f) => fillToSql(tenant.id, f, sqlStr)));

  if (!opts.apply) {
    if (!opts.json) {
      console.log(
        statements.length === 0
          ? 'DRY RUN -- nothing to fill.'
          : `DRY RUN -- ${statements.length} document type(s) not written. Re-run with --tenant <id> --apply to write.`,
      );
      console.log('');
    }
    return;
  }

  if (statements.length === 0) {
    console.log('Nothing to do -- every document type already has a stored sharing rule.');
    return;
  }

  if (opts.remote && !opts.yes) {
    const answer = promptSync(
      `\nAbout to WRITE to PRODUCTION D1 for tenant ${opts.tenant}:\n` +
      `  ${statements.length} document type sharing rule(s)\n` +
      'Type the tenant id to continue: ',
    );
    if (answer.trim() !== opts.tenant) {
      console.error('That did not match. Nothing was written.');
      process.exit(1);
    }
  }

  execSql(statements, opts, 'sharing-rule-backfill');
  console.log('');
  console.log(`Wrote ${statements.length} document type sharing rule(s) in ${targetLabel} D1.`);
  console.log('Re-run without --apply to confirm it now reports nothing to fill.');
  console.log('');
}

try {
  main();
} catch (err) {
  console.error(err instanceof Error ? err.stack : String(err));
  process.exit(1);
}

#!/usr/bin/env bash
# Create a tenant + seed a starter registry vocabulary (and optionally an
# org_admin user) in the dox D1 database. Idempotent. LOCAL by default; pass
# --remote to target production (doc-upload-db --remote).
#
# The starter vocabulary comes from a NAMED PACK in starter-packs/<name>.json —
# data, not code. A pack seeds all three registry facets for the tenant:
#   document_types           what a document IS         (layer 1)
#   requirements             what it SATISFIES          (layer 2)
#   claim_types              what it TRIGGERS           (layer 3)
#   claim_type_requirements  which requirement a claim OPENS
# Packs ship for `fsqa` (food safety) and `finance`. Adding a vertical is a new
# JSON file — no change to this script. Run `--list-packs` to see them.
#
# Usage:
#   ./bin/create-tenant --name "Medosweet Farms" --slug medosweet [--id <id>]
#   ./bin/create-tenant --name "Acme Books" --slug acme --pack finance
#   ./bin/create-tenant --name "Bare Tenant" --slug bare --no-pack
#   ./bin/create-tenant --list-packs
#   ./bin/create-tenant --remote --name "Medosweet Farms" --slug medosweet
#   ./bin/create-tenant --remote --name "Medosweet Farms" --slug medosweet \
#       --admin-email ajconner@example.com --admin-name "AJ Conner"   # + org_admin
#
# --pack <name>   starter pack to seed (default: fsqa)
# --no-pack       create the tenant only, no vocabulary
# --list-packs    print the available packs and exit
#
# --admin-* creates an org_admin scoped to the tenant with a generated temp
# password (printed ONCE) and force_password_change=1. Omit to create tenant
# + vocabulary only (e.g. when an existing super_admin will scope into it).
#
# Re-running is safe: tenant rows upsert, and every pack statement is
# INSERT OR IGNORE against a deterministic id derived from the tenant slug, so
# nothing duplicates and admin edits to a seeded row are preserved.
set -euo pipefail
cd "$(dirname "$0")/.."

DB="doc-upload-db"
REMOTE=""            # "" = local, "--remote" = prod
NAME=""; SLUG=""; TID=""
PACK="fsqa"
ADMIN_EMAIL=""; ADMIN_NAME=""; ADMIN_ROLE="org_admin"

while [ $# -gt 0 ]; do
  case "$1" in
    --remote) REMOTE="--remote" ;;
    --name) NAME="$2"; shift ;;
    --slug) SLUG="$2"; shift ;;
    --id) TID="$2"; shift ;;
    --pack) PACK="$2"; shift ;;
    --no-pack) PACK="" ;;
    --list-packs) node bin/render-starter-pack --list; exit 0 ;;
    --admin-email) ADMIN_EMAIL="$2"; shift ;;
    --admin-name) ADMIN_NAME="$2"; shift ;;
    --admin-role) ADMIN_ROLE="$2"; shift ;;
    -h|--help) sed -n '2,42p' "$0"; exit 0 ;;
    *) echo "Unknown arg: $1" >&2; exit 2 ;;
  esac
  shift
done

[ -z "$NAME" ] && { echo "--name required" >&2; exit 2; }
[ -z "$SLUG" ] && { echo "--slug required" >&2; exit 2; }
# Deterministic id from slug when not given (stable across re-runs).
[ -z "$TID" ] && TID="tenant_$(printf '%s' "$SLUG" | tr -c 'a-z0-9' '_' )"

# Validate the pack BEFORE touching the database, so a typo in the pack name or
# a bad edit to the JSON fails before a half-provisioned tenant exists.
PACK_SUMMARY=""
if [ -n "$PACK" ]; then
  PACK_SUMMARY=$(node bin/render-starter-pack --pack "$PACK" --tenant-id "$TID" --tenant-slug "$SLUG" --summary)
fi

TARGET="LOCAL"; [ -n "$REMOTE" ] && TARGET="PROD (--remote)"
echo "Target: $TARGET   Tenant: $NAME ($SLUG) id=$TID"
if [ -n "$PACK" ]; then
  echo "Pack:   $PACK — $PACK_SUMMARY"
else
  echo "Pack:   (none — --no-pack)"
fi
if [ -n "$REMOTE" ]; then
  read -r -p "This writes to PRODUCTION. Proceed? [y/N] " ans
  [ "$ans" = "y" ] || [ "$ans" = "Y" ] || { echo "Aborted."; exit 1; }
fi

d1() { npx wrangler d1 execute "$DB" $REMOTE --command "$1"; }
d1_file() { npx wrangler d1 execute "$DB" $REMOTE --file="$1"; }

sql_escape() { printf '%s' "$1" | sed "s/'/''/g"; }

# ---- Tenant ----
d1 "INSERT INTO tenants (id, name, slug, description)
    VALUES ('$TID', '$(sql_escape "$NAME")', '$(sql_escape "$SLUG")', 'Document registry')
    ON CONFLICT(id) DO UPDATE SET name=excluded.name, slug=excluded.slug;" >/dev/null
echo "  tenant upserted"

# ---- Starter pack (document types + requirements + claims + claim rules) ----
if [ -n "$PACK" ]; then
  PACK_SQL=$(mktemp); trap 'rm -f "$PACK_SQL"' EXIT
  node bin/render-starter-pack --pack "$PACK" --tenant-id "$TID" --tenant-slug "$SLUG" > "$PACK_SQL"
  d1_file "$PACK_SQL" >/dev/null
  echo "  '$PACK' pack seeded: $PACK_SUMMARY (INSERT OR IGNORE)"
fi

# ---- Optional org_admin user ----
if [ -n "$ADMIN_EMAIL" ]; then
  [ -z "$ADMIN_NAME" ] && ADMIN_NAME="$ADMIN_EMAIL"
  TMP_PW=$(node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))")
  HASH=$(PW="$TMP_PW" node -e "
    const c=require('crypto');const s=c.randomBytes(16);
    const d=c.pbkdf2Sync(process.env.PW,s,100000,32,'sha256');
    console.log(s.toString('hex')+':'+d.toString('hex'));")
  UID="user_$(printf '%s' "$ADMIN_EMAIL" | tr -c 'a-z0-9' '_')"
  d1 "INSERT INTO users (id, email, password_hash, name, role, tenant_id, force_password_change)
      VALUES ('$UID','$(sql_escape "$ADMIN_EMAIL")','$HASH','$(sql_escape "$ADMIN_NAME")','$ADMIN_ROLE','$TID',1)
      ON CONFLICT(email) DO UPDATE SET role=excluded.role, tenant_id=excluded.tenant_id;" >/dev/null
  echo ""
  echo "  admin: $ADMIN_EMAIL ($ADMIN_ROLE)  TEMP PASSWORD: $TMP_PW"
  echo "  (force_password_change=1 — share out of band; they set their own on first login)"
fi

echo ""
echo "Done. Tenant '$NAME' ready on $TARGET."

#!/usr/bin/env node
/* eslint-disable no-console */
/**
 * bin/eval-search — search regression harness.
 *
 * Samples approved documents from ONE tenant (GET /api/search/eval-sample),
 * asks the questions a person would ask about each one — the lot in every
 * spelling (1042620303 / 10426203-03 / "10426203 03"), the supplier PO, the
 * invoice, the document / certificate number, product + production day,
 * product + month, supplier + type — and checks the document lands in the
 * COVERING band (or LIKELY, when its only date is a legacy code date or a
 * lot-code decode; recorded per basis). Plus NEGATIVE probes the server has
 * verified: a day next to a real one with no lot, a lot nobody holds, a real
 * lot under the wrong supplier — each must answer coverage 'none' with nothing
 * presented as covering or likely. Prints a scorecard per question kind, the
 * negatives, and every failing question with what came back.
 *
 * Question generation and scoring are shared/searchProbes.ts (the generated
 * mirror bin/lib/shared/searchProbes.js — `npm run build:worker-shared`), the
 * same code GET /api/search/examples and the golden test use.
 *
 * Usage:
 *   bin/eval-search                       # no --url: the golden corpus, in-worker (vitest)
 *   bin/eval-search --url http://localhost:8788 --tenant <id> [--n 25] [--seed eval] [--min 95] [--json out.json]
 *
 * Credentials (with --url): DOX_EVAL_TOKEN (a JWT, or a dox_sk_ API key), or
 * DOX_EVAL_EMAIL + DOX_EVAL_PASSWORD. The user must be org_admin (own tenant)
 * or super_admin (--tenant required). Read-only: it only searches.
 *
 * Exit: 0; 1 when the overall rate is below --min (percent, or a 0-1
 * fraction); 2 on a usage / connection error.
 */

'use strict';

const path = require('node:path');
const fs = require('node:fs');
const { spawnSync } = require('node:child_process');

const ROOT = path.resolve(__dirname, '..');

function parseArgs(argv) {
  const out = { n: 25, seed: 'eval', url: null, tenant: null, min: null, json: null, concurrency: 4, help: false };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    const val = () => {
      const v = argv[++i];
      if (v === undefined) fail(`${a} needs a value`);
      return v;
    };
    if (a === '--url') out.url = val().replace(/\/+$/, '');
    else if (a === '--tenant') out.tenant = val();
    else if (a === '--n') out.n = Number(val());
    else if (a === '--seed') out.seed = val();
    else if (a === '--min') out.min = Number(val());
    else if (a === '--json') out.json = val();
    else if (a === '--concurrency') out.concurrency = Math.max(1, Number(val()) || 1);
    else if (a === '-h' || a === '--help') out.help = true;
    else fail(`unknown argument ${a}`);
  }
  if (!Number.isFinite(out.n) || out.n < 1 || out.n > 200) fail('--n must be between 1 and 200');
  if (out.min !== null && !Number.isFinite(out.min)) fail('--min must be a number');
  return out;
}

function fail(msg) {
  console.error(`eval-search: ${msg}`);
  process.exit(2);
}

function usage() {
  const src = fs.readFileSync(__filename, 'utf8');
  const m = src.match(/\/\*\*([\s\S]*?)\*\//);
  console.log(m ? m[1].replace(/^ \* ?/gm, '') : 'bin/eval-search');
}

function loadProbes() {
  const p = path.join(ROOT, 'bin/lib/shared/searchProbes.js');
  if (!fs.existsSync(p)) fail('bin/lib/shared/searchProbes.js is missing — run `npm run build:worker-shared`');
  return require(p);
}

async function authHeaders(url) {
  const token = process.env.DOX_EVAL_TOKEN;
  if (token) return token.startsWith('dox_sk_') ? { 'X-API-Key': token } : { Authorization: `Bearer ${token}` };
  const email = process.env.DOX_EVAL_EMAIL;
  const password = process.env.DOX_EVAL_PASSWORD;
  if (!email || !password) fail('set DOX_EVAL_TOKEN, or DOX_EVAL_EMAIL and DOX_EVAL_PASSWORD');
  const res = await fetch(`${url}/api/auth/login`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email, password }),
  }).catch((e) => fail(`cannot reach ${url}: ${e.message}`));
  const body = await res.json().catch(() => ({}));
  if (!res.ok || !body.token) fail(`login failed (${res.status}): ${body.error || 'no token'}`);
  return { Authorization: `Bearer ${body.token}` };
}

async function api(url, headers, method, pathname, body) {
  const res = await fetch(`${url}${pathname}`, {
    method,
    headers: { ...headers, ...(body ? { 'Content-Type': 'application/json' } : {}) },
    ...(body ? { body: JSON.stringify(body) } : {}),
  });
  const json = await res.json().catch(() => ({}));
  if (!res.ok) throw new Error(`${method} ${pathname} -> ${res.status}: ${json.error || res.statusText}`);
  return json;
}

async function mapLimit(items, limit, fn) {
  const out = new Array(items.length);
  let next = 0;
  const workers = Array.from({ length: Math.min(limit, items.length) }, async () => {
    while (next < items.length) {
      const i = next++;
      out[i] = await fn(items[i], i);
    }
  });
  await Promise.all(workers);
  return out;
}

async function runAgainstServer(opts) {
  const P = loadProbes();
  const headers = await authHeaders(opts.url);
  const tenantQs = opts.tenant ? `&tenant_id=${encodeURIComponent(opts.tenant)}` : '';
  const sample = await api(opts.url, headers, 'GET', `/api/search/eval-sample?n=${opts.n}&seed=${encodeURIComponent(opts.seed)}${tenantQs}`)
    .catch((e) => fail(e.message));
  const tenantBody = opts.tenant ? { tenant_id: opts.tenant } : {};
  const probeRead = await api(opts.url, headers, 'POST', '/api/search/interpret', { text: 'produced in april', ...tenantBody }).catch(() => ({ clauses: [] }));
  const months = (probeRead.clauses || []).some((c) => c.field === 'date' || c.field === 'production_date');

  const probes = P.sampleProbes(sample);
  console.error(`eval-search: ${sample.docs.length} documents from tenant ${sample.tenant_id} (seed "${sample.seed}"), ${probes.length} questions; month phrases ${months ? 'supported' : 'not supported by the reader yet'}`);
  const results = await mapLimit(probes, opts.concurrency, async (p) => {
    const unsupported = p.needs === 'month_phrases' && !months;
    if (unsupported) return P.scoreProbe(p, { documents: [] }, false);
    try {
      const r = await api(opts.url, headers, 'POST', '/api/search/query', {
        query: { v: 1, text: p.text, clauses: p.clauses || [], view: { entity: 'documents' } },
        interpret: true, facets: false, limit: 200, ...tenantBody,
      });
      return P.scoreProbe(p, r, true);
    } catch (e) {
      return P.scoreProbe(p, { coverage: `error: ${e.message}`, documents: [] }, true);
    }
  });
  const card = P.scorecard(results);
  console.log(P.formatScorecard(card));
  if (opts.json) {
    fs.writeFileSync(opts.json, JSON.stringify({ tenant_id: sample.tenant_id, seed: sample.seed, n: sample.n, months_supported: months, scorecard: card }, null, 2));
    console.error(`eval-search: wrote ${opts.json}`);
  }
  const overall = P.overallRate(card);
  if (opts.min !== null && overall !== null) {
    const min = opts.min > 1 ? opts.min / 100 : opts.min;
    if (overall < min) {
      console.error(`eval-search: overall ${(overall * 100).toFixed(1)}% is below --min ${(min * 100).toFixed(1)}%`);
      process.exit(1);
    }
  }
}

function runGolden() {
  console.error('eval-search: no --url — running the probes over the golden corpus (tests/fixtures/search-golden) in-worker');
  const r = spawnSync('npx', ['vitest', 'run', 'tests/api/search-eval-golden.test.ts', 'tests/api/search-golden.test.ts'], { cwd: ROOT, stdio: 'inherit' });
  process.exit(r.status === null ? 2 : r.status);
}

(async () => {
  const opts = parseArgs(process.argv.slice(2));
  if (opts.help) return usage();
  if (!opts.url) return runGolden();
  await runAgainstServer(opts);
})().catch((e) => fail(e.stack || e.message));

#!/usr/bin/env node
/* eslint-disable no-console */
/**
 * bin/retire-duplicate-requirements — fold a requirement that duplicates a
 * starter-pack requirement into it, then deactivate the duplicate.
 *
 * WHY: a requirement is what has to be proven, not the document that proves it
 * (AJ, rules table F4, 2026-09-20). `bin/seed-arrivals-demo` created three
 * requirements under DOCUMENT-TYPE slugs on a tenant that already held the
 * starter pack's requirement for the same concept:
 *
 *     specification-sheet          -> spec-sheet
 *     allergen-statement           -> allergen-matrix
 *     country-of-origin-statement  -> country-of-origin
 *
 * so the Requirements screen listed each concept twice, and a document closing
 * one left the other open as a false gap. The seed now reuses the pack slugs.
 *
 * WHAT IT DOES (bin/lib/duplicateRequirementPlan.js has the whole rule)
 *   - re-points every link on the duplicate -- document links, supplier
 *     checklist rows, claim rules, document-type defaults, current request
 *     lines, template lines, notes -- to the canonical row, as it is (a
 *     person's confirmation or rejection is carried, never re-decided);
 *   - never modifies a canonical row: where the same document/supplier/... is
 *     already linked to it, the duplicate's link is a CONFLICT, left in place
 *     and reported, and the duplicate is HELD (not deactivated);
 *   - leaves request lines on superseded request versions alone (frozen);
 *   - deactivates the duplicate (never deletes it) and writes one audit row.
 *
 * Usage:
 *   bin/retire-duplicate-requirements --tenant <id>                      # dry run, LOCAL
 *   bin/retire-duplicate-requirements --tenant <id> --remote             # dry run, PRODUCTION
 *   bin/retire-duplicate-requirements --tenant <id> --remote --apply     # prompts first
 *   bin/retire-duplicate-requirements --tenant <id> --pair old-slug=canonical-slug
 *
 * Flags:
 *   --tenant ID        tenant (required)
 *   --pair DUP=CANON   a duplicate slug and the slug it folds into (repeatable;
 *                      replaces the three default pairs above)
 *   --apply            actually write. Without it this is a dry run.
 *   --remote, -r       target PRODUCTION D1 (with --apply, asks you to type the tenant id)
 *   --yes, -y          skip the production confirmation prompt
 *   --json             emit the plan as JSON
 *   -h, --help         this help
 */

'use strict';

const fs = require('fs');
const os = require('os');
const path = require('path');
const { execFileSync } = require('child_process');

const { query, PROJECT_ROOT, DEFAULT_DB } = require('./lib/d1');
const {
  DEFAULT_DUPLICATE_SLUGS,
  LINK_TABLES,
  planDuplicateRequirements,
  duplicateRequirementsToSql,
} = require('./lib/duplicateRequirementPlan');

const ID_RE = /^[A-Za-z0-9_-]+$/;
const SLUG_RE = /^[a-z0-9][a-z0-9-]*$/;

function parseArgs(argv) {
  const opts = { tenant: null, pairs: [], apply: false, remote: false, yes: false, json: false };
  const fail = (m) => { console.error(m); process.exit(2); };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    switch (a) {
      case '--tenant': opts.tenant = argv[++i]; break;
      case '--pair': {
        const [dupSlug, canonSlug] = String(argv[++i] || '').split('=');
        if (!SLUG_RE.test(dupSlug || '') || !SLUG_RE.test(canonSlug || '') || dupSlug === canonSlug) {
          fail('--pair takes DUP=CANON, two different slugs.');
        }
        opts.pairs.push({ dupSlug, canonSlug });
        break;
      }
      case '--apply': opts.apply = true; break;
      case '--remote':
      case '-r': opts.remote = true; break;
      case '--yes':
      case '-y': opts.yes = true; break;
      case '--json': opts.json = true; break;
      case '-h':
      case '--help': printHelp(); process.exit(0); break;
      default: fail(`Unknown argument: ${a}`);
    }
  }
  if (!opts.tenant || !ID_RE.test(opts.tenant)) fail('--tenant <id> is required (letters, digits, dashes, underscores).');
  if (opts.pairs.length === 0) {
    opts.pairs = Object.entries(DEFAULT_DUPLICATE_SLUGS).map(([dupSlug, canonSlug]) => ({ dupSlug, canonSlug }));
  }
  return opts;
}

function printHelp() {
  const lines = fs.readFileSync(__filename, 'utf8').split('\n');
  const end = lines.findIndex((l, i) => i > 2 && l.trim() === '*/');
  console.log(lines.slice(3, end).join('\n').replace(/^ \* ?/gm, ''));
}

function sqlStr(v) {
  if (v === null || v === undefined) return 'NULL';
  return `'${String(v).replace(/'/g, "''")}'`;
}

function execSql(statements, remote) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'dox-retire-dup-req-'));
  const file = path.join(dir, 'retire.sql');
  fs.writeFileSync(file, `${statements.join('\n')}\n`, 'utf8');
  try {
    execFileSync(
      'npx',
      ['wrangler', 'd1', 'execute', DEFAULT_DB, remote ? '--remote' : '--local', `--file=${file}`],
      { cwd: PROJECT_ROOT, stdio: ['ignore', 'pipe', 'pipe'], maxBuffer: 64 * 1024 * 1024 },
    );
  } catch (err) {
    const stderr = err.stderr ? err.stderr.toString() : '';
    throw new Error(`Writing to D1 failed. The SQL is at ${file}\n${stderr || err.message}`);
  }
  fs.rmSync(dir, { recursive: true, force: true });
}

function promptSync(question) {
  process.stdout.write(question);
  let fd;
  try {
    fd = fs.openSync('/dev/tty', 'rs');
  } catch {
    console.error('\nNo terminal to confirm on. Re-run interactively, or pass --yes.');
    process.exit(1);
  }
  const buf = Buffer.alloc(256);
  let out = '';
  for (;;) {
    const n = fs.readSync(fd, buf, 0, buf.length, null);
    if (n === 0) break;
    out += buf.toString('utf8', 0, n);
    if (out.includes('\n')) break;
  }
  fs.closeSync(fd);
  return out.split('\n')[0];
}

/** One SELECT per link table over the tenant's rows for the named requirements. */
function loadLinks(ids, remote) {
  const inList = ids.map(sqlStr).join(',');
  const links = {};
  for (const t of LINK_TABLES) {
    const detail = t.detail ? `t.${t.detail}` : 'NULL';
    const frozen = t.table === 'request_lines'
      ? '(SELECT CASE WHEN r.superseded_at IS NULL THEN 0 ELSE 1 END FROM document_requests r WHERE r.id = t.request_id)'
      : '0';
    links[t.table] = query(
      `SELECT t.id, t.${t.key} AS k, t.requirement_id, ${detail} AS detail, ${frozen} AS frozen
         FROM ${t.table} t WHERE t.requirement_id IN (${inList})`,
      { remote },
    ).map((r) => ({ ...r, frozen: Number(r.frozen || 0) }));
  }
  return links;
}

function describeRow(t, r) {
  return `${t.key} ${r.k}${r.detail ? ` (${r.detail})` : ''}`;
}

function main() {
  const opts = parseArgs(process.argv.slice(2));
  const target = opts.remote ? 'PRODUCTION' : 'local';
  const tenant = query(`SELECT id, name FROM tenants WHERE id = ${sqlStr(opts.tenant)}`, { remote: opts.remote })[0];
  if (!tenant) throw new Error(`No tenant "${opts.tenant}" in ${target} D1.`);

  const slugs = [...new Set(opts.pairs.flatMap((p) => [p.dupSlug, p.canonSlug]))];
  const requirements = query(
    `SELECT id, slug, name, checklist, active FROM requirements
      WHERE tenant_id = ${sqlStr(opts.tenant)} AND slug IN (${slugs.map(sqlStr).join(',')})`,
    { remote: opts.remote },
  );
  const ids = requirements.map((r) => r.id);
  const links = ids.length ? loadLinks(ids, opts.remote) : {};
  const notes = ids.length
    ? query(
      `SELECT id, entity_id FROM entity_notes WHERE tenant_id = ${sqlStr(opts.tenant)}
          AND entity_type = 'requirement' AND entity_id IN (${ids.map(sqlStr).join(',')})`,
      { remote: opts.remote },
    )
    : [];
  const plan = planDuplicateRequirements({ pairs: opts.pairs, requirements, links, notes });

  if (opts.json) {
    console.log(JSON.stringify({ target, applied: opts.apply, tenant, plan }, null, 2));
  } else {
    console.log('');
    console.log(`Retire duplicate requirements — ${tenant.name} (${tenant.id}), ${target}`);
    console.log('');
    for (const p of plan) {
      console.log(`  ${p.dupSlug}  ->  ${p.canonSlug}`);
      if (!p.tables) {
        console.log(`    SKIP: ${p.reason}`);
        console.log('');
        continue;
      }
      console.log(`    duplicate  "${p.dup.name}" (${p.dup.id})${p.dup.active ? '' : ' [already inactive]'}`);
      console.log(`    canonical  "${p.canon.name}" (${p.canon.id})${p.canon.active ? '' : ' [INACTIVE]'}`);
      for (const t of p.tables) {
        if (!t.move.length && !t.conflicts.length && !t.frozen.length) continue;
        const parts = [];
        if (t.move.length) parts.push(`re-point ${t.move.length}`);
        if (t.conflicts.length) parts.push(`CONFLICT ${t.conflicts.length}`);
        if (t.frozen.length) parts.push(`frozen ${t.frozen.length} (superseded version, left)`);
        console.log(`    ${t.label}: ${parts.join(', ')}`);
        for (const r of t.move) console.log(`      move      ${describeRow(t, r)}  [row ${r.id}]`);
        for (const c of t.conflicts) {
          console.log(`      conflict  ${describeRow(t, c.dup)} on the duplicate vs ${c.canon.detail ?? 'a link'} on the canonical — left for a person`);
        }
      }
      if (p.notes.length) console.log(`    notes: re-point ${p.notes.length}`);
      if (p.moveCount === 0 && p.notes.length === 0) console.log('    no links on the duplicate');
      const verdict = {
        retire: 'DEACTIVATE the duplicate',
        held: `HELD — ${p.conflictCount} conflict(s); the duplicate stays active`,
        already_inactive: 'already inactive',
      }[p.status];
      console.log(`    => ${verdict}`);
      console.log('');
    }
  }

  const statements = duplicateRequirementsToSql(opts.tenant, plan, sqlStr);
  if (!opts.apply) {
    if (!opts.json) {
      console.log(statements.length === 0
        ? 'DRY RUN — nothing to do.'
        : `DRY RUN — ${statements.length} statement(s) not written. Re-run with --apply to write.`);
      console.log('');
    }
    return;
  }
  if (statements.length === 0) {
    console.log('Nothing to do.');
    return;
  }
  if (opts.remote && !opts.yes) {
    const answer = promptSync(
      `\nAbout to WRITE to PRODUCTION D1 for tenant ${opts.tenant}: ${statements.length} statement(s).\n` +
      'Type the tenant id to continue: ',
    );
    if (answer.trim() !== opts.tenant) {
      console.error('That did not match. Nothing was written.');
      process.exit(1);
    }
  }
  execSql(statements, opts.remote);
  console.log(`Wrote ${statements.length} statement(s) in ${target} D1. Re-run without --apply to confirm.`);
}

try {
  main();
} catch (err) {
  console.error(err instanceof Error ? err.message : String(err));
  process.exit(1);
}

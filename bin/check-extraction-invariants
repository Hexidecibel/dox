#!/usr/bin/env node
/* eslint-disable no-console */
/**
 * bin/check-extraction-invariants — READ-ONLY corpus-scale sanity check on
 * extracted field values. No model, no answer key, no hand grading.
 *
 * The idea: a lot of extraction failure is detectable from the document
 * ALONE. If the model reports a lot number that appears nowhere in the
 * document's own text, that value was fabricated or borrowed from a
 * neighbouring page. If it reports an expiration date before the production
 * date, or a "product code" that is the supplier's phone number, that is
 * wrong without anyone needing to open the PDF. These checks cost nothing and
 * run over the WHOLE corpus, not a graded sample.
 *
 * What it does NOT tell you: whether a value that passes every invariant is
 * actually the RIGHT value. A lot number that occurs in the document but
 * belongs to a different line item passes `lot_in_text`. Treat the failure
 * counts as a FLOOR on the error rate, never as an accuracy figure.
 *
 * Source of truth: `processing_queue`. That is the only table carrying
 * `extracted_text` alongside the extraction, so it is the only place the
 * text-grounding checks can run. Both extraction shapes are walked:
 *   - flat `ai_fields`  {"lot_number": "...", ...}
 *   - records mode `ai_records` {page_metadata:{...}, records:[{fields:{...}}]}
 *
 * READ-ONLY GUARANTEE: every statement goes through bin/lib/d1.js#query,
 * which refuses anything that is not SELECT/WITH. No writes, ever.
 *
 * Usage:
 *   bin/check-extraction-invariants                 # LOCAL D1
 *   bin/check-extraction-invariants --remote        # PRODUCTION D1 (read-only)
 *   bin/check-extraction-invariants --remote --json > out.json
 *   bin/check-extraction-invariants --remote --worst 40
 *   bin/check-extraction-invariants --remote --kind coa
 *
 * Flags:
 *   --remote, -r      query production D1 instead of local
 *   --json            emit the full result structure as JSON (no text report)
 *   --worst N         how many worst-offender items to list (default 20)
 *   --kind K          restrict to one output_kind (e.g. coa, order)
 *   --limit N         cap the number of queue items examined (prints what
 *                     was dropped; default: no cap)
 *   --page-size N     D1 paging size (default 60)
 *   -h, --help        this help
 *
 * Exit code is always 0 on a successful run — findings are data, not failures.
 */

const { query, queryPaged } = require('./lib/d1');

// ---------------------------------------------------------------------------
// Lot / sublot normalization.
//
// KEEP IN SYNC with functions/lib/entities/lots.ts (the canonical TS copy).
// Same mirroring convention as bin/lib/models.js: bin/ scripts are plain Node
// with no TS compile step, so the rules are duplicated verbatim rather than
// re-invented. If normalizeLotNumber/normalizeSubLotCode change there, change
// them here.
// ---------------------------------------------------------------------------

/** Uppercase+trim, strip a leading LOT/# token, drop every non-alphanumeric. */
function normalizeLotNumber(raw) {
  if (!raw) return '';
  let s = String(raw).toUpperCase().trim();
  if (!s) return '';
  s = s.replace(/^(?:LOT\b|#)\s*[#:]?\s*/i, '').trim();
  s = s.replace(/[^A-Z0-9]/g, '');
  return s;
}

/** Strip separators, uppercase; left-pad a stray 1-digit value to 2. */
function normalizeSubLotCode(raw) {
  if (!raw) return '';
  const s = String(raw).toUpperCase().trim().replace(/[^A-Z0-9]/g, '');
  if (!s) return '';
  return /^[0-9]$/.test(s) ? `0${s}` : s;
}

// ---------------------------------------------------------------------------
// Field keys we know how to check.
// ---------------------------------------------------------------------------

const LOT_KEYS = ['lot_number', 'lot_code', 'buffer_lot'];
const SUBLOT_KEYS = ['sub_lot_code', 'sub_lot_number', 'sublot_code'];
const DATE_KEYS = [
  'code_date',
  'expiration_date',
  'production_date',
  'mfg_date',
  'best_by_date',
  'ship_date',
  'delivery_date',
  'invoice_date',
  'issue_date',
  'date_of_issue',
  'packaging_date',
  'test_date',
  'buffer_exp',
];
/** Dates that must not precede the production date. */
const PRODUCTION_KEYS = ['production_date', 'mfg_date', 'packaging_date'];

// Records-mode envelope keys that are structure, not extracted values.
const ENVELOPE_KEYS = new Set([
  'records',
  'record_cardinality',
  'record_key_basis',
  'page_metadata',
]);

const PLAUSIBLE_MIN_YEAR = 2015;
const PLAUSIBLE_MAX_YEAR = 2035;
/** Longer than this between production and expiry is not a dairy shelf life. */
const MAX_SHELF_LIFE_DAYS = 730;

// ---------------------------------------------------------------------------
// Parsing helpers
// ---------------------------------------------------------------------------

function safeParse(raw) {
  if (raw == null || raw === '') return null;
  try {
    return JSON.parse(raw);
  } catch {
    return undefined; // undefined == present but unparseable
  }
}

/** Flatten one queue item's extractions into [{scope, fields}]. */
function bundlesFor(item) {
  const out = [];

  const flat = safeParse(item.ai_fields);
  if (flat === undefined) {
    out.push({ scope: 'ai_fields', fields: null, unparseable: true });
  } else if (flat && typeof flat === 'object' && !Array.isArray(flat)) {
    const fields = {};
    for (const [k, v] of Object.entries(flat)) {
      // Records-mode items stringify their envelope into ai_fields as
      // "[object Object]" — that is not an extracted value, skip it.
      if (ENVELOPE_KEYS.has(k)) continue;
      fields[k] = v;
    }
    if (Object.keys(fields).length > 0) out.push({ scope: 'ai_fields', fields });
  }

  const rec = safeParse(item.ai_records);
  if (rec === undefined) {
    out.push({ scope: 'ai_records', fields: null, unparseable: true });
  } else if (rec && typeof rec === 'object') {
    const pm = rec.page_metadata;
    if (pm && typeof pm === 'object' && !Array.isArray(pm)) {
      out.push({ scope: 'page_metadata', fields: pm });
    }
    const records = Array.isArray(rec.records) ? rec.records : [];
    records.forEach((r, i) => {
      const f = r && typeof r === 'object' ? r.fields : null;
      if (f && typeof f === 'object' && !Array.isArray(f)) {
        out.push({ scope: `record[${i}]`, fields: f });
      }
    });
  }

  return out;
}

function asString(v) {
  if (v == null) return '';
  if (typeof v === 'string') return v.trim();
  if (typeof v === 'number' || typeof v === 'boolean') return String(v);
  return ''; // objects/arrays are not scalar field values
}

/** Loose date parse: ISO, US slash, and "Mon DD, YYYY". Returns Date or null. */
function parseDate(raw) {
  const s = asString(raw);
  if (!s) return null;
  let m = /^(\d{4})-(\d{2})-(\d{2})/.exec(s);
  if (m) return mkDate(+m[1], +m[2], +m[3]);
  m = /^(\d{1,2})[/\-.](\d{1,2})[/\-.](\d{2,4})$/.exec(s);
  if (m) {
    let y = +m[3];
    if (y < 100) y += y < 70 ? 2000 : 1900;
    return mkDate(y, +m[1], +m[2]);
  }
  const t = Date.parse(s);
  if (!Number.isNaN(t)) {
    const d = new Date(t);
    if (!Number.isNaN(d.getTime())) return d;
  }
  return null;
}

function mkDate(y, mo, d) {
  if (mo < 1 || mo > 12 || d < 1 || d > 31) return null;
  const dt = new Date(Date.UTC(y, mo - 1, d));
  if (dt.getUTCFullYear() !== y || dt.getUTCMonth() !== mo - 1 || dt.getUTCDate() !== d) {
    return null;
  }
  return dt;
}

const DAY = 86400000;

/** NANP-shaped phone: 10 digits (or 11 leading 1) with phone punctuation. */
function looksLikePhone(raw) {
  const s = asString(raw);
  if (!s) return false;
  const digits = s.replace(/\D/g, '');
  if (digits.length !== 10 && !(digits.length === 11 && digits[0] === '1')) return false;
  // Require phone-ish punctuation or spacing so a bare 10-digit SKU is not
  // accused. "360-687-7171", "(360) 687-7171", "360.687.7171" qualify.
  return /^\+?1?[\s.(-]*\d{3}[\s.)-]+\d{3}[\s.-]+\d{4}$/.test(s);
}

/** A calendar date sitting in a lot field, e.g. "7/15/26". */
function looksLikeCalendarDate(raw) {
  const s = asString(raw);
  if (!s) return false;
  return /^\d{1,2}[/\-.]\d{1,2}[/\-.]\d{2,4}$/.test(s) || /^\d{4}-\d{2}-\d{2}$/.test(s);
}

/** Uppercase + drop non-alphanumerics, so punctuation drift cannot cause a miss. */
function alnum(s) {
  return String(s || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
}

/**
 * Sentinel strings the model emits instead of a value. These are NOT
 * fabrications and must not be scored as such — they are a distinct (and
 * milder) defect: the field should have been omitted.
 */
const PLACEHOLDERS = new Set([
  'MULTIPLE',
  'VARIOUS',
  'SEE ATTACHED',
  'SEE BELOW',
  'N/A',
  'NA',
  'NONE',
  'NULL',
  'UNKNOWN',
  'MISSING',
  '(MISSING)',
  'NOT AVAILABLE',
  'NOT PROVIDED',
  'NOT SPECIFIED',
  'TBD',
  '-',
  '--',
  'X',
  '?',
]);

function isPlaceholder(raw) {
  const s = asString(raw).toUpperCase().trim();
  if (!s) return false;
  return PLACEHOLDERS.has(s);
}

/**
 * Split a comma/semicolon-joined value into parts. Only ever called AFTER the
 * whole string has already failed its single-value test, so legitimately
 * comma-bearing values ("Sep 5, 2026", "Darigold, Inc.") are never split.
 * Returns null when the value is not a list.
 */
function splitMulti(raw) {
  const s = asString(raw);
  if (!/[,;]/.test(s)) return null;
  const parts = s
    .split(/\s*[,;]\s*/)
    .map((p) => p.trim())
    .filter((p) => p.length > 0);
  return parts.length >= 2 ? parts : null;
}

// ---------------------------------------------------------------------------
// The checks
// ---------------------------------------------------------------------------

const CHECKS = [
  'no_placeholder_value',
  'single_value_per_field',
  'lot_in_text',
  'lot_not_a_date',
  'sublot_shape',
  'dates_parse',
  'dates_plausible',
  'date_ordering',
  'product_code_not_phone',
  'supplier_in_text',
];

/** Fields the placeholder / multi-value checks apply to. */
const SCALAR_KEYS = new Set([
  ...LOT_KEYS,
  ...SUBLOT_KEYS,
  ...DATE_KEYS,
  'product_code',
  'supplier_name',
  'po_number',
  'plant_number',
]);

function newTally() {
  const t = {};
  for (const c of CHECKS) t[c] = { checked: 0, pass: 0, fail: 0, skipped: 0 };
  return t;
}

function bump(tally, check, outcome) {
  const t = tally[check];
  if (outcome === 'skip') {
    t.skipped += 1;
    return;
  }
  t.checked += 1;
  if (outcome === 'pass') t.pass += 1;
  else t.fail += 1;
}

/** Run every invariant over one queue item. Returns {failures:[], tally}. */
function checkItem(item) {
  const failures = [];
  const tally = newTally();
  const text = item.extracted_text || '';
  const textAlnum = alnum(text);
  const textUpper = text.toUpperCase();
  const hasText = textAlnum.length > 0;
  let verbatimLotHits = 0;
  let verbatimLotChecks = 0;

  const fail = (check, field, scope, value, reason) => {
    failures.push({ check, field, scope, value: String(value).slice(0, 120), reason });
  };

  for (const bundle of bundlesFor(item)) {
    if (bundle.unparseable) {
      failures.push({
        check: 'dates_parse',
        field: bundle.scope,
        scope: bundle.scope,
        value: '',
        reason: 'extraction JSON is unparseable',
      });
      continue;
    }
    const f = bundle.fields;
    const scope = bundle.scope;

    // --- no_placeholder_value ---------------------------------------------
    // Run FIRST. A sentinel like "Multiple" is a real defect but it is NOT a
    // fabricated value, so it is scored here and excluded from every other
    // check below rather than double-counted as a hallucinated lot.
    const placeholder = new Set();
    for (const key of SCALAR_KEYS) {
      const raw = asString(f[key]);
      if (!raw) continue;
      if (isPlaceholder(raw)) {
        placeholder.add(key);
        bump(tally, 'no_placeholder_value', 'fail');
        fail('no_placeholder_value', key, scope, raw, 'sentinel string instead of a value (field should be omitted)');
      } else {
        bump(tally, 'no_placeholder_value', 'pass');
      }
    }

    // --- lot_in_text + lot_not_a_date -------------------------------------
    for (const key of LOT_KEYS) {
      const raw = asString(f[key]);
      if (!raw || placeholder.has(key)) continue;

      if (looksLikeCalendarDate(raw)) {
        bump(tally, 'lot_not_a_date', 'fail');
        fail('lot_not_a_date', key, scope, raw, 'lot field holds a calendar date');
      } else {
        bump(tally, 'lot_not_a_date', 'pass');
      }

      const norm = normalizeLotNumber(raw);
      if (!norm) {
        bump(tally, 'lot_in_text', 'skip');
        continue;
      }
      if (!hasText) {
        bump(tally, 'lot_in_text', 'skip');
        continue;
      }
      verbatimLotChecks += 1;
      if (textUpper.includes(raw.toUpperCase())) verbatimLotHits += 1;

      // Deliberately the LOOSE test: the normalized lot must occur in the
      // fully-normalized text. This under-reports fabrication (a normalized
      // needle can span two unrelated tokens) but never accuses a value that
      // merely differs in punctuation. A failure here is a strong signal.
      if (textAlnum.includes(norm)) {
        bump(tally, 'lot_in_text', 'pass');
        bump(tally, 'single_value_per_field', 'pass');
        continue;
      }

      // Whole-string miss. Before calling it fabricated, check whether the
      // model crammed several real lots into one field — a different (and
      // much more common) defect, scored separately so the fabrication
      // number stays honest.
      const parts = splitMulti(raw);
      const partsFound = parts ? parts.filter((p) => {
        const pn = normalizeLotNumber(p);
        return pn && textAlnum.includes(pn);
      }) : [];
      if (parts && partsFound.length >= 2) {
        bump(tally, 'single_value_per_field', 'fail');
        fail(
          'single_value_per_field',
          key,
          scope,
          raw,
          `${parts.length} values crammed into one field (${partsFound.length} of them do occur in the text)`
        );
        // Not a fabrication — the parts are grounded. Score lot_in_text on
        // whether EVERY part was found.
        if (partsFound.length === parts.length) {
          bump(tally, 'lot_in_text', 'pass');
        } else {
          bump(tally, 'lot_in_text', 'fail');
          fail(
            'lot_in_text',
            key,
            scope,
            raw,
            `${parts.length - partsFound.length} of ${parts.length} listed lots occur nowhere in extracted_text`
          );
        }
      } else {
        bump(tally, 'single_value_per_field', 'pass');
        bump(tally, 'lot_in_text', 'fail');
        fail('lot_in_text', key, scope, raw, `normalized "${norm}" occurs nowhere in extracted_text`);
      }
    }

    // --- sublot_shape ------------------------------------------------------
    for (const key of SUBLOT_KEYS) {
      const raw = asString(f[key]);
      if (!raw || placeholder.has(key)) continue;
      const norm = normalizeSubLotCode(raw);
      if (/^\d{2}$/.test(norm)) {
        bump(tally, 'sublot_shape', 'pass');
      } else {
        bump(tally, 'sublot_shape', 'fail');
        fail(
          'sublot_shape',
          key,
          scope,
          raw,
          `normalizes to "${norm}" (expected exactly 2 digits)`
        );
      }
    }

    // --- dates_parse / dates_plausible -------------------------------------
    const parsed = {};
    for (const key of DATE_KEYS) {
      const raw = asString(f[key]);
      if (!raw || placeholder.has(key)) continue;
      const d = parseDate(raw);
      if (!d) {
        // Same multi-value guard as lots: only after the whole string has
        // failed do we try splitting, so "Sep 5, 2026" is never split.
        const parts = splitMulti(raw);
        const parsedParts = parts ? parts.filter((p) => parseDate(p)) : [];
        if (parts && parsedParts.length >= 2) {
          bump(tally, 'single_value_per_field', 'fail');
          fail(
            'single_value_per_field',
            key,
            scope,
            raw,
            `${parts.length} dates crammed into one field (${parsedParts.length} parse)`
          );
          if (parsedParts.length === parts.length) {
            bump(tally, 'dates_parse', 'pass');
          } else {
            bump(tally, 'dates_parse', 'fail');
            fail('dates_parse', key, scope, raw, `${parts.length - parsedParts.length} of ${parts.length} listed values do not parse`);
          }
          bump(tally, 'dates_plausible', 'skip');
          continue;
        }
        bump(tally, 'single_value_per_field', 'pass');
        bump(tally, 'dates_parse', 'fail');
        bump(tally, 'dates_plausible', 'skip');
        fail('dates_parse', key, scope, raw, 'does not parse as a date');
        continue;
      }
      bump(tally, 'single_value_per_field', 'pass');
      bump(tally, 'dates_parse', 'pass');
      parsed[key] = d;
      const y = d.getUTCFullYear();
      if (y < PLAUSIBLE_MIN_YEAR || y > PLAUSIBLE_MAX_YEAR) {
        bump(tally, 'dates_plausible', 'fail');
        fail(
          'dates_plausible',
          key,
          scope,
          raw,
          `year ${y} outside ${PLAUSIBLE_MIN_YEAR}-${PLAUSIBLE_MAX_YEAR}`
        );
      } else {
        bump(tally, 'dates_plausible', 'pass');
      }
    }

    // --- date_ordering -----------------------------------------------------
    const prodKey = PRODUCTION_KEYS.find((k) => parsed[k]);
    const prod = prodKey ? parsed[prodKey] : null;
    const exp = parsed.expiration_date || parsed.best_by_date || null;
    if (prod && exp) {
      const days = (exp - prod) / DAY;
      if (days < 0) {
        bump(tally, 'date_ordering', 'fail');
        fail(
          'date_ordering',
          'expiration_date',
          scope,
          asString(f.expiration_date || f.best_by_date),
          `expires ${Math.round(-days)}d BEFORE ${prodKey}`
        );
      } else if (days === 0) {
        bump(tally, 'date_ordering', 'fail');
        fail(
          'date_ordering',
          'expiration_date',
          scope,
          asString(f.expiration_date || f.best_by_date),
          `expiration equals ${prodKey} (zero shelf life)`
        );
      } else if (days > MAX_SHELF_LIFE_DAYS) {
        bump(tally, 'date_ordering', 'fail');
        fail(
          'date_ordering',
          'expiration_date',
          scope,
          asString(f.expiration_date || f.best_by_date),
          `${Math.round(days)}d shelf life (> ${MAX_SHELF_LIFE_DAYS}d)`
        );
      } else {
        bump(tally, 'date_ordering', 'pass');
      }
    } else if (prod && parsed.code_date) {
      const days = (parsed.code_date - prod) / DAY;
      if (days < 0) {
        bump(tally, 'date_ordering', 'fail');
        fail('date_ordering', 'code_date', scope, asString(f.code_date), `code date precedes ${prodKey}`);
      } else {
        bump(tally, 'date_ordering', 'pass');
      }
    } else {
      bump(tally, 'date_ordering', 'skip');
    }

    // --- product_code_not_phone -------------------------------------------
    const pc = placeholder.has('product_code') ? '' : asString(f.product_code);
    if (pc) {
      const digits = pc.replace(/\D/g, '');
      let reason = null;
      if (looksLikePhone(pc)) reason = 'formatted as a phone number';
      else if (
        digits.length >= 10 &&
        new RegExp(`(?:phone|tel|telephone|fax|ph\\b|call)\\D{0,24}${digits.slice(0, 3)}\\D?${digits.slice(3, 6)}\\D?${digits.slice(6, 10)}`, 'i').test(text)
      ) {
        reason = 'digits appear in a phone/fax context in the document text';
      }
      if (reason) {
        bump(tally, 'product_code_not_phone', 'fail');
        fail('product_code_not_phone', 'product_code', scope, pc, reason);
      } else {
        bump(tally, 'product_code_not_phone', 'pass');
      }
    }

    // --- supplier_in_text --------------------------------------------------
    const sup = placeholder.has('supplier_name') ? '' : asString(f.supplier_name);
    if (sup && hasText) {
      const n = alnum(sup);
      // Very short names normalize to noise; skip rather than false-accuse.
      if (n.length < 4) {
        bump(tally, 'supplier_in_text', 'skip');
      } else if (textAlnum.includes(n)) {
        bump(tally, 'supplier_in_text', 'pass');
      } else {
        bump(tally, 'supplier_in_text', 'fail');
        fail('supplier_in_text', 'supplier_name', scope, sup, 'name occurs nowhere in extracted_text');
      }
    } else if (sup) {
      bump(tally, 'supplier_in_text', 'skip');
    }
  }

  return { failures, tally, verbatimLotHits, verbatimLotChecks };
}

// ---------------------------------------------------------------------------
// Aggregation + reporting
// ---------------------------------------------------------------------------

function mergeTally(into, from) {
  for (const c of CHECKS) {
    into[c].checked += from[c].checked;
    into[c].pass += from[c].pass;
    into[c].fail += from[c].fail;
    into[c].skipped += from[c].skipped;
  }
}

function pct(n, d) {
  if (!d) return '   n/a';
  return `${((n / d) * 100).toFixed(1).padStart(5)}%`;
}

function parseArgs(argv) {
  const opts = { remote: false, json: false, worst: 20, kind: null, limit: null, pageSize: 60 };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    switch (a) {
      case '--remote':
      case '-r':
        opts.remote = true;
        break;
      case '--json':
        opts.json = true;
        break;
      case '--worst':
        opts.worst = Number(argv[++i]);
        break;
      case '--kind':
        opts.kind = argv[++i];
        break;
      case '--limit':
        opts.limit = Number(argv[++i]);
        break;
      case '--page-size':
        opts.pageSize = Number(argv[++i]);
        break;
      case '-h':
      case '--help':
        printHelp();
        process.exit(0);
        break;
      default:
        console.error(`Unknown argument: ${a}`);
        process.exit(2);
    }
  }
  return opts;
}

function printHelp() {
  const src = require('fs').readFileSync(__filename, 'utf8');
  const block = src.split('\n').slice(2, 50).join('\n');
  console.log(block.replace(/^ ?\*\/?/gm, '').replace(/^\/\*\*?/gm, ''));
}

function sqlEscape(v) {
  return String(v).replace(/'/g, "''");
}

async function main() {
  const opts = parseArgs(process.argv.slice(2));
  const target = opts.remote ? 'PRODUCTION (--remote)' : 'local D1';

  if (!opts.json) {
    console.log(`bin/check-extraction-invariants — READ-ONLY`);
    console.log(`Data source: ${target}\n`);
  }

  const where = [
    "(ai_fields IS NOT NULL AND ai_fields NOT IN ('', '{}')) OR (ai_records IS NOT NULL AND ai_records NOT IN ('', '[]'))",
  ];
  if (opts.kind) where.push(`output_kind = '${sqlEscape(opts.kind)}'`);
  const whereSql = where.map((w) => `(${w})`).join(' AND ');

  const totalRow = query(
    `SELECT COUNT(*) AS n FROM processing_queue WHERE ${whereSql}`,
    opts
  )[0];
  const totalMatching = Number(totalRow ? totalRow.n : 0);

  const { rows, pages } = queryPaged(
    (limit, offset) => `
      SELECT q.id, q.output_kind, q.status, q.created_at, q.supplier AS supplier_text,
             q.supplier_id, s.name AS supplier_name,
             q.ai_fields, q.ai_records, q.extracted_text
      FROM processing_queue q
      LEFT JOIN suppliers s ON s.id = q.supplier_id
      WHERE ${whereSql}
      ORDER BY q.id
      LIMIT ${limit} OFFSET ${offset}`,
    { ...opts, pageSize: opts.pageSize, maxRows: opts.limit || undefined }
  );

  let items = rows;
  let dropped = 0;
  if (opts.limit && items.length > opts.limit) {
    dropped = items.length - opts.limit;
    items = items.slice(0, opts.limit);
  }
  const notFetched = totalMatching - rows.length;

  const overall = newTally();
  const bySupplier = new Map();
  const byField = new Map();
  const offenders = [];
  let itemsWithFailure = 0;
  let noText = 0;
  let verbatimHits = 0;
  let verbatimChecks = 0;

  for (const item of items) {
    const supplier =
      (item.supplier_name && String(item.supplier_name).trim()) ||
      (item.supplier_text && String(item.supplier_text).trim()) ||
      '(no supplier)';
    const res = checkItem(item);
    mergeTally(overall, res.tally);
    verbatimHits += res.verbatimLotHits;
    verbatimChecks += res.verbatimLotChecks;
    if (!item.extracted_text) noText += 1;

    if (!bySupplier.has(supplier)) {
      bySupplier.set(supplier, { supplier, items: 0, failedItems: 0, failures: 0, tally: newTally() });
    }
    const sup = bySupplier.get(supplier);
    sup.items += 1;
    mergeTally(sup.tally, res.tally);
    sup.failures += res.failures.length;

    if (res.failures.length > 0) {
      itemsWithFailure += 1;
      sup.failedItems += 1;
      offenders.push({
        queue_item_id: item.id,
        supplier,
        output_kind: item.output_kind,
        status: item.status,
        failure_count: res.failures.length,
        failures: res.failures,
      });
      for (const f of res.failures) {
        const k = `${f.check}::${f.field}`;
        byField.set(k, (byField.get(k) || 0) + 1);
      }
    }
  }

  offenders.sort((a, b) => b.failure_count - a.failure_count || a.queue_item_id.localeCompare(b.queue_item_id));

  const result = {
    generated_at: new Date().toISOString(),
    data_source: opts.remote ? 'remote' : 'local',
    filters: { output_kind: opts.kind, limit: opts.limit },
    coverage: {
      queue_items_with_extraction: totalMatching,
      examined: items.length,
      not_fetched: notFetched,
      dropped_by_limit: dropped,
      d1_pages: pages,
      items_without_extracted_text: noText,
    },
    items_with_at_least_one_failure: itemsWithFailure,
    checks: overall,
    lot_verbatim: { checked: verbatimChecks, verbatim_hits: verbatimHits },
    by_field: Object.fromEntries([...byField.entries()].sort((a, b) => b[1] - a[1])),
    by_supplier: [...bySupplier.values()]
      .map((s) => ({
        supplier: s.supplier,
        items: s.items,
        items_with_failure: s.failedItems,
        failures: s.failures,
        checks: s.tally,
      }))
      .sort((a, b) => b.failures - a.failures),
    worst_offenders: offenders.slice(0, opts.worst),
    caveats: [
      'Invariants are a FLOOR on the error rate, not an accuracy figure: a value that occurs in the document but belongs to a different line item passes every check here.',
      'lot_in_text uses the LOOSE normalized-substring test (punctuation stripped from both sides), so it under-reports fabrication rather than over-reporting it.',
      'Items with no extracted_text cannot be text-grounded; those checks are counted as skipped, never as passes.',
    ],
  };

  if (opts.json) {
    console.log(JSON.stringify(result, null, 2));
    return;
  }

  const c = result.coverage;
  console.log(`Queue items carrying an extraction: ${c.queue_items_with_extraction}`);
  console.log(`Examined:                           ${c.examined}  (${c.d1_pages} D1 pages)`);
  if (c.not_fetched > 0) console.log(`NOT FETCHED (paging shortfall):     ${c.not_fetched}`);
  if (c.dropped_by_limit > 0) console.log(`DROPPED by --limit:                 ${c.dropped_by_limit}`);
  console.log(`Items with no extracted_text:       ${c.items_without_extracted_text} (text-grounded checks skipped for these)`);
  console.log(
    `Items with >= 1 invariant failure:  ${result.items_with_at_least_one_failure} / ${c.examined}  (${pct(result.items_with_at_least_one_failure, c.examined).trim()})\n`
  );

  console.log('CHECK                      checked     pass     fail   fail%   skipped');
  console.log('-'.repeat(74));
  for (const check of CHECKS) {
    const t = overall[check];
    console.log(
      `${check.padEnd(24)} ${String(t.checked).padStart(8)} ${String(t.pass).padStart(8)} ` +
        `${String(t.fail).padStart(8)}  ${pct(t.fail, t.checked)} ${String(t.skipped).padStart(9)}`
    );
  }
  console.log();
  if (verbatimChecks > 0) {
    console.log(
      `Lot verbatim occurrence (stricter, informational): ${verbatimHits}/${verbatimChecks} ` +
        `(${((verbatimHits / verbatimChecks) * 100).toFixed(1)}%) of lots appear in the text with punctuation intact.\n`
    );
  }

  console.log('TOP FAILING (check :: field)');
  console.log('-'.repeat(74));
  const topFields = Object.entries(result.by_field).slice(0, 15);
  if (topFields.length === 0) console.log('  (none)');
  for (const [k, n] of topFields) console.log(`  ${String(n).padStart(5)}  ${k}`);
  console.log();

  console.log('PER-SUPPLIER (sorted by failure count)');
  console.log('-'.repeat(90));
  console.log('SUPPLIER                                  items  failItems  failures   lot_in_text  dates_ok');
  for (const s of result.by_supplier) {
    const lt = s.checks.lot_in_text;
    const dp = s.checks.dates_parse;
    const dpl = s.checks.dates_plausible;
    const dord = s.checks.date_ordering;
    const dateChecked = dp.checked + dpl.checked + dord.checked;
    const dateFail = dp.fail + dpl.fail + dord.fail;
    console.log(
      `${s.supplier.slice(0, 40).padEnd(40)} ${String(s.items).padStart(6)} ${String(s.items_with_failure).padStart(10)} ` +
        `${String(s.failures).padStart(9)}   ${`${lt.pass}/${lt.checked}`.padStart(11)}  ${`${dateChecked - dateFail}/${dateChecked}`.padStart(9)}`
    );
  }
  console.log();

  console.log(`WORST OFFENDERS (top ${Math.min(opts.worst, offenders.length)} of ${offenders.length} items with failures)`);
  console.log('-'.repeat(90));
  for (const o of offenders.slice(0, opts.worst)) {
    console.log(`  ${o.queue_item_id}  [${o.output_kind || 'null'}/${o.status}]  ${o.supplier}  — ${o.failure_count} failure(s)`);
    for (const f of o.failures.slice(0, 6)) {
      console.log(`      ${f.check} ${f.scope}.${f.field} = "${f.value}" — ${f.reason}`);
    }
    if (o.failures.length > 6) console.log(`      ... ${o.failures.length - 6} more`);
  }
  console.log();

  console.log('HOW TO READ THIS');
  console.log('-'.repeat(74));
  for (const cav of result.caveats) console.log(`  * ${cav}`);
}

main().catch((err) => {
  console.error(err.stack || String(err));
  process.exit(1);
});

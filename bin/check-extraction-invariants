#!/usr/bin/env node
/* eslint-disable no-console */
/**
 * bin/check-extraction-invariants — READ-ONLY corpus-scale sanity check on
 * extracted field values. No model, no answer key, no hand grading.
 *
 * The idea: a lot of extraction failure is detectable from the document
 * ALONE. If the model reports a lot number that appears nowhere in the
 * document's own text, that value was fabricated or borrowed from a
 * neighbouring page. If it reports an expiration date before the production
 * date, or a "product code" that is the supplier's phone number, that is
 * wrong without anyone needing to open the PDF. These checks cost nothing and
 * run over the WHOLE corpus, not a graded sample.
 *
 * What it does NOT tell you: whether a value that passes every invariant is
 * actually the RIGHT value. A lot number that occurs in the document but
 * belongs to a different line item passes `lot_in_text`. Treat the failure
 * counts as a FLOOR on the error rate, never as an accuracy figure.
 *
 * Source of truth: `processing_queue`. That is the only table carrying
 * `extracted_text` alongside the extraction, so it is the only place the
 * text-grounding checks can run. Both extraction shapes are walked:
 *   - flat `ai_fields`  {"lot_number": "...", ...}
 *   - records mode `ai_records` {page_metadata:{...}, records:[{fields:{...}}]}
 *
 * READ-ONLY GUARANTEE: every statement goes through bin/lib/d1.js#query,
 * which refuses anything that is not SELECT/WITH. No writes, ever.
 *
 * Usage:
 *   bin/check-extraction-invariants                 # LOCAL D1
 *   bin/check-extraction-invariants --remote        # PRODUCTION D1 (read-only)
 *   bin/check-extraction-invariants --remote --json > out.json
 *   bin/check-extraction-invariants --remote --worst 40
 *   bin/check-extraction-invariants --remote --kind coa
 *
 * Flags:
 *   --remote, -r      query production D1 instead of local
 *   --json            emit the full result structure as JSON (no text report)
 *   --worst N         how many worst-offender items to list (default 20)
 *   --kind K          restrict to one output_kind (e.g. coa, order)
 *   --limit N         cap the number of queue items examined (prints what
 *                     was dropped; default: no cap)
 *   --page-size N     D1 paging size (default 60)
 *   -h, --help        this help
 *
 * Exit code is always 0 on a successful run — findings are data, not failures.
 */

const { query, queryPaged } = require('./lib/d1');
const {
  CHECKS,
  checkExtraction,
  newTally,
  mergeTally,
} = require('./lib/shared/extractionInvariants');

// ---------------------------------------------------------------------------
// NO LOGIC LIVES IN THIS FILE.
//
// Every invariant — the lot/sublot normalization, the text grounding, the date
// ordering, the phone-number and field-label-role checks — is defined once in
// `shared/extractionInvariants.ts` and consumed here through the esbuild bundle
// at `bin/lib/shared/extractionInvariants.js` (regenerate with
// `npm run build:worker-shared`). The Review Queue API imports the SAME module
// so a warning a reviewer sees inline is byte-for-byte the same finding this
// corpus report counts. This file is CLI + paging + aggregation + printing.
//
// (This replaces a hand-maintained CommonJS mirror of both the checks and
// functions/lib/entities/lots.ts. The mirror is gone; do not reintroduce one.)
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Aggregation + reporting
// ---------------------------------------------------------------------------

function pct(n, d) {
  if (!d) return '   n/a';
  return `${((n / d) * 100).toFixed(1).padStart(5)}%`;
}

function parseArgs(argv) {
  const opts = { remote: false, json: false, worst: 20, kind: null, limit: null, pageSize: 60 };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    switch (a) {
      case '--remote':
      case '-r':
        opts.remote = true;
        break;
      case '--json':
        opts.json = true;
        break;
      case '--worst':
        opts.worst = Number(argv[++i]);
        break;
      case '--kind':
        opts.kind = argv[++i];
        break;
      case '--limit':
        opts.limit = Number(argv[++i]);
        break;
      case '--page-size':
        opts.pageSize = Number(argv[++i]);
        break;
      case '-h':
      case '--help':
        printHelp();
        process.exit(0);
        break;
      default:
        console.error(`Unknown argument: ${a}`);
        process.exit(2);
    }
  }
  return opts;
}

function printHelp() {
  const src = require('fs').readFileSync(__filename, 'utf8');
  const block = src.split('\n').slice(2, 50).join('\n');
  console.log(block.replace(/^ ?\*\/?/gm, '').replace(/^\/\*\*?/gm, ''));
}

function sqlEscape(v) {
  return String(v).replace(/'/g, "''");
}

async function main() {
  const opts = parseArgs(process.argv.slice(2));
  const target = opts.remote ? 'PRODUCTION (--remote)' : 'local D1';

  if (!opts.json) {
    console.log(`bin/check-extraction-invariants — READ-ONLY`);
    console.log(`Data source: ${target}\n`);
  }

  const where = [
    "(ai_fields IS NOT NULL AND ai_fields NOT IN ('', '{}')) OR (ai_records IS NOT NULL AND ai_records NOT IN ('', '[]'))",
  ];
  if (opts.kind) where.push(`output_kind = '${sqlEscape(opts.kind)}'`);
  const whereSql = where.map((w) => `(${w})`).join(' AND ');

  const totalRow = query(
    `SELECT COUNT(*) AS n FROM processing_queue WHERE ${whereSql}`,
    opts
  )[0];
  const totalMatching = Number(totalRow ? totalRow.n : 0);

  const { rows, pages } = queryPaged(
    (limit, offset) => `
      SELECT q.id, q.output_kind, q.status, q.created_at, q.supplier AS supplier_text,
             q.supplier_id, s.name AS supplier_name, t.name AS tenant_name,
             q.ai_fields, q.ai_records, q.extracted_text
      FROM processing_queue q
      LEFT JOIN suppliers s ON s.id = q.supplier_id
      LEFT JOIN tenants t ON t.id = q.tenant_id
      WHERE ${whereSql}
      ORDER BY q.id
      LIMIT ${limit} OFFSET ${offset}`,
    { ...opts, pageSize: opts.pageSize, maxRows: opts.limit || undefined }
  );

  let items = rows;
  let dropped = 0;
  if (opts.limit && items.length > opts.limit) {
    dropped = items.length - opts.limit;
    items = items.slice(0, opts.limit);
  }
  const notFetched = totalMatching - rows.length;

  const overall = newTally();
  const bySupplier = new Map();
  const byField = new Map();
  const offenders = [];
  let itemsWithFailure = 0;
  let noText = 0;
  let verbatimHits = 0;
  let verbatimChecks = 0;

  for (const item of items) {
    const supplier =
      (item.supplier_name && String(item.supplier_name).trim()) ||
      (item.supplier_text && String(item.supplier_text).trim()) ||
      '(no supplier)';
    // selfNames powers supplier_not_self: the receiving org can never be its
    // own supplier. Tenant name only — alias tables are not read here.
    const res = checkExtraction(item, { selfNames: [item.tenant_name] });
    mergeTally(overall, res.tally);
    verbatimHits += res.verbatimLotHits;
    verbatimChecks += res.verbatimLotChecks;
    if (!item.extracted_text) noText += 1;

    if (!bySupplier.has(supplier)) {
      bySupplier.set(supplier, { supplier, items: 0, failedItems: 0, failures: 0, tally: newTally() });
    }
    const sup = bySupplier.get(supplier);
    sup.items += 1;
    mergeTally(sup.tally, res.tally);
    sup.failures += res.failures.length;

    if (res.failures.length > 0) {
      itemsWithFailure += 1;
      sup.failedItems += 1;
      offenders.push({
        queue_item_id: item.id,
        supplier,
        output_kind: item.output_kind,
        status: item.status,
        failure_count: res.failures.length,
        failures: res.failures,
      });
      for (const f of res.failures) {
        const k = `${f.check}::${f.field}`;
        byField.set(k, (byField.get(k) || 0) + 1);
      }
    }
  }

  offenders.sort((a, b) => b.failure_count - a.failure_count || a.queue_item_id.localeCompare(b.queue_item_id));

  const result = {
    generated_at: new Date().toISOString(),
    data_source: opts.remote ? 'remote' : 'local',
    filters: { output_kind: opts.kind, limit: opts.limit },
    coverage: {
      queue_items_with_extraction: totalMatching,
      examined: items.length,
      not_fetched: notFetched,
      dropped_by_limit: dropped,
      d1_pages: pages,
      items_without_extracted_text: noText,
    },
    items_with_at_least_one_failure: itemsWithFailure,
    checks: overall,
    lot_verbatim: { checked: verbatimChecks, verbatim_hits: verbatimHits },
    by_field: Object.fromEntries([...byField.entries()].sort((a, b) => b[1] - a[1])),
    by_supplier: [...bySupplier.values()]
      .map((s) => ({
        supplier: s.supplier,
        items: s.items,
        items_with_failure: s.failedItems,
        failures: s.failures,
        checks: s.tally,
      }))
      .sort((a, b) => b.failures - a.failures),
    worst_offenders: offenders.slice(0, opts.worst),
    caveats: [
      'Invariants are a FLOOR on the error rate, not an accuracy figure: a value that occurs in the document but belongs to a different line item passes every check here.',
      'lot_in_text uses the LOOSE normalized-substring test (punctuation stripped from both sides), so it under-reports fabrication rather than over-reporting it.',
      'Items with no extracted_text cannot be text-grounded; those checks are counted as skipped, never as passes.',
    ],
  };

  if (opts.json) {
    console.log(JSON.stringify(result, null, 2));
    return;
  }

  const c = result.coverage;
  console.log(`Queue items carrying an extraction: ${c.queue_items_with_extraction}`);
  console.log(`Examined:                           ${c.examined}  (${c.d1_pages} D1 pages)`);
  if (c.not_fetched > 0) console.log(`NOT FETCHED (paging shortfall):     ${c.not_fetched}`);
  if (c.dropped_by_limit > 0) console.log(`DROPPED by --limit:                 ${c.dropped_by_limit}`);
  console.log(`Items with no extracted_text:       ${c.items_without_extracted_text} (text-grounded checks skipped for these)`);
  console.log(
    `Items with >= 1 invariant failure:  ${result.items_with_at_least_one_failure} / ${c.examined}  (${pct(result.items_with_at_least_one_failure, c.examined).trim()})\n`
  );

  console.log('CHECK                      checked     pass     fail   fail%   skipped');
  console.log('-'.repeat(74));
  for (const check of CHECKS) {
    const t = overall[check];
    console.log(
      `${check.padEnd(24)} ${String(t.checked).padStart(8)} ${String(t.pass).padStart(8)} ` +
        `${String(t.fail).padStart(8)}  ${pct(t.fail, t.checked)} ${String(t.skipped).padStart(9)}`
    );
  }
  console.log();
  if (verbatimChecks > 0) {
    console.log(
      `Lot verbatim occurrence (stricter, informational): ${verbatimHits}/${verbatimChecks} ` +
        `(${((verbatimHits / verbatimChecks) * 100).toFixed(1)}%) of lots appear in the text with punctuation intact.\n`
    );
  }

  console.log('TOP FAILING (check :: field)');
  console.log('-'.repeat(74));
  const topFields = Object.entries(result.by_field).slice(0, 15);
  if (topFields.length === 0) console.log('  (none)');
  for (const [k, n] of topFields) console.log(`  ${String(n).padStart(5)}  ${k}`);
  console.log();

  console.log('PER-SUPPLIER (sorted by failure count)');
  console.log('-'.repeat(90));
  console.log('SUPPLIER                                  items  failItems  failures   lot_in_text  dates_ok');
  for (const s of result.by_supplier) {
    const lt = s.checks.lot_in_text;
    const dp = s.checks.dates_parse;
    const dpl = s.checks.dates_plausible;
    const dord = s.checks.date_ordering;
    const dateChecked = dp.checked + dpl.checked + dord.checked;
    const dateFail = dp.fail + dpl.fail + dord.fail;
    console.log(
      `${s.supplier.slice(0, 40).padEnd(40)} ${String(s.items).padStart(6)} ${String(s.items_with_failure).padStart(10)} ` +
        `${String(s.failures).padStart(9)}   ${`${lt.pass}/${lt.checked}`.padStart(11)}  ${`${dateChecked - dateFail}/${dateChecked}`.padStart(9)}`
    );
  }
  console.log();

  console.log(`WORST OFFENDERS (top ${Math.min(opts.worst, offenders.length)} of ${offenders.length} items with failures)`);
  console.log('-'.repeat(90));
  for (const o of offenders.slice(0, opts.worst)) {
    console.log(`  ${o.queue_item_id}  [${o.output_kind || 'null'}/${o.status}]  ${o.supplier}  — ${o.failure_count} failure(s)`);
    for (const f of o.failures.slice(0, 6)) {
      console.log(`      ${f.check} ${f.scope}.${f.field} = "${f.value}" — ${f.reason}`);
    }
    if (o.failures.length > 6) console.log(`      ... ${o.failures.length - 6} more`);
  }
  console.log();

  console.log('HOW TO READ THIS');
  console.log('-'.repeat(74));
  for (const cav of result.caveats) console.log(`  * ${cav}`);
}

main().catch((err) => {
  console.error(err.stack || String(err));
  process.exit(1);
});

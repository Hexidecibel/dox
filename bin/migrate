#!/usr/bin/env bash
# Apply pending D1 migrations, tracked via a `_migrations` table.
#
# Usage:
#   ./bin/migrate                 # apply pending migrations to LOCAL D1
#   ./bin/migrate --remote        # apply pending migrations to PROD D1
#   ./bin/migrate --mark-applied  # one-time backfill: mark every file in
#                                 # migrations/ as already applied without
#                                 # running it. Use this once per env when
#                                 # adopting the tracking table on a DB that
#                                 # already had the older "run-everything"
#                                 # script applied to it. Add --remote to
#                                 # backfill the prod tracking table.
#   ./bin/migrate --only 0080_x.sql [--only 0081_y.sql]
#                                 # SURGICAL: apply exactly the named
#                                 # migration(s), in the order given, then
#                                 # stamp them. Nothing else runs.
#   ./bin/migrate --reapply --only 0139_x.sql [--persist-to DIR]
#                                 # LOCAL ONLY: run a named migration again
#                                 # even though it is stamped. For a file that
#                                 # was AMENDED after a local database ran its
#                                 # first cut and before it was applied
#                                 # anywhere else. A one-line
#                                 # `ALTER TABLE t ADD COLUMN c ...;` whose
#                                 # column is already there is LEFT OUT (and
#                                 # said), since SQLite cannot add a column
#                                 # "if not exists". Everything else in the
#                                 # file must be safe to run over its own
#                                 # first cut (IF NOT EXISTS, guarded UPDATEs).
#                                 # Refused with --remote: a migration applied
#                                 # to production is never amended.
#   ./bin/migrate --persist-to DIR [--only ...]
#                                 # LOCAL only: use the local D1 state under
#                                 # DIR (wrangler's --persist-to). A git
#                                 # worktree has no .wrangler of its own, so
#                                 # this points it at the main checkout's
#                                 # local database instead of a fresh empty one.
#
# WHY --only EXISTS: the migration chain is NOT re-runnable from scratch and
# the `_migrations` tracking table has drifted from the files in several
# environments (prod notably). A plain `./bin/migrate` walks every unstamped
# file and aborts on the first one that was already applied by hand ("duplicate
# column name: ..."), which blocks the new migration you actually wanted. The
# standing workflow for a NEW migration is therefore: apply it surgically with
# --only, which touches nothing else and leaves the drift alone. Do not
# "fix" the drift by bulk-running the chain.
#
# How it works:
#   - Ensures a `_migrations (filename TEXT PRIMARY KEY, applied_at TEXT
#     NOT NULL DEFAULT (datetime('now')))` table exists in the target D1.
#   - Iterates migrations/*.sql in lexical (== numeric) order.
#   - Skips any filename already present in `_migrations`.
#   - Runs the migration via `wrangler d1 execute --file=...`. On success,
#     INSERTs the filename into `_migrations`. On failure, surfaces the SQL
#     error and aborts WITHOUT marking the migration as applied.
#
# Notes:
#   - Sister script `bin/migrate-staging` has its own quirks (0017 drop /
#     0020 recreate workaround) and is not changed here.
set -euo pipefail
cd "$(dirname "$0")/.."

DB="doc-upload-db"
REMOTE_FLAG=""
MARK_APPLIED=0
REAPPLY=0
ONLY=()
PERSIST_FLAG=""


while [ "$#" -gt 0 ]; do
  case "$1" in
    --remote|-r)
      REMOTE_FLAG="--remote"
      ;;
    --mark-applied)
      MARK_APPLIED=1
      ;;
    --reapply)
      REAPPLY=1
      ;;
    --only)
      shift
      [ "$#" -gt 0 ] || { echo "--only requires a migration filename" >&2; exit 2; }
      ONLY+=("$1")
      ;;
    --only=*)
      ONLY+=("${1#--only=}")
      ;;
    --persist-to)
      shift
      [ "$#" -gt 0 ] || { echo "--persist-to requires a directory" >&2; exit 2; }
      PERSIST_FLAG="--local --persist-to=$1"
      ;;
    -h|--help)
      sed -n '2,40p' "$0"
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      exit 2
      ;;
  esac
  shift
done

if [ "$REAPPLY" = "1" ] && [ -n "$REMOTE_FLAG" ]; then
  echo "--reapply is for LOCAL D1 only: a migration applied to production is never amended" >&2
  exit 2
fi
if [ "$REAPPLY" = "1" ] && [ "${#ONLY[@]}" -eq 0 ]; then
  echo "--reapply needs --only <migration>" >&2
  exit 2
fi

if [ -n "$REMOTE_FLAG" ] && [ -n "$PERSIST_FLAG" ]; then
  echo "--persist-to is for LOCAL D1 only" >&2
  exit 2
fi

if [ -n "$REMOTE_FLAG" ]; then
  echo "Target: REMOTE (production D1)"
  echo "Press Ctrl+C within 3 seconds to cancel..."
  sleep 3
else
  echo "Target: local D1"
fi

# wrangler d1 execute helpers
d1_exec_cmd() {
  npx wrangler d1 execute "$DB" $REMOTE_FLAG $PERSIST_FLAG --command="$1"
}

d1_exec_file() {
  npx wrangler d1 execute "$DB" $REMOTE_FLAG $PERSIST_FLAG --file="$1"
}

# 1. Ensure the tracking table exists.
echo "Ensuring _migrations tracking table exists..."
d1_exec_cmd "CREATE TABLE IF NOT EXISTS _migrations (
  filename TEXT PRIMARY KEY,
  applied_at TEXT NOT NULL DEFAULT (datetime('now'))
);" >/dev/null

# 2. Fetch the set of already-applied filenames.
#    We query as JSON and parse out the filename column.
applied_json="$(npx wrangler d1 execute "$DB" $REMOTE_FLAG $PERSIST_FLAG \
  --command="SELECT filename FROM _migrations;" --json 2>/dev/null || echo '[]')"

# Extract filenames into a newline-delimited list. Tolerate either a top-level
# array or a {results:[...]} shape that wrangler may emit.
APPLIED_FILE="$(mktemp)"
trap 'rm -f "$APPLIED_FILE"' EXIT
node -e "
  let raw = process.argv[1] || '[]';
  let data;
  try { data = JSON.parse(raw); } catch (e) { data = []; }
  // wrangler returns an array of statement results; flatten to rows.
  const rows = [];
  const visit = (v) => {
    if (!v) return;
    if (Array.isArray(v)) { v.forEach(visit); return; }
    if (typeof v === 'object') {
      if (Array.isArray(v.results)) { v.results.forEach(visit); return; }
      if (typeof v.filename === 'string') { rows.push(v.filename); return; }
      Object.values(v).forEach(visit);
    }
  };
  visit(data);
  console.log([...new Set(rows)].join('\n'));
" "$applied_json" > "$APPLIED_FILE"

is_applied() {
  local name="$1"
  grep -Fxq "$name" "$APPLIED_FILE"
}

mark_applied() {
  local name="$1"
  # Use parameterized escaping by replacing single quotes.
  local escaped="${name//\'/\'\'}"
  d1_exec_cmd "INSERT OR IGNORE INTO _migrations (filename) VALUES ('$escaped');" >/dev/null
}

# 3. Mark-applied mode: stamp every file as applied without running it.
if [ "$MARK_APPLIED" = "1" ]; then
  echo "Mark-applied mode: stamping every migration in migrations/ as applied without running it."
  count=0
  for migration in migrations/*.sql; do
    name=$(basename "$migration")
    if is_applied "$name"; then
      echo "  already tracked: $name"
    else
      echo "  marking: $name"
      mark_applied "$name"
      count=$((count + 1))
    fi
  done
  echo "Done. Marked $count new migration(s) as applied."
  exit 0
fi

# 3b. Surgical mode: apply exactly the named migration(s) and stamp them.
if [ "${#ONLY[@]}" -gt 0 ]; then
  echo "Surgical mode: applying ${#ONLY[@]} named migration(s) only."
  for name in "${ONLY[@]}"; do
    name="$(basename "$name")"
    path="migrations/$name"
    if [ ! -f "$path" ]; then
      echo "ERROR: no such migration: $path" >&2
      exit 1
    fi
    if is_applied "$name" && [ "$REAPPLY" != "1" ]; then
      echo "  already applied, skipping: $name"
      continue
    fi
    if is_applied "$name"; then
      echo "  already applied; --reapply given, running it again: $name"
      # Leave out each ADD COLUMN whose column the database already has.
      REAPPLY_FILE="$(mktemp --suffix=.sql)"
      cp "$path" "$REAPPLY_FILE"
      while IFS=$'\t' read -r tbl col; do
        [ -n "$tbl" ] || continue
        has="$(npx wrangler d1 execute "$DB" $PERSIST_FLAG --json \
          --command="SELECT COUNT(*) AS n FROM pragma_table_info('$tbl') WHERE name = '$col';" 2>/dev/null \
          | node -e "let s='';process.stdin.on('data',d=>s+=d).on('end',()=>{const m=/\"n\":\s*(\d+)/.exec(s);console.log(m?m[1]:'0')})")"
        if [ "$has" != "0" ]; then
          echo "  $tbl.$col is already there; leaving its ADD COLUMN out"
          node -e "
            const fs=require('fs');const [f,t,c]=process.argv.slice(1);
            const re=new RegExp('^\\\\s*ALTER\\\\s+TABLE\\\\s+'+t+'\\\\s+ADD\\\\s+COLUMN\\\\s+'+c+'\\\\b.*;\\\\s*$','i');
            fs.writeFileSync(f, fs.readFileSync(f,'utf8').split('\n').filter(l=>!re.test(l)).join('\n'));
          " "$REAPPLY_FILE" "$tbl" "$col"
        fi
      done < <(grep -iE '^[[:space:]]*ALTER[[:space:]]+TABLE[[:space:]]+[A-Za-z_]+[[:space:]]+ADD[[:space:]]+COLUMN[[:space:]]+[A-Za-z_]+' "$path" \
               | sed -E 's/^[[:space:]]*ALTER[[:space:]]+TABLE[[:space:]]+([A-Za-z_]+)[[:space:]]+ADD[[:space:]]+COLUMN[[:space:]]+([A-Za-z_]+).*/\1\t\2/I')
      path="$REAPPLY_FILE"
    fi
    echo "Applying: $name"
    if ! d1_exec_file "$path"; then
      echo "" >&2
      echo "ERROR: migration $name failed. Aborting." >&2
      echo "Tracking row NOT inserted; rerun after fixing the SQL." >&2
      exit 1
    fi
    mark_applied "$name"
  done
  echo "Done."
  exit 0
fi

# 4. Normal mode: apply pending migrations in order.
pending=0
applied=0
for migration in migrations/*.sql; do
  name=$(basename "$migration")
  if is_applied "$name"; then
    continue
  fi
  pending=$((pending + 1))
  echo "Applying: $name"
  if ! d1_exec_file "$migration"; then
    echo "" >&2
    echo "ERROR: migration $name failed. Aborting." >&2
    echo "Tracking row NOT inserted; rerun after fixing the SQL." >&2
    exit 1
  fi
  mark_applied "$name"
  applied=$((applied + 1))
done

if [ "$pending" = "0" ]; then
  echo "No pending migrations. Database is up to date."
else
  echo "Applied $applied migration(s)."
fi

#!/usr/bin/env node
/* eslint-disable no-console */
/**
 * bin/import-spec-limits — load a spec-limit workbook into spec_tests/spec_limits.
 *
 * The thresholds are the easy half. The SYNONYM MAP is the work: a limit whose
 * analyte name never matches what a supplier prints is a limit that silently
 * never runs, and no register can report a check that never happened. This
 * script exists so that map arrives from a spreadsheet a human maintains,
 * instead of thirty-seven clicks through Settings.
 *
 * WHICH TABS IT READS
 *   "Limits by Analyte"   — one row per analyte, the threshold stated ONCE.
 *   "Test Name Variants"  — every spelling suppliers print, keyed to an analyte.
 * The workbook's "Spec Limits" tab joins those two for reading. It repeats each
 * limit once per spelling, so importing it would create 37 limits where 8
 * belong. It is deliberately ignored.
 *
 * WHAT IT WILL NOT DO
 *   - Replace an alias array. Aliases MERGE; a re-run never deletes a spelling
 *     someone added by hand. (The REST API's PUT does replace — this does not.)
 *   - Write a scoped limit. Only tenant-wide rows (supplier/doctype/product all
 *     NULL) come from the sheet; anything else is a sheet error.
 *   - Import a unit the spec engine cannot place. That would make every result
 *     for the analyte "not checked" forever, which reads as silence rather than
 *     as a misconfiguration. --force overrides, knowingly.
 *   - Write anything without --apply.
 *
 * Usage:
 *   bin/import-spec-limits --tenant <id> --file <book.xlsx>            # dry run
 *   bin/import-spec-limits --tenant <id> --file <book.xlsx> --apply    # LOCAL write
 *   bin/import-spec-limits --tenant <id> --file <book.xlsx> --remote --apply
 *
 * Flags:
 *   --tenant ID       tenant to import into (required)
 *   --file PATH       the .xlsx workbook (required)
 *   --apply           actually write. Without it this is a dry run.
 *   --remote, -r      target PRODUCTION D1 (with --apply, prompts first)
 *   --force           import despite unit errors (see above)
 *   --yes, -y         skip the production confirmation prompt
 *   --json            emit the plan as JSON instead of prose
 *   -h, --help        this help
 *
 * Re-running after a successful --apply reports 0 created and 0 changed.
 */

const fs = require('fs');
const os = require('os');
const path = require('path');
const crypto = require('crypto');
const { execFileSync } = require('child_process');

const { query, PROJECT_ROOT, DEFAULT_DB } = require('./lib/d1');
const { normalizeUnit, validateLimitShape } = require('./lib/shared/specCheck');
const {
  parseAnalyteSheet,
  parseVariantSheet,
  buildPlan,
  planToSql,
  formatPlan,
} = require('./lib/specLimitsImport');

const ANALYTE_SHEET = 'Limits by Analyte';
const VARIANT_SHEET = 'Test Name Variants';

function parseArgs(argv) {
  const opts = {
    tenant: null,
    file: null,
    apply: false,
    remote: false,
    force: false,
    yes: false,
    json: false,
  };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    switch (a) {
      case '--tenant': opts.tenant = argv[++i]; break;
      case '--file': opts.file = argv[++i]; break;
      case '--apply': opts.apply = true; break;
      case '--remote':
      case '-r': opts.remote = true; break;
      case '--force': opts.force = true; break;
      case '--yes':
      case '-y': opts.yes = true; break;
      case '--json': opts.json = true; break;
      case '-h':
      case '--help': printHelp(); process.exit(0); break;
      default:
        console.error(`Unknown argument: ${a}`);
        process.exit(2);
    }
  }
  if (!opts.tenant) {
    console.error('--tenant <id> is required. Run with --help for usage.');
    process.exit(2);
  }
  // Values reach D1 as part of a command string, so the one id we interpolate
  // into the read queries gets a hard shape check rather than trust.
  if (!/^[A-Za-z0-9_-]+$/.test(opts.tenant)) {
    console.error('--tenant must be an id: letters, digits, dashes, underscores.');
    process.exit(2);
  }
  if (!opts.file) {
    console.error('--file <path-to.xlsx> is required. Run with --help for usage.');
    process.exit(2);
  }
  if (!fs.existsSync(opts.file)) {
    console.error(`No such file: ${opts.file}`);
    process.exit(2);
  }
  return opts;
}

function printHelp() {
  const src = fs.readFileSync(__filename, 'utf8');
  console.log(src.split('\n').slice(3, 44).join('\n').replace(/^ \* ?/gm, ''));
}

/** Read the two source tabs as arrays of rows. */
function readSheets(file) {
  let XLSX;
  try {
    XLSX = require('xlsx');
  } catch {
    console.error('The `xlsx` package is not installed. Run `npm install` first.');
    process.exit(1);
  }
  const wb = XLSX.readFile(file);
  const grab = (name) => {
    const ws = wb.Sheets[name];
    if (!ws) {
      console.error(
        `The workbook has no "${name}" tab. It holds: ${wb.SheetNames.join(', ')}.\n` +
          'This importer reads only "Limits by Analyte" and "Test Name Variants" — the\n' +
          '"Spec Limits" tab is a denormalized view and importing it would duplicate every limit.'
      );
      process.exit(1);
    }
    return XLSX.utils.sheet_to_json(ws, { header: 1, raw: false, defval: '' });
  };
  return { analyteRows: grab(ANALYTE_SHEET), variantRows: grab(VARIANT_SHEET) };
}

/** Existing analytes for the tenant, aliases already parsed. */
function loadTests(tenant, remote) {
  const rows = query(
    `SELECT id, name, aliases, default_unit FROM spec_tests WHERE tenant_id = '${tenant}'`,
    { remote }
  );
  return rows.map((r) => {
    let aliases = [];
    try {
      const parsed = JSON.parse(r.aliases || '[]');
      if (Array.isArray(parsed)) aliases = parsed.map(String);
    } catch {
      // A corrupt blob costs this analyte its stored synonyms. Say so loudly —
      // merging onto [] would look like a successful merge that silently
      // dropped every spelling the tenant had.
      console.error(
        `WARNING: spec_tests.aliases for "${r.name}" is not valid JSON. It will be REBUILT ` +
          'from the sheet alone; any hand-added spelling in that blob is lost. Fix it first ' +
          'if that matters.'
      );
    }
    return { id: r.id, name: r.name, aliases, default_unit: r.default_unit };
  });
}

function loadLimits(tenant, remote) {
  return query(
    `SELECT id, spec_test_id, supplier_id, document_type_id, product_id, operator,
            value_min, value_max, unit, severity, criticality, notes, active, version
       FROM spec_limits WHERE tenant_id = '${tenant}'`,
    { remote }
  );
}

/**
 * The database is not empty of meaning: importing into a tenant that does not
 * exist would create orphan rows the FK will reject anyway, with a worse error.
 */
function assertTenant(tenant, remote) {
  const rows = query(`SELECT id, name FROM tenants WHERE id = '${tenant}'`, { remote });
  if (rows.length === 0) {
    console.error(`No tenant "${tenant}" in this database. Check the id, or the --remote flag.`);
    process.exit(1);
  }
  return rows[0];
}

/**
 * Apply the plan. bin/lib/d1.js is READ-ONLY by design and stays that way — the
 * write path is here, and it mirrors bin/migrate: render the statements to a
 * file and hand it to `wrangler d1 execute --file`, so nothing is glued into a
 * shell command line and a long plan cannot overflow one.
 */
function execSql(statements, remote) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'dox-spec-import-'));
  const file = path.join(dir, 'import-spec-limits.sql');
  fs.writeFileSync(file, `${statements.join('\n')}\n`, 'utf8');
  try {
    execFileSync(
      'npx',
      [
        'wrangler',
        'd1',
        'execute',
        DEFAULT_DB,
        remote ? '--remote' : '--local',
        `--file=${file}`,
      ],
      { cwd: PROJECT_ROOT, stdio: ['ignore', 'pipe', 'pipe'], maxBuffer: 64 * 1024 * 1024 }
    );
  } catch (err) {
    const stderr = err.stderr ? err.stderr.toString() : '';
    throw new Error(`Writing to D1 failed. The SQL is at ${file}\n${stderr || err.message}`);
  }
  fs.rmSync(dir, { recursive: true, force: true });
}

function confirmProduction(tenant, plan) {
  const answer = promptSync(
    `\nAbout to WRITE to PRODUCTION D1 for tenant ${tenant}: ` +
      `${plan.summary.analytesCreated} analyte(s) created, ${plan.summary.analytesUpdated} updated, ` +
      `${plan.summary.limitsCreated} limit(s) created, ${plan.summary.limitsUpdated} updated.\n` +
      'Type the tenant id to continue: '
  );
  if (answer.trim() !== tenant) {
    console.error('That did not match. Nothing was written.');
    process.exit(1);
  }
}

/** Blocking one-line read from the terminal; no dependency needed. */
function promptSync(question) {
  process.stdout.write(question);
  let fd;
  try {
    fd = fs.openSync('/dev/tty', 'rs');
  } catch {
    console.error('\nNo terminal to confirm on. Re-run interactively, or pass --yes.');
    process.exit(1);
  }
  const buf = Buffer.alloc(256);
  let out = '';
  for (;;) {
    const n = fs.readSync(fd, buf, 0, buf.length, null);
    if (n === 0) break;
    out += buf.toString('utf8', 0, n);
    if (out.includes('\n')) break;
  }
  fs.closeSync(fd);
  return out.split('\n')[0];
}

function main() {
  const opts = parseArgs(process.argv.slice(2));
  const remote = opts.remote;
  const targetLabel = remote ? 'PRODUCTION' : 'local';

  const tenant = assertTenant(opts.tenant, remote);

  const { analyteRows, variantRows } = readSheets(opts.file);
  const parsedAnalytes = parseAnalyteSheet(analyteRows);
  const parsedVariants = parseVariantSheet(variantRows);

  const plan = buildPlan({
    tenantId: opts.tenant,
    analytes: parsedAnalytes.analytes,
    variants: parsedVariants.variants,
    existingTests: loadTests(opts.tenant, remote),
    existingLimits: loadLimits(opts.tenant, remote),
    normalizeUnit,
    validateLimitShape,
    newId: () => crypto.randomUUID().replace(/-/g, ''),
  });
  plan.errors = [...parsedAnalytes.errors, ...parsedVariants.errors, ...plan.errors];
  plan.summary.errors = plan.errors.length;

  if (opts.json) {
    console.log(JSON.stringify({ tenant: tenant.name, target: targetLabel, plan }, null, 2));
  } else {
    for (const line of formatPlan(plan, { targetLabel: `${tenant.name}, ${targetLabel}` })) {
      console.log(line);
    }
  }

  if (plan.errors.length > 0 && !opts.force) {
    console.error(
      `${plan.errors.length} problem(s) in the sheet. Nothing was written.\n` +
        'Fix the workbook, or re-run with --force if you have read every line above and ' +
        'still want the rows that do parse.'
    );
    process.exit(1);
  }
  if (plan.errors.length > 0 && opts.force) {
    console.log(
      '--force: proceeding despite the problems above. A row that failed to PARSE was\n' +
      'never in the plan and is skipped; a row flagged only for its unit IS imported, and\n' +
      'every result for that analyte will read "not checked" until the unit is fixed.'
    );
  }

  const statements = planToSql(plan);

  if (!opts.apply) {
    console.log(
      statements.length === 0
        ? 'DRY RUN — nothing to do; the database already matches the sheet.'
        : `DRY RUN — ${statements.length} statement(s) not executed. Re-run with --apply to write.`
    );
    return;
  }

  if (statements.length === 0) {
    console.log('Nothing to do — the database already matches the sheet.');
    return;
  }

  if (remote && !opts.yes) confirmProduction(opts.tenant, plan);

  execSql(statements, remote);
  console.log(`Applied ${statements.length} statement(s) to ${targetLabel} D1.`);
  console.log('Preview what these limits would catch with: bin/recheck-spec-limits --tenant ' + opts.tenant);
}

try {
  main();
} catch (err) {
  console.error(err instanceof Error ? err.message : String(err));
  process.exit(1);
}

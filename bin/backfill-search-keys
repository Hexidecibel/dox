#!/usr/bin/env node
/* eslint-disable no-console */
/**
 * bin/backfill-search-keys — give every existing document its search keys
 * (migration 0122 `document_search_keys`).
 *
 * WHY
 *
 * PO, invoice, identifier and code / best-by date search SEEK on
 * document_search_keys instead of judging every document. The 0122 triggers
 * keep the table current from the day it lands, and 0122 enqueues a
 * 'document_keys' job for every document that already exists; each search
 * drains a few of those jobs for its tenant before it reads keys and, while any
 * remain, says so (`keys_pending`) and also judges the scoped documents
 * directly. This script drains the whole history at once so that fallback is
 * never needed.
 *
 * WHAT IT DOES
 *
 * For each document (all tenants, or --tenant): derives its keys with the SAME
 * pure function the portal uses (shared/searchKeys.ts#deriveSearchKeys, via the
 * bin/lib/shared/searchKeys.js mirror — `npm run build:worker-shared`), from
 * primary_metadata over extended_metadata (tables removed) and its linked lot
 * rows. With --apply, per document: delete its keys, insert the derived ones,
 * and complete its pending 'document_keys' job. Idempotent: a second run writes
 * the same rows.
 *
 * WHAT IT WILL NOT DO
 *   - Write anything without --apply.
 *   - Touch documents_fts, lots or documents.
 *
 * Usage:
 *   bin/backfill-search-keys                         # dry run, LOCAL, every tenant
 *   bin/backfill-search-keys --tenant <id>           # dry run, one tenant
 *   bin/backfill-search-keys --apply                 # LOCAL write
 *   bin/backfill-search-keys --remote                # dry run, PRODUCTION
 *   bin/backfill-search-keys --remote --apply        # prompts first
 *
 * Flags:
 *   --tenant ID     only this tenant
 *   --apply         actually write. Without it this is a dry run.
 *   --remote, -r    target PRODUCTION D1 (with --apply, asks you to type "backfill")
 *   --yes, -y       skip the production confirmation prompt
 *   --page-size N   D1 paging size (default 200)
 *   --json          emit the plan summary as JSON
 *   -h, --help      this help
 */

const fs = require('fs');
const os = require('os');
const path = require('path');
const { execFileSync } = require('child_process');

const { query, queryPaged, PROJECT_ROOT, DEFAULT_DB } = require('./lib/d1');
const { buildKeyPlan, planToSql } = require('./lib/searchKeysBackfill');

function parseArgs(argv) {
  const opts = { tenant: null, apply: false, remote: false, yes: false, pageSize: 200, json: false };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    switch (a) {
      case '--tenant': opts.tenant = argv[++i]; break;
      case '--apply': opts.apply = true; break;
      case '--remote':
      case '-r': opts.remote = true; break;
      case '--yes':
      case '-y': opts.yes = true; break;
      case '--page-size': opts.pageSize = Number(argv[++i]); break;
      case '--json': opts.json = true; break;
      case '-h':
      case '--help': printHelp(); process.exit(0); break;
      default:
        console.error(`Unknown argument: ${a}`);
        process.exit(2);
    }
  }
  if (opts.tenant && !/^[A-Za-z0-9_-]+$/.test(opts.tenant)) {
    console.error('--tenant must be an id: letters, digits, dashes, underscores.');
    process.exit(2);
  }
  return opts;
}

function printHelp() {
  const lines = fs.readFileSync(__filename, 'utf8').split('\n');
  const end = lines.findIndex((l, i) => i > 2 && l.trim() === '*/');
  console.log(lines.slice(3, end).join('\n').replace(/^ \* ?/gm, ''));
}

function hasTable(table, remote) {
  const rows = query(`SELECT COUNT(*) AS n FROM sqlite_master WHERE type = 'table' AND name = '${table}'`, { remote });
  return Number((rows || [])[0]?.n ?? 0) > 0;
}

function execSql(statements, remote, label) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'dox-search-keys-backfill-'));
  const file = path.join(dir, `${label}.sql`);
  fs.writeFileSync(file, `${statements.join('\n')}\n`, 'utf8');
  try {
    execFileSync(
      'npx',
      ['wrangler', 'd1', 'execute', DEFAULT_DB, remote ? '--remote' : '--local', `--file=${file}`],
      { cwd: PROJECT_ROOT, stdio: ['ignore', 'pipe', 'pipe'], maxBuffer: 64 * 1024 * 1024 }
    );
  } catch (err) {
    const stderr = err.stderr ? err.stderr.toString() : '';
    throw new Error(`Writing to D1 failed. The SQL is at ${file}\n${stderr || err.message}`);
  }
  fs.rmSync(dir, { recursive: true, force: true });
}

function promptSync(question) {
  process.stdout.write(question);
  let fd;
  try {
    fd = fs.openSync('/dev/tty', 'rs');
  } catch {
    console.error('\nNo terminal to confirm on. Re-run interactively, or pass --yes.');
    process.exit(1);
  }
  const buf = Buffer.alloc(256);
  let out = '';
  for (;;) {
    const n = fs.readSync(fd, buf, 0, buf.length, null);
    if (n === 0) break;
    out += buf.toString('utf8', 0, n);
    if (out.includes('\n')) break;
  }
  fs.closeSync(fd);
  return out.split('\n')[0];
}

function main() {
  const opts = parseArgs(process.argv.slice(2));
  const remote = opts.remote;
  const targetLabel = remote ? 'PRODUCTION' : 'local';
  const say = opts.json ? console.error : console.log;

  if (!hasTable('document_search_keys', remote)) {
    say(`The ${targetLabel} database has no document_search_keys table yet — apply migrations/0122_document_search_keys.sql first.`);
    process.exit(opts.apply ? 1 : 0);
  }

  const tenantWhere = opts.tenant ? `WHERE d.tenant_id = '${opts.tenant}'` : '';
  const { rows: docs, pages: docPages } = queryPaged(
    (limit, offset) =>
      `SELECT d.id, d.tenant_id, d.primary_metadata,
              CASE WHEN json_valid(d.extended_metadata) THEN json_remove(d.extended_metadata, '$.tables') END AS extended_lite
         FROM documents d ${tenantWhere}
        ORDER BY d.id LIMIT ${limit} OFFSET ${offset}`,
    { remote, pageSize: opts.pageSize }
  );
  const { rows: lots } = queryPaged(
    (limit, offset) =>
      `SELECT dl.document_id, l.id AS lot_id, l.lot_number, l.sub_lot_code, l.code_date, l.expiration_date
         FROM document_lots dl JOIN lots l ON l.id = dl.lot_id JOIN documents d ON d.id = dl.document_id
        ${tenantWhere}
        ORDER BY dl.document_id, l.id LIMIT ${limit} OFFSET ${offset}`,
    { remote, pageSize: opts.pageSize * 5 }
  );
  const existing = query(
    `SELECT COUNT(*) AS n FROM document_search_keys ${opts.tenant ? `WHERE tenant_id = '${opts.tenant}'` : ''}`,
    { remote }
  );
  const pendingJobs = query(
    `SELECT COUNT(*) AS n FROM search_reindex_jobs WHERE entity_kind = 'document_keys' AND status = 'pending' ${opts.tenant ? `AND tenant_id = '${opts.tenant}'` : ''}`,
    { remote }
  );

  const plan = buildKeyPlan(docs, lots);
  const summary = {
    target: targetLabel,
    tenant: opts.tenant ?? 'all',
    documents: docs.length,
    document_pages: docPages,
    documents_with_keys: plan.documentsWithKeys,
    keys: plan.keys.length,
    keys_now_stored: Number(existing[0]?.n ?? 0),
    by_kind: plan.byKind,
    ambiguous_date_keys: plan.ambiguous,
    pending_jobs: Number(pendingJobs[0]?.n ?? 0),
    applied: opts.apply,
  };
  if (opts.json) console.log(JSON.stringify(summary, null, 2));
  else {
    console.log('');
    console.log(`Search keys — ${targetLabel}${opts.tenant ? `, tenant ${opts.tenant}` : ', every tenant'}`);
    console.log(`  documents read           ${summary.documents} (${docPages} page(s))`);
    console.log(`  documents stating a key  ${summary.documents_with_keys}`);
    console.log(`  keys derived             ${summary.keys} (stored now: ${summary.keys_now_stored})`);
    console.log(`  ambiguous date readings  ${summary.ambiguous_date_keys} (each stored both ways)`);
    console.log(`  pending key jobs         ${summary.pending_jobs}`);
    for (const [k, n] of Object.entries(plan.byKind).sort((a, b) => b[1] - a[1])) console.log(`    ${k.padEnd(22)} ${n}`);
    console.log('');
  }

  if (!opts.apply) {
    say('DRY RUN — nothing written. Re-run with --apply to write.');
    return;
  }

  if (remote && !opts.yes) {
    const answer = promptSync(
      `\nAbout to WRITE ${plan.keys.length} search key(s) for ${docs.length} document(s) to PRODUCTION D1.\nType "backfill" to continue: `
    );
    if (answer.trim() !== 'backfill') {
      console.error('That did not match. Nothing was written.');
      process.exit(1);
    }
  }

  const batches = planToSql(plan);
  batches.forEach((b, i) => {
    execSql(b, remote, `search-keys-${i + 1}`);
    say(`  batch ${i + 1}/${batches.length} — ${b.length} statement(s)`);
  });
  say(`Wrote ${plan.keys.length} search key(s) for ${docs.length} document(s) in ${targetLabel} D1.`);
}

try {
  main();
} catch (err) {
  console.error(err instanceof Error ? err.stack : String(err));
  process.exit(1);
}

#!/usr/bin/env node
/* eslint-disable no-console */
/**
 * bin/fix-starter-pack-renewal-policy — give the document types a starter pack
 * seeded the renewal setting their names have always implied.
 *
 * THE GAP THIS CLOSES
 *
 * Migrations 0096 and 0097 gave `document_types` a renewal PERIOD and a renewal
 * POLICY, and backfilled the rows that existed the day they ran: a
 * specification sheet to three years, a Certificate of Analysis to 'none'
 * (a COA is superseded by the next lot's certificate; it has no cadence to be
 * late against). `POST /api/document-types` proposes the same values from the
 * name whenever a type is created through the API.
 *
 * The starter pack did not. It wrote `INSERT OR IGNORE INTO document_types
 * (id, tenant_id, name, slug, description, default_owner)` and named neither
 * renewal column, so every row it created took the migration defaults —
 * 'inherit' and NULL, which the resolver reads as "renews annually". A tenant
 * seeded AFTER the backfills therefore had a Certificate of Analysis that
 * renews every year: the exact "mail every COA owner about a certificate that
 * does not renew" failure the renewal design exists to prevent, and a
 * Specification Sheet on a one-year cadence instead of the scheme-defined
 * three.
 *
 * Both starter-pack paths now name the columns (functions/lib/starter-packs.ts
 * and bin/lib/starter-packs.mjs, through the one helper in
 * shared/renewalPeriod.ts). This pass is for the tenants already seeded.
 *
 * WHAT IT CORRECTS, AND WHAT IT REFUSES TO TOUCH
 *
 *   corrected   a row still holding BOTH migration defaults ('inherit' + NULL)
 *               whose name derives something else, with no audit row naming a
 *               renewal key. That is the starter pack's exact signature.
 *   skipped     a row already carrying a renewal setting somebody wrote. Never
 *               re-decided, whatever its name suggests.
 *   skipped     a row an audit row credits to a person (a `document_type_updated`
 *               whose `changes` named a renewal key, or a `document_type_created`
 *               that recorded one). An admin who chose 'inherit' for a COA on
 *               purpose keeps it.
 *
 * THE HONEST BOUND: `document_types` carries no `renewal_policy_updated_by`
 * stamp, and `updated_at` moves for every column, so the audit log is the only
 * evidence of a human decision. A person who set a value through some path that
 * wrote no audit row is indistinguishable from the default — which is why the
 * value itself is the first test, and why nothing outside the exact
 * migration-default signature is ever written. Every run prints this.
 *
 * Every correction is a PROPOSAL an admin can still change on the Document
 * Types screen; nothing here is re-derived at read time, and no document's
 * stored renewal decision (0097, frozen at approval) is touched.
 *
 * Usage:
 *   bin/fix-starter-pack-renewal-policy --all                      # dry run, LOCAL, every tenant
 *   bin/fix-starter-pack-renewal-policy --tenant <id>              # dry run, LOCAL
 *   bin/fix-starter-pack-renewal-policy --tenant <id> --remote     # dry run, PRODUCTION
 *   bin/fix-starter-pack-renewal-policy --tenant <id> --apply      # LOCAL write
 *   bin/fix-starter-pack-renewal-policy --tenant <id> --remote --apply   # prompts first
 *
 * Flags:
 *   --tenant ID     tenant to correct (required unless --all)
 *   --all           every tenant in the database (reporting only)
 *   --apply         actually write. Without it this is a dry run.
 *   --remote, -r    target PRODUCTION D1 (with --apply, asks you to type the tenant id)
 *   --yes, -y       skip the production confirmation prompt
 *   --json          emit the plan as JSON instead of prose
 *   -h, --help      this help
 */

const fs = require('fs');
const os = require('os');
const path = require('path');
const { execFileSync } = require('child_process');

const { query, PROJECT_ROOT, DEFAULT_DB } = require('./lib/d1');
const {
  planRenewalPolicyDrift,
  correctionToSql,
  auditNamesRenewal,
  SKIP_REASONS,
} = require('./lib/renewalPolicyDrift');

/** Audit actions whose details can record a renewal setting. */
const AUDIT_ACTIONS = ['document_type_created', 'document_type_updated'];

function parseArgs(argv) {
  const opts = { tenant: null, all: false, apply: false, remote: false, yes: false, json: false };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    switch (a) {
      case '--tenant': opts.tenant = argv[++i]; break;
      case '--all': opts.all = true; break;
      case '--apply': opts.apply = true; break;
      case '--remote':
      case '-r': opts.remote = true; break;
      case '--yes':
      case '-y': opts.yes = true; break;
      case '--json': opts.json = true; break;
      case '-h':
      case '--help': printHelp(); process.exit(0); break;
      default:
        console.error(`Unknown argument: ${a}`);
        process.exit(2);
    }
  }
  if (!opts.tenant && !opts.all) {
    console.error('--tenant <id> is required (or --all). Run with --help for usage.');
    process.exit(2);
  }
  if (opts.tenant && !/^[A-Za-z0-9_-]+$/.test(opts.tenant)) {
    console.error('--tenant must be an id: letters, digits, dashes, underscores.');
    process.exit(2);
  }
  if (opts.all && opts.apply) {
    // Writing every tenant at once removes the one moment where somebody reads
    // the plan for the tenant they meant. Apply is per tenant, always.
    console.error('--all is a reporting mode. Re-run with --tenant <id> --apply to write one tenant.');
    process.exit(2);
  }
  return opts;
}

function printHelp() {
  const lines = fs.readFileSync(__filename, 'utf8').split('\n');
  const end = lines.findIndex((l, i) => i > 2 && l.trim() === '*/');
  console.log(lines.slice(3, end).join('\n').replace(/^ \* ?/gm, ''));
}

function sqlStr(v) {
  if (v === null || v === undefined) return 'NULL';
  return `'${String(v).replace(/'/g, "''")}'`;
}

function hasColumn(table, column, remote) {
  const rows = query(
    `SELECT COUNT(*) AS n FROM pragma_table_info('${table}') WHERE name = '${column}'`,
    { remote },
  );
  return Number((rows || [])[0]?.n ?? 0) > 0;
}

function execSql(statements, remote, label) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'dox-renewal-policy-fix-'));
  const file = path.join(dir, `${label}.sql`);
  fs.writeFileSync(file, `${statements.join('\n')}\n`, 'utf8');
  try {
    execFileSync(
      'npx',
      ['wrangler', 'd1', 'execute', DEFAULT_DB, remote ? '--remote' : '--local', `--file=${file}`],
      { cwd: PROJECT_ROOT, stdio: ['ignore', 'pipe', 'pipe'], maxBuffer: 64 * 1024 * 1024 },
    );
  } catch (err) {
    const stderr = err.stderr ? err.stderr.toString() : '';
    throw new Error(`Writing to D1 failed. The SQL is at ${file}\n${stderr || err.message}`);
  }
  fs.rmSync(dir, { recursive: true, force: true });
}

function promptSync(question) {
  process.stdout.write(question);
  let fd;
  try {
    fd = fs.openSync('/dev/tty', 'rs');
  } catch {
    console.error('\nNo terminal to confirm on. Re-run interactively, or pass --yes.');
    process.exit(1);
  }
  const buf = Buffer.alloc(256);
  let out = '';
  for (;;) {
    const n = fs.readSync(fd, buf, 0, buf.length, null);
    if (n === 0) break;
    out += buf.toString('utf8', 0, n);
    if (out.includes('\n')) break;
  }
  fs.closeSync(fd);
  return out.split('\n')[0];
}

/** Read one tenant's types plus the audit evidence, and plan. */
function planTenant(tenantId, remote) {
  const types = query(
    `SELECT id, name, slug, active, renewal_policy, renewal_interval_months
       FROM document_types
      WHERE tenant_id = ${sqlStr(tenantId)}
      ORDER BY name`,
    { remote },
  );

  // One read for the whole tenant. A document type with any audit row naming a
  // renewal key was decided by a person and is left alone.
  const audits = query(
    `SELECT resource_id AS id, details
       FROM audit_log
      WHERE tenant_id = ${sqlStr(tenantId)}
        AND resource_type = 'document_type'
        AND action IN (${AUDIT_ACTIONS.map(sqlStr).join(',')})
        AND resource_id IS NOT NULL
        AND details IS NOT NULL`,
    { remote },
  );
  const decided = new Set();
  for (const a of audits) {
    if (auditNamesRenewal(a.details)) decided.add(a.id);
  }

  const plan = planRenewalPolicyDrift(
    types.map((t) => ({ ...t, human_decided: decided.has(t.id) })),
  );
  return { tenantId, ...plan, audited: decided.size };
}

function describe(setting) {
  if (setting.policy === 'none') return 'does not renew';
  if (setting.policy === 'period') {
    return setting.interval_months === null
      ? 'period (no months set)'
      : `every ${setting.interval_months} months`;
  }
  return 'annual (the default)';
}

function formatPlan(plan, label) {
  const lines = [];
  lines.push('');
  lines.push(`Starter-pack renewal policy — ${label}`);
  lines.push(`  document types:              ${plan.total}`);
  lines.push(`  already correct:             ${plan.agree}`);
  lines.push(`  would be corrected:          ${plan.corrections.length}`);
  lines.push(`  left alone:                  ${plan.skipped.length}`);
  lines.push('');
  if (plan.corrections.length) {
    lines.push('  CORRECT (still at the migration defaults, no human on record)');
    for (const c of plan.corrections) {
      lines.push(
        `    ${c.name}` +
        `\n      from  ${c.from.policy} / ${c.from.interval_months === null ? 'NULL' : c.from.interval_months}  (${describe(c.from)})` +
        `\n      to    ${c.to.policy} / ${c.to.interval_months === null ? 'NULL' : c.to.interval_months}  (${describe(c.to)})` +
        `\n      id    ${c.id}`,
      );
    }
    lines.push('');
  }
  if (plan.skipped.length) {
    lines.push('  LEFT ALONE');
    for (const s of plan.skipped) {
      lines.push(
        `    ${s.name} — ${SKIP_REASONS[s.reason]}` +
        ` (stored ${s.from.policy} / ${s.from.interval_months === null ? 'NULL' : s.from.interval_months},` +
        ` name implies ${s.to.policy} / ${s.to.interval_months === null ? 'NULL' : s.to.interval_months})`,
      );
    }
    lines.push('');
  }
  return lines;
}

function main() {
  const opts = parseArgs(process.argv.slice(2));
  const remote = opts.remote;
  const targetLabel = remote ? 'PRODUCTION' : 'local';

  if (!hasColumn('document_types', 'renewal_policy', remote)) {
    console.error(
      'This database predates migration 0097 — there is no renewal_policy column.\n' +
      'Apply migrations/0097_renewal_policy_and_decision.sql on the target first.',
    );
    process.exit(1);
  }

  const tenants = opts.all
    ? query('SELECT id, name FROM tenants ORDER BY name', { remote })
    : query(`SELECT id, name FROM tenants WHERE id = ${sqlStr(opts.tenant)}`, { remote });

  if (tenants.length === 0) {
    console.error(
      opts.all
        ? 'No tenants in this database. Check the --remote flag.'
        : `No tenant "${opts.tenant}" in this database. Check the id, or the --remote flag.`,
    );
    process.exit(1);
  }

  const plans = tenants.map((t) => ({ tenant: t, plan: planTenant(t.id, remote) }));

  if (opts.json) {
    console.log(JSON.stringify({
      target: targetLabel,
      applied: opts.apply,
      tenants: plans.map(({ tenant, plan }) => ({
        id: tenant.id,
        name: tenant.name,
        total: plan.total,
        agree: plan.agree,
        corrections: plan.corrections,
        skipped: plan.skipped,
      })),
    }, null, 2));
  } else {
    for (const { tenant, plan } of plans) {
      for (const line of formatPlan(plan, `${tenant.name} (${tenant.id}), ${targetLabel}`)) {
        console.log(line);
      }
    }
    console.log(
      '  How a decision is told from a default: the stored value (anything other\n' +
      "  than 'inherit' + NULL was written by somebody and is never re-decided)\n" +
      '  plus audit rows naming a renewal key. There is no per-column stamp, so a\n' +
      '  value written with no audit trail cannot be distinguished from the\n' +
      '  migration default — only the exact default signature is ever corrected.',
    );
    console.log('');
  }

  const statements = plans.flatMap(({ tenant, plan }) =>
    plan.corrections.map((c) => correctionToSql(tenant.id, c, sqlStr)),
  );

  if (!opts.apply) {
    if (!opts.json) {
      console.log(
        statements.length === 0
          ? 'DRY RUN — nothing to correct.'
          : `DRY RUN — ${statements.length} document type(s) not written. Re-run with --apply to write.`,
      );
      console.log('');
    }
    return;
  }

  if (statements.length === 0) {
    console.log('Nothing to do — every document type already agrees with its name, or was decided by a person.');
    return;
  }

  if (remote && !opts.yes) {
    const answer = promptSync(
      `\nAbout to WRITE to PRODUCTION D1 for tenant ${opts.tenant}:\n` +
      `  ${statements.length} document type renewal setting(s)\n` +
      'Type the tenant id to continue: ',
    );
    if (answer.trim() !== opts.tenant) {
      console.error('That did not match. Nothing was written.');
      process.exit(1);
    }
  }

  execSql(statements, remote, 'renewal-policy-fix');
  console.log('');
  console.log(`Wrote ${statements.length} document type renewal setting(s) in ${targetLabel} D1.`);
  console.log('Re-run without --apply to confirm it now reports nothing to correct.');
  console.log('');
}

try {
  main();
} catch (err) {
  console.error(err instanceof Error ? err.stack : String(err));
  process.exit(1);
}

#!/usr/bin/env node

/**
 * Dox Document Process Worker
 *
 * Polls the dox API for queued documents, extracts text, calls Qwen for field
 * extraction, and posts results back. Runs locally as a daemon — no CF Worker
 * time limits.
 *
 * Config (environment variables):
 *   DOX_API_URL   — defaults to https://supdox.com
 *   DOX_API_KEY   — required, API key for auth (X-API-Key header)
 *   QWEN_URL      — defaults to http://127.0.0.1:9600
 *   QWEN_SECRET   — optional, Bearer token for Qwen auth proxy
 *   POLL_INTERVAL  — defaults to 3000 (ms)
 */

const { execFileSync } = require('child_process');
const os = require('os');
const path = require('path');
const fs = require('fs');
const { Agent } = require('undici');
const {
  chainFor,
  resolveModel,
  invalidateModelCache,
  noteServedModel,
  isModelUnavailableError,
} = require('./lib/models');
// Shared order/shipment extraction prompt + parse logic. This is a CJS bundle
// transpiled from shared/orderPrompt.ts (+ its pure deps fieldMappings.ts /
// connectorOutput.ts) by `npm run build:worker-shared` — the SAME source the
// Cloudflare connector pipeline (functions/lib/connectors/email.ts) imports,
// so the order-extraction prompt + normalization are byte-identical across
// both surfaces. The bin/process-worker-start scripts regenerate it before
// launch; it is also committed so the systemd unit (which runs `node
// bin/process-worker` directly) finds it without a build step.
const {
  buildParsingPrompt,
  prependConnectorInstructions,
  mergeOutputs,
  normalizeAiOutput,
  clampConfidence,
  getDefaultParsingPrompt,
} = require('./lib/shared/orderPrompt');
// Deterministic CSV field-mapping parser — the SAME code the CF connector
// pipeline uses to turn a delimited file + field_mappings into the canonical
// {orders, customers} record shape, no LLM involved. Used by the order path
// when the profile carries field_mappings and the input is CSV/TSV-shaped.
const { parseCSVAttachment } = require('./lib/shared/orderParse');
// Deterministic multi-record COA assembly (first-class multi-product /
// multi-lot / multi-page COAs — see coa-multi-record.md). The LLM extracts
// per-chunk; this module assembles every chunk's records into one
// CoaRecordsPayload across chunk boundaries (the LLM is blind across chunks).
// Used in shadow mode by processCoaItem; gated by COA_RECORDS_MODE.
const { mergeCoaRecords } = require('./lib/coaRecords');

// Increase headers timeout for slow LLM inference (default is 300s, we need 15min)
const llmDispatcher = new Agent({
  headersTimeout: 900_000,   // 15 minutes
  bodyTimeout: 900_000,      // 15 minutes
  connectTimeout: 30_000,    // 30 seconds
});

const DOX_API_URL = (process.env.DOX_API_URL || 'https://supdox.com').replace(/\/+$/, '');
const DOX_API_KEY = process.env.DOX_API_KEY || '';
const QWEN_URL = (process.env.QWEN_URL || 'http://127.0.0.1:9600').replace(/\/+$/, '');
const QWEN_SECRET = process.env.QWEN_SECRET || '';
const POLL_INTERVAL = parseInt(process.env.POLL_INTERVAL || '30000', 10);

// === VLM (Vision-Language Model) dual-run config ===
// Modes:
//   'off'  (default) — text path only, no VLM call, no vlm_ columns populated.
//   'dual'           — run text path AND VLM path. Text result is primary
//                      (writes to extracted_text/ai_fields/tables/etc).
//                      VLM result is saved to the vlm_ columns for comparison.
//   'vlm'            — run ONLY the VLM path. VLM result is primary.
//                      On VLM failure, fall back to text path.
// The VLM model is chosen by the `vision` PREFERENCE CHAIN (bin/lib/models.js
// MODEL_CHAINS.vision), resolved against what the router actually advertises —
// health-aware exactly like the text tags. This used to be a hardcoded default
// and was the last place a model name was pinned outside the config.
//
// QWEN_VLM_MODEL still PINS an exact model and bypasses chain resolution (the
// documented override behavior). It is expressed below as the tag's standard
// QWEN_MODEL_VISION override so the resolver reports source='override' and the
// preflight banner says PINNED, same as every other tag.
const QWEN_VLM_MODE = (process.env.QWEN_VLM_MODE || 'off').toLowerCase();
const QWEN_VLM_MODEL_PIN = (process.env.QWEN_VLM_MODEL || '').trim();
const VLM_ENV = QWEN_VLM_MODEL_PIN
  ? { ...process.env, QWEN_MODEL_VISION: QWEN_VLM_MODEL_PIN }
  : process.env;
const QWEN_VLM_MAX_PAGES = parseInt(process.env.QWEN_VLM_MAX_PAGES || '5', 10);

// The vision model requested for — and, once the router answers, ACTUALLY
// served on — the most recent VLM call, including quantization. Mirrors
// lastServedTextModel; posted as result_body.vlm_model so every VLM run is
// self-describing. Reset per call so a failure never reports a stale name.
let lastVlmModel = null;

/**
 * Resolve the vision tag to a model that is up right now. Throws (loudly,
 * naming the chain and the router) only when NOTHING in the vision chain has
 * a healthy upstream — callers of the VLM path already fall back to text.
 */
async function pickVlmModel(opts) {
  const res = await resolveModel('vision', VLM_ENV, opts);
  return res.model;
}

// === Multi-record COA mode (first-class multi-product / multi-lot / multi-page) ===
//   off    — never compute/post ai_records on the COA path (byte-identical to
//            pre-feature behavior). Default.
//   shadow — ALSO compute mergeCoaRecords() and post ai_records ALONGSIDE the
//            flat ai_fields when the doc genuinely carries >= 2 records, so we
//            can eyeball splits on real docs without any review/approve change.
//   on     — same posting behavior as shadow in P1 (the review/approve wiring
//            that consumes ai_records is P3/P4).
// In all modes, single-record COAs post EXACTLY as today (flat ai_fields, no
// ai_records) so the common case is unchanged.
const COA_RECORDS_MODE = (process.env.COA_RECORDS_MODE || 'off').toLowerCase();

// === Multi-page text-chunking config ===
// Multi-page PDFs feed an array of page strings into a chunker that builds
// soft-capped Qwen calls so pages 3+ aren't silently dropped (see Darigold
// COA bug, 2026-05-21).
//   TEXT_CHUNK_CHAR_LIMIT — soft target per Qwen call. Sized to leave room
//     for prompt + few-shot examples within the 8B model's context budget.
//   TEXT_MAX_CHUNKS       — hard cap on chunks per doc. Intentionally lower
//     than the connector's MAX_CHUNKS_PER_ATTACHMENT (20) because each Qwen
//     call here risks a cold-start 502 from the GPU host (see today's
//     Darigold/76187 errors); the more calls, the more cold-start exposure.
//     If a doc would require more chunks than this cap, the worker falls
//     back to a single truncated call (legacy behavior) with a warning.
const TEXT_CHUNK_CHAR_LIMIT = 24000;
const TEXT_MAX_CHUNKS = 6;

// === Per-page COA chunking config ===
// A multi-page COA PDF is N independent single-page COAs bundled by PO/EDI
// order number — each page is literally "Page 1 of 1", a self-sufficient COA
// with its own full header (supplier, item#, lot#, plant, date). So the COA
// text path splits ONE CHUNK PER PAGE (never grouped) and runs one Qwen call
// per page: each call sees exactly one page = one product, and pages are never
// merged across LLM calls. This fixes the v1 collapse bug where all pages were
// stuffed into ≤6 grouped chunks and the model returned only ONE product,
// dropping the rest (a real 7-page bundle kept 1 of 7).
//   TEXT_MAX_PAGES_COA — hard cap on per-page COA calls. A bundle can legitimately
//     have many pages (validated example: 7). Requests are small + fast on the
//     current GPU, so this is generous. If a doc somehow exceeds it, we process
//     the first N pages and LOG that pages were dropped (never silently truncate).
const TEXT_MAX_PAGES_COA = 40;

if (!['off', 'dual', 'vlm'].includes(QWEN_VLM_MODE)) {
  console.error(`Error: QWEN_VLM_MODE must be one of: off, dual, vlm (got "${QWEN_VLM_MODE}")`);
  process.exit(1);
}

if (!DOX_API_KEY) {
  console.error('Error: DOX_API_KEY environment variable is required');
  console.error('Create an API key in dox admin, then set DOX_API_KEY=dox_sk_...');
  process.exit(1);
}

const headers = {
  'X-API-Key': DOX_API_KEY,
  'Content-Type': 'application/json',
};

let processing = false;

async function poll() {
  if (processing) return true; // skip if still working on previous batch — not a failure
  processing = true;

  let ok = true;
  try {
    // Reset stale "processing" items (stuck for >10 min)
    try {
      const staleRes = await fetch(
        `${DOX_API_URL}/api/queue?processing_status=processing&limit=10&status=all`,
        { headers }
      );
      if (staleRes.ok) {
        const staleData = await staleRes.json();
        for (const item of (staleData.items || [])) {
          const updatedAt = new Date(item.created_at).getTime();
          if (Date.now() - updatedAt > 10 * 60 * 1000) {
            console.log(`Resetting stale item: ${item.file_name} (${item.id})`);
            await postResults(item.id, { processing_status: 'queued', error_message: null });
          }
        }
      }
    } catch (err) {
      console.warn('Staleness check failed:', err.message);
    }

    const res = await fetch(
      `${DOX_API_URL}/api/queue?processing_status=queued&limit=1&status=all`,
      { headers }
    );

    if (!res.ok) {
      const text = await res.text().catch(() => '');
      console.error(`Poll failed: ${res.status} ${text.substring(0, 200)}`);
      return false;
    }

    const data = await res.json();
    const items = data.items || [];

    for (const item of items) {
      await processItem(item);
    }
  } catch (err) {
    console.error('Poll error:', err.message);
    ok = false;
  } finally {
    processing = false;
  }
  return ok;
}

async function postResults(id, body) {
  const res = await fetch(`${DOX_API_URL}/api/queue/${id}/results`, {
    method: 'PUT',
    headers,
    body: JSON.stringify(body),
  });
  if (!res.ok) {
    const text = await res.text().catch(() => '');
    console.error(`Failed to post results for ${id}: ${res.status} ${text.substring(0, 200)}`);
  }
}

/**
 * OCR fallback for scanned/image-based PDFs.
 * Uses pdftoppm (poppler) to render pages as images, then tesseract for OCR.
 * Returns extracted text or null if tools aren't available.
 */
function ocrPdf(pdfBuffer) {
  // Check that required tools exist
  try {
    execFileSync('which', ['pdftoppm'], { stdio: 'pipe' });
    execFileSync('which', ['tesseract'], { stdio: 'pipe' });
  } catch {
    console.warn('  OCR unavailable: pdftoppm or tesseract not installed');
    return null;
  }

  const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'dox-ocr-'));
  try {
    const pdfPath = path.join(tmpDir, 'input.pdf');
    fs.writeFileSync(pdfPath, Buffer.from(pdfBuffer));

    // Render PDF pages to grayscale PGM images at 300 DPI
    execFileSync('pdftoppm', ['-gray', '-r', '300', pdfPath, path.join(tmpDir, 'page')], {
      timeout: 30_000,
      stdio: 'pipe',
    });

    // Find generated page images and OCR each
    const pageFiles = fs.readdirSync(tmpDir)
      .filter(f => f.startsWith('page') && (f.endsWith('.pgm') || f.endsWith('.ppm')))
      .sort();

    if (pageFiles.length === 0) {
      console.warn('  OCR: pdftoppm produced no images');
      return null;
    }

    const texts = [];
    for (const pageFile of pageFiles) {
      try {
        const pagePath = path.join(tmpDir, pageFile);

        // Auto-rotate page if needed
        detectAndRotateImage(pagePath);

        // --psm 1 = auto page segmentation with OSD (handles rotated pages)
        const result = execFileSync('tesseract', [
          pagePath, 'stdout', '--psm', '1'
        ], { timeout: 60_000, stdio: ['pipe', 'pipe', 'pipe'] });
        texts.push(result.toString('utf-8'));
      } catch (err) {
        console.warn(`  OCR: tesseract failed on ${pageFile}: ${err.message}`);
      }
    }

    const combined = texts.join('\n\n').trim();
    return combined.length > 0 ? combined : null;
  } finally {
    // Clean up temp files
    try {
      for (const f of fs.readdirSync(tmpDir)) {
        fs.unlinkSync(path.join(tmpDir, f));
      }
      fs.rmdirSync(tmpDir);
    } catch { /* best-effort cleanup */ }
  }
}

/**
 * Detect orientation of an image using tesseract OSD and rotate if needed.
 * Uses ImageMagick (convert or magick) for rotation.
 * Returns the rotation angle applied (0 if none).
 */
function detectAndRotateImage(imagePath) {
  try {
    // --psm 0 = orientation and script detection only
    const osdOutput = execFileSync('tesseract', [
      imagePath, 'stdout', '--psm', '0'
    ], { timeout: 30_000, stdio: ['pipe', 'pipe', 'pipe'] }).toString('utf-8');

    // Parse rotation angle from OSD output
    // Output looks like: "Rotate: 90" or "Orientation in degrees: 90"
    const rotateMatch = osdOutput.match(/Rotate:\s*(\d+)/i) ||
                        osdOutput.match(/Orientation in degrees:\s*(\d+)/i);
    const rotation = rotateMatch ? parseInt(rotateMatch[1], 10) : 0;

    if (rotation > 0 && rotation !== 360) {
      console.log(`  Detected rotation: ${rotation}° — auto-correcting`);
      // Use ImageMagick to rotate
      try {
        execFileSync('convert', [imagePath, '-rotate', String(rotation), imagePath], {
          timeout: 30_000,
          stdio: 'pipe',
        });
        return rotation;
      } catch (err) {
        // Try 'magick' command (ImageMagick v7)
        try {
          execFileSync('magick', [imagePath, '-rotate', String(rotation), imagePath], {
            timeout: 30_000,
            stdio: 'pipe',
          });
          return rotation;
        } catch {
          console.warn(`  ImageMagick not available, skipping rotation`);
        }
      }
    }
    return 0;
  } catch (err) {
    // OSD detection failed (common with non-text images)
    return 0;
  }
}

async function fetchExtractionExamples(tenantId, documentTypeId, supplier) {
  const params = new URLSearchParams();
  if (documentTypeId) params.set('document_type_id', documentTypeId);
  if (tenantId) params.set('tenant_id', tenantId);

  try {
    const res = await fetch(
      `${DOX_API_URL}/api/extraction-examples?${params.toString()}&limit=5`,
      { headers }
    );
    if (!res.ok) return [];
    const data = await res.json();
    let examples = data.examples || [];

    // Prefer examples from same supplier
    if (supplier) {
      const supplierExamples = examples.filter(e =>
        e.supplier && e.supplier.toLowerCase().includes(supplier.toLowerCase())
      );
      if (supplierExamples.length > 0) {
        examples = supplierExamples;
      }
    }

    // Return top 3 by score (highest corrections first)
    return examples
      .sort((a, b) => (b.score || 0) - (a.score || 0))
      .slice(0, 3);
  } catch {
    return [];
  }
}

/**
 * Look up a supplier_id by name (exact, case-insensitive) via the dox API.
 * Returns null if no match is found or the call fails. This is a best-effort
 * resolver — used to map `item.supplier` (which is a free-form name) to a
 * real suppliers.id so we can query the reviewer instructions table. We
 * never CREATE a supplier from the worker; if one doesn't exist there can't
 * be instructions for it yet anyway.
 */
async function resolveSupplierIdByName(tenantId, name) {
  if (!name || !tenantId) return null;
  try {
    const params = new URLSearchParams({
      tenant_id: tenantId,
      search: name,
      active: '1',
      limit: '10',
    });
    const res = await fetch(
      `${DOX_API_URL}/api/suppliers?${params.toString()}`,
      { headers }
    );
    if (!res.ok) return null;
    const data = await res.json();
    const rows = data.suppliers || [];
    if (rows.length === 0) return null;

    // Normalize for matching: lowercase, strip punctuation, drop common
    // company suffixes (Inc/LLC/Co/Corp/Ltd/Company), collapse whitespace.
    // A queue item often carries "Darigold Inc." while the supplier row is
    // just "Darigold"; without this they never match and instructions are
    // silently skipped.
    const normalize = (s) =>
      (s || '')
        .toLowerCase()
        .replace(/[.,&]/g, ' ')
        .replace(/\b(inc|llc|co|corp|corporation|ltd|limited|company|incorporated)\b/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();

    const target = normalize(name);
    if (!target) return null;

    // 1. Exact normalized match — preferred.
    const exact = rows.find(s => normalize(s.name) === target);
    if (exact) return exact.id;

    // 2. Normalized containment either direction ("Anderson" vs "Anderson
    //    Dairy"). Only accept when a single candidate matches so we never
    //    guess between two plausible suppliers.
    const contains = rows.filter(s => {
      const n = normalize(s.name);
      return n && (n.includes(target) || target.includes(n));
    });
    if (contains.length === 1) return contains[0].id;

    return null;
  } catch {
    return null;
  }
}

/**
 * Fetch the reviewer-authored natural-language extraction instructions for a
 * (supplier_id, document_type_id) pair, if any exist. Returns an empty string
 * when the API returns null (no guidance yet), the call fails, or either ID
 * is missing. Never throws — this is a best-effort enhancement and must not
 * block extraction.
 *
 * See migration 0035_supplier_extraction_instructions.sql for the table
 * schema. The text gets prepended to both the text and VLM system prompts
 * via prependReviewerInstructions() below.
 */
async function fetchReviewerInstructions(tenantId, supplierId, documentTypeId) {
  if (!supplierId) return '';
  try {
    const params = new URLSearchParams({ supplier_id: supplierId });
    // document_type_id is optional: the queue item's doctype is usually still
    // null at extraction time (it's promoted AFTER the LLM call). When it's
    // missing we omit the param and the API returns the supplier's guidance
    // aggregated across doctypes; when known we pass it for an exact match.
    if (documentTypeId) params.set('document_type_id', documentTypeId);
    // super_admin path needs tenant_id on the query string. Worker auths as
    // whichever user owns the API key, which in staging/prod is super_admin.
    if (tenantId) params.set('tenant_id', tenantId);
    const res = await fetch(
      `${DOX_API_URL}/api/extraction-instructions?${params.toString()}`,
      { headers }
    );
    if (!res.ok) return '';
    const data = await res.json();
    return (data && typeof data.instructions === 'string') ? data.instructions : '';
  } catch {
    return '';
  }
}

/**
 * Fetch the tenant's editable extraction context (the "industry layer" / dairy
 * brain). When a tenant has set one, it replaces the hardcoded
 * DAIRY_FOOD_INDUSTRY_PROMPT default in the assembled system prompt; when unset
 * (null / empty), the caller falls back to the default. Non-fatal — returns
 * null on miss or any error, never throws (mirrors fetchReviewerInstructions).
 *
 * See migration 0072_tenant_extraction_context.sql + /api/tenant-extraction-context.
 */
async function fetchTenantContext(tenantId) {
  if (!tenantId) return null;
  try {
    const params = new URLSearchParams({ tenant_id: tenantId });
    const res = await fetch(
      `${DOX_API_URL}/api/tenant-extraction-context?${params.toString()}`,
      { headers }
    );
    if (!res.ok) return null;
    const data = await res.json();
    return (data && typeof data.extraction_context === 'string') ? data.extraction_context : null;
  } catch {
    return null;
  }
}

/**
 * Fetch the Phase 3 learned preferences for a (supplier, doctype) pair, if
 * any exist. Returns null on missing inputs / failure / no signal — never
 * throws. The worker uses this for two things:
 *   1. Build a `learned_field_hints` sidecar in the result payload that the
 *      UI uses to pre-fill fields.
 *   2. Append a short attention-bias line to the system prompt so the model
 *      pays extra attention to fields where past reviewers consistently
 *      chose one source over the other.
 */
async function fetchLearnedPreferences(tenantId, supplierId, documentTypeId) {
  if (!tenantId || !supplierId || !documentTypeId) return null;
  try {
    const params = new URLSearchParams({
      supplier_id: supplierId,
      document_type_id: documentTypeId,
      tenant_id: tenantId,
    });
    const res = await fetch(
      `${DOX_API_URL}/api/learned-preferences?${params.toString()}`,
      { headers }
    );
    if (!res.ok) return null;
    const data = await res.json();
    if (!data || !data.fields) return null;
    return data;
  } catch {
    return null;
  }
}

/**
 * Build the `learned_field_hints` sidecar from the aggregator output. Only
 * fields with confidence >= 0.8 graduate into the hint payload — below that,
 * the signal is too noisy to bother the reviewer with a pre-fill badge.
 * Shape matches the LearnedFieldPreference type in shared/types.ts.
 */
function buildLearnedFieldHints(preferences) {
  if (!preferences || !preferences.fields) return null;
  const hints = {};
  for (const [fieldKey, pref] of Object.entries(preferences.fields)) {
    if (typeof pref?.confidence !== 'number' || pref.confidence < 0.8) continue;
    hints[fieldKey] = {
      preferred_source: pref.preferred_source,
      suggested_value: pref.most_common_value ?? null,
      confidence: pref.confidence,
      pick_count: pref.pick_count,
    };
  }
  return Object.keys(hints).length > 0 ? hints : null;
}

/**
 * Prepend the Phase 3 attention-bias line to the system prompt. Tells the
 * model that past reviewers consistently picked a particular source for
 * a list of fields — pure attention bias, NOT a hard "always pick X" rule
 * (the model still sees the document and can disagree).
 */
function prependAttentionBias(prompt, preferences) {
  if (!preferences || !preferences.fields) return prompt;
  const fieldsBySource = { text: [], vlm: [] };
  for (const [fieldKey, pref] of Object.entries(preferences.fields)) {
    if (typeof pref?.confidence !== 'number' || pref.confidence < 0.8) continue;
    if (pref.preferred_source === 'text' || pref.preferred_source === 'vlm') {
      fieldsBySource[pref.preferred_source].push(fieldKey);
    }
  }
  const lines = [];
  for (const src of ['text', 'vlm']) {
    if (fieldsBySource[src].length > 0) {
      lines.push(
        `Past reviewers consistently chose ${src.toUpperCase()} for the following fields: ${fieldsBySource[src].join(', ')}. Pay extra attention to extracting those correctly.`
      );
    }
  }
  if (lines.length === 0) return prompt;
  return lines.join('\n') + '\n\n' + prompt;
}

/**
 * Heuristic per-field uncertainty score in [0, 1]. Higher = needs reviewer
 * eyes. Dumb on purpose for now — empty / suspicious-looking values bump up,
 * dual-mode disagreement gets layered on top later.
 */
function computeFieldUncertainty(fieldKey, value) {
  if (value == null) return 1.0;
  const s = String(value).trim();
  if (s === '') return 1.0;
  if (s.includes('(?)') || s === '?') return 0.7;
  if (/lot/i.test(fieldKey) && s.length < 3) return 0.6;
  if (/date/i.test(fieldKey)) {
    const looksLikeDate = /\d{4}-\d{2}-\d{2}/.test(s) || /\d{1,2}\/\d{1,2}\/\d{2,4}/.test(s);
    if (!looksLikeDate) return 0.7;
  }
  if ((/number|code|qty|count|weight/i.test(fieldKey)) && /^[A-Za-z]+$/.test(s)) return 0.7;
  return 0.2;
}

/**
 * Build a Record<field_key, 0..1> uncertainty payload for ALL keys present
 * on either side of a dual extraction. When text and VLM disagree on a key,
 * that key's uncertainty is forced to max(current, 0.7) — disagreement IS
 * uncertainty. In single-side mode (one of textFields/vlmFields is empty),
 * just runs the per-field heuristic on the side that ran.
 */
function computeUncertaintyPayload(textFields, vlmFields) {
  const text = textFields || {};
  const vlm = vlmFields || {};
  const allKeys = new Set([...Object.keys(text), ...Object.keys(vlm)]);
  const out = {};
  for (const key of allKeys) {
    const tVal = text[key];
    const vVal = vlm[key];
    // Prefer the value the reviewer would see (text first, vlm fallback)
    // when running the heuristic.
    const seedValue = tVal != null ? tVal : vVal;
    let score = computeFieldUncertainty(key, seedValue);
    // Dual-mode disagreement: both sides extracted SOMETHING but they differ.
    const hasText = tVal != null && String(tVal).trim() !== '';
    const hasVlm = vVal != null && String(vVal).trim() !== '';
    if (hasText && hasVlm && String(tVal).trim() !== String(vVal).trim()) {
      score = Math.max(score, 0.7);
    }
    out[key] = score;
  }
  return out;
}

/**
 * Prepend the reviewer-authored guidance to a Qwen system prompt.
 * No-op when `instructions` is empty. The header matches the one spec'd in
 * the feature brief so future tweaks live in exactly one place.
 */
function prependReviewerInstructions(prompt, instructions) {
  if (!instructions || !instructions.trim()) return prompt;
  const header = [
    '## Reviewer instructions',
    'The following guidance comes from human reviewers of past documents from this supplier and document type. Follow it carefully:',
    '',
    instructions.trim(),
    '',
    '---',
    '',
  ].join('\n');
  return header + prompt;
}

/**
 * Prepend a strict <filename_hint> block to the system prompt. The filename
 * is provided ONLY so the model can guess the supplier from familiar prefixes —
 * it is NOT a source of structured field values. Fields like lot_number /
 * code_date / etc. that bleed in from the filename poison downstream data
 * (see Pacific Cheese smoking gun, Apr 2026 A/B eval).
 */
function prependFilenameHint(prompt, fileName) {
  if (!fileName) return prompt;
  const block = [
    '<filename_hint>',
    fileName,
    '</filename_hint>',
    '',
    'The filename above is provided ONLY for supplier identification context.',
    'NEVER extract lot_number, code_date, production_date, expiration_date, product_code, or sub_lot_number from this filename.',
    "If those values aren't in the document body, return null.",
    '',
    '---',
    '',
  ].join('\n');
  return block + prompt;
}

/**
 * Drop keys whose values are null, undefined, empty, or whitespace-only. The
 * VLM model in particular emits null padding for every canonical field it
 * doesn't see; carrying those nulls downstream makes the compare panel render
 * "12 fields vs 4" when the real signal is 4 vs 4.
 */
function compactFields(rec) {
  if (!rec || typeof rec !== 'object') return {};
  const out = {};
  for (const [k, v] of Object.entries(rec)) {
    if (v == null) continue;
    if (typeof v === 'string' && v.trim() === '') continue;
    out[k] = v;
  }
  return out;
}

/**
 * Split a block of text into chunks of at most `limit` chars, preserving
 * row (newline) boundaries. Any single row longer than `limit` is emitted
 * on its own — we don't break mid-row because that corrupts the model's
 * view of tabular data. Mirrors the helper in
 * functions/lib/connectors/email.ts.
 */
function chunkByRows(text, limit) {
  const rows = text.split('\n');
  const chunks = [];
  let buf = '';
  for (const row of rows) {
    if (buf.length + row.length + 1 > limit && buf.length > 0) {
      chunks.push(buf);
      buf = '';
    }
    buf = buf.length === 0 ? row : `${buf}\n${row}`;
  }
  if (buf.length > 0) chunks.push(buf);
  return chunks;
}

/**
 * Accumulate per-page text into Qwen-sized chunks. Each emitted chunk is the
 * concatenation of one or more whole pages prefixed with a `=== PAGE N ===`
 * banner so the model sees page boundaries even inside a chunk (COA
 * extraction benefits from this — multi-page COAs are frequently one product
 * per page). Pages larger than `TEXT_CHUNK_CHAR_LIMIT` are split row-by-row.
 *
 * Returns an array of chunk strings. Whitespace-only chunks are dropped.
 */
function buildPageChunks(pages) {
  const chunks = [];
  let buf = '';

  const flush = () => {
    if (buf.trim()) chunks.push(buf);
    buf = '';
  };

  for (let i = 0; i < pages.length; i++) {
    const pageNum = i + 1;
    const page = pages[i] || '';
    if (!page.trim()) continue;

    const banner = `=== PAGE ${pageNum} ===\n\n`;
    const block = banner + page;

    // Oversized single page: flush current buf, then emit row-chunks (each
    // sub-chunk gets its own page banner so the model still knows where it is).
    if (block.length > TEXT_CHUNK_CHAR_LIMIT) {
      flush();
      const subChunks = chunkByRows(page, TEXT_CHUNK_CHAR_LIMIT - banner.length);
      for (const sub of subChunks) {
        chunks.push(banner + sub);
      }
      continue;
    }

    // Normal path: accumulate. Flush first if adding this page would overflow.
    if (buf.length + block.length + 2 > TEXT_CHUNK_CHAR_LIMIT && buf.length > 0) {
      flush();
    }
    buf = buf.length === 0 ? block : `${buf}\n\n${block}`;
  }
  flush();

  return chunks;
}

/**
 * Build ONE chunk per PAGE for the COA path. Unlike buildPageChunks (which
 * GROUPS pages into ≤TEXT_CHUNK_CHAR_LIMIT chunks — the v1 collapse bug), this
 * never merges pages: each page becomes its own Qwen call so the model sees
 * exactly one single-page COA = one product.
 *
 * Each returned entry is `{ chunk, page }` where `page` is the 1-based page
 * number. A page whose text exceeds TEXT_CHUNK_CHAR_LIMIT is sub-chunked
 * row-by-row, but EVERY sub-chunk is tagged with the SAME page number so the
 * assembler recombines them into that one page's product (a page is never split
 * into two products). Whitespace-only pages are dropped.
 *
 * Returns an array of { chunk: string, page: number }.
 */
function buildPerPageChunks(pages) {
  const out = [];
  for (let i = 0; i < pages.length; i++) {
    const pageNum = i + 1;
    const page = pages[i] || '';
    if (!page.trim()) continue;

    const banner = `=== PAGE ${pageNum} ===\n\n`;
    const block = banner + page;

    if (block.length > TEXT_CHUNK_CHAR_LIMIT) {
      // Oversized page → sub-chunk by rows, but tag every sub-chunk with the
      // SAME page number so it recombines into one product.
      const subChunks = chunkByRows(page, TEXT_CHUNK_CHAR_LIMIT - banner.length);
      for (const sub of subChunks) {
        out.push({ chunk: banner + sub, page: pageNum });
      }
    } else {
      out.push({ chunk: block, page: pageNum });
    }
  }
  return out;
}

/**
 * Extract the 1-based page numbers a chunk covers from its `=== PAGE N ===`
 * banners. Used to tag mergeCoaRecords() records with their source_pages.
 * Returns [] when a chunk carries no banner (e.g. the single-page fast path).
 */
function chunkPageNumbers(chunk) {
  const nums = [];
  const re = /=== PAGE (\d+) ===/g;
  let m;
  while ((m = re.exec(chunk || '')) !== null) {
    const n = parseInt(m[1], 10);
    if (!isNaN(n)) nums.push(n);
  }
  return nums;
}

/**
 * Merge per-chunk extraction results into a single parsed object so multi-
 * page docs surface every page's data. Rules:
 *   - fields: first non-empty wins (cover-page fields like supplier_name
 *     stick from page 1, late pages can backfill missing keys).
 *   - products / tables: concat across chunks (the win for multi-page COAs
 *     that are one product per page).
 *   - summary / documentType: first non-empty.
 *   - confidence / confidenceNum: min across chunks (the worst page's
 *     confidence dominates — honest signal for the reviewer).
 *
 * Callers MUST short-circuit single-chunk docs and return the parsed object
 * directly; this function is only invoked for multi-chunk runs.
 */
function mergeTextExtractions(parsedArray) {
  const merged = {
    fields: {},
    tables: [],
    products: [],
    summary: '',
    confidence: 'low',
    confidenceNum: null,
    documentType: null,
  };

  const isEmpty = (v) => v == null || (typeof v === 'string' && v.trim() === '');
  const confRank = { high: 3, medium: 2, low: 1 };
  let minConfBucket = null;

  for (const p of parsedArray) {
    if (!p) continue;

    // fields: first non-empty wins
    for (const [k, v] of Object.entries(p.fields || {})) {
      if (!isEmpty(v) && isEmpty(merged.fields[k])) {
        merged.fields[k] = v;
      }
    }

    if (Array.isArray(p.tables) && p.tables.length > 0) {
      merged.tables.push(...p.tables);
    }
    if (Array.isArray(p.products) && p.products.length > 0) {
      merged.products.push(...p.products);
    }

    if (!merged.summary && typeof p.summary === 'string' && p.summary.trim()) {
      merged.summary = p.summary;
    }
    if (!merged.documentType && typeof p.documentType === 'string' && p.documentType.trim()) {
      merged.documentType = p.documentType;
    }

    // confidence bucket: track min via rank
    if (p.confidence && confRank[p.confidence]) {
      if (minConfBucket == null || confRank[p.confidence] < confRank[minConfBucket]) {
        minConfBucket = p.confidence;
      }
    }

    // numeric confidence: null-safe min
    if (typeof p.confidenceNum === 'number' && isFinite(p.confidenceNum)) {
      if (merged.confidenceNum == null || p.confidenceNum < merged.confidenceNum) {
        merged.confidenceNum = p.confidenceNum;
      }
    }
  }

  if (minConfBucket) merged.confidence = minConfBucket;
  return merged;
}

// =============================================================================
// XLSX support (text-shaped — one CSV per sheet, fed through the chunker)
// =============================================================================

/**
 * True when the queue item is an XLSX workbook. Matches the
 * openxmlformats spreadsheet mime OR a `.xlsx` filename (some sources post a
 * generic octet-stream mime for spreadsheet attachments).
 */
function isXlsxItem(item) {
  return (
    item.mime_type === 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' ||
    /\.xlsx$/i.test(item.file_name || '')
  );
}

/**
 * Parse an XLSX buffer into an array of per-sheet CSV strings (pages[]).
 * Sheets whose name matches /inactive/i are skipped (mirrors the
 * INACTIVE_CUST skip in functions/lib/connectors/email.ts:parseXLSXAttachment).
 * Pipe field-separator keeps the model grounded on column boundaries since
 * cells frequently contain commas. Returns [] if no usable sheets.
 */
function xlsxToPages(fileBuffer) {
  const XLSX = require('xlsx');
  const workbook = XLSX.read(new Uint8Array(fileBuffer), { type: 'array' });
  const pages = [];
  for (const sheetName of workbook.SheetNames) {
    if (/inactive/i.test(sheetName)) continue;
    const ws = workbook.Sheets[sheetName];
    if (!ws) continue;
    const csv = XLSX.utils.sheet_to_csv(ws, { FS: ' | ' });
    if (csv && csv.trim()) {
      pages.push(`=== SHEET: ${sheetName} ===\n${csv}`);
    }
  }
  return pages;
}

/**
 * Parse an XLSX buffer into an array of { name, csv, csvComma } per-sheet
 * records, in workbook order. Sheets whose name matches /inactive/i are skipped
 * (mirrors the INACTIVE_CUST skip in functions/lib/connectors/email.ts). Empty
 * sheets are dropped. Returns [] if no usable sheets.
 *
 *   - `csv`      — pipe field-separated (` | `). Used as the LLM-facing text
 *                  block, where pipes keep the model grounded on column
 *                  boundaries (cells often contain commas).
 *   - `csvComma` — standard comma-separated. Used by the DETERMINISTIC
 *                  parseCSVAttachment path, whose splitter only understands
 *                  comma/tab delimiters — pipes would collapse every row into
 *                  one field.
 *
 * Unlike xlsxToPages (which concatenates all sheets into the chunker, dropping
 * late-alphabet rows on big workbooks), this keeps sheets ISOLATED so the
 * order/shipment path can extract each sheet independently and merge.
 */
function xlsxToSheets(fileBuffer) {
  const XLSX = require('xlsx');
  const workbook = XLSX.read(new Uint8Array(fileBuffer), { type: 'array' });
  const sheets = [];
  for (const sheetName of workbook.SheetNames) {
    if (/inactive/i.test(sheetName)) {
      console.log(`  Skipping sheet: ${sheetName} (inactive customers excluded)`);
      continue;
    }
    const ws = workbook.Sheets[sheetName];
    if (!ws) continue;
    const csv = XLSX.utils.sheet_to_csv(ws, { FS: ' | ', RS: '\n', blankrows: false });
    if (csv && csv.trim()) {
      const csvComma = XLSX.utils.sheet_to_csv(ws, { RS: '\n', blankrows: false });
      sheets.push({ name: sheetName, csv, csvComma });
    }
  }
  return sheets;
}

/**
 * True when the queue item is a CSV/TSV-shaped delimited file: text/csv mime
 * OR a .csv / .tsv filename (some sources post generic text/plain or
 * octet-stream mimes for CSV attachments). Used by the order/shipment path to
 * route to the deterministic parseCSVAttachment when field_mappings exist.
 */
function isCsvItem(item) {
  return (
    item.mime_type === 'text/csv' ||
    item.mime_type === 'text/tab-separated-values' ||
    /\.(csv|tsv)$/i.test(item.file_name || '')
  );
}

/**
 * True when there are usable field_mappings on the profile — at least one
 * enabled core mapping or one extended mapping. An empty/zeroed mappings
 * object means the deterministic parser can't bind any columns, so the caller
 * falls back to the Qwen path.
 */
function hasUsableFieldMappings(fm) {
  if (!fm || typeof fm !== 'object') return false;
  const coreEnabled =
    fm.core && typeof fm.core === 'object' &&
    Object.values(fm.core).some((c) => c && c.enabled);
  const hasExtended = Array.isArray(fm.extended) && fm.extended.length > 0;
  return Boolean(coreEnabled || hasExtended);
}

// =============================================================================
// DOCX support (text-shaped — Word audit trails, BOLs, etc., no OCR/VLM)
// =============================================================================

/**
 * True when the queue item is a Word .docx document. Matches the
 * openxmlformats wordprocessing mime OR a `.docx` filename (some sources post
 * a generic octet-stream mime for Word attachments). The WMS audit trail that
 * exposed this gap is a .docx — without this branch the worker extracts no
 * text and errors with "no text extracted".
 */
function isDocxItem(item) {
  return (
    item.mime_type === 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' ||
    /\.docx$/i.test(item.file_name || '')
  );
}

/**
 * Extract plain text from a .docx buffer via mammoth (extractRawText). Returns
 * a `pages[]` array — DOCX has no hard page boundaries we can cheaply recover,
 * so the whole document is a single text-shaped "page" fed through the same
 * chunker as the other text formats. Returns [] on empty/failed extraction.
 */
async function docxToPages(fileBuffer) {
  const mammoth = require('mammoth');
  const { value } = await mammoth.extractRawText({ buffer: Buffer.from(fileBuffer) });
  const text = (value || '').trim();
  return text ? [text] : [];
}

// =============================================================================
// Shared text/format extraction (order + shipment paths)
// =============================================================================

/**
 * Extract `{ text, pages }` from a downloaded file buffer for the text-shaped
 * order/shipment paths. Handles PDF (unpdf + OCR fallback), text/csv/json,
 * XLSX, DOCX, and standalone images (OCR). Order/shipment inputs are
 * overwhelmingly text-shaped (XLSX/CSV/PDF order confirmations, Word audit
 * trails), so there is NO VLM here.
 *
 * The COA path keeps its OWN inline extraction (byte-identical to pre-P3); this
 * helper is a separate, simpler extractor for the new kinds so the COA branch
 * is never touched.
 */
async function extractTextAndPages(item, fileBuffer, fileBufferCopy) {
  let text = null;
  let pages = [];

  if (item.mime_type === 'application/pdf') {
    try {
      const { extractText } = await import('unpdf');
      const result = await extractText(new Uint8Array(fileBuffer), { mergePages: false });
      const rawPages = Array.isArray(result.text)
        ? result.text.map(p => (p == null ? '' : String(p)))
        : (result.text ? [String(result.text)] : []);
      if (rawPages.length > 0 && rawPages.some(p => p.trim().length > 0)) {
        pages = rawPages;
        text = rawPages.join('\n').replace(/\s+/g, ' ').substring(0, 100000);
      }
    } catch (err) {
      console.warn(`PDF extraction failed for ${item.file_name}:`, err.message);
    }
    if (text && text.trim().length > 0 && isTextGarbled(text)) {
      text = null;
      pages = [];
    }
    if (!text || text.trim().length === 0) {
      const ocrText = ocrPdf(fileBufferCopy);
      if (ocrText) {
        text = ocrText.substring(0, 100000);
        pages = [text];
      }
    }
  } else if (
    item.mime_type === 'text/plain' ||
    item.mime_type === 'text/csv' ||
    item.mime_type === 'application/json'
  ) {
    text = new TextDecoder().decode(new Uint8Array(fileBuffer)).substring(0, 100000);
    pages = [text];
  } else if (isXlsxItem(item)) {
    try {
      pages = xlsxToPages(fileBuffer);
      text = pages.join('\n').substring(0, 100000);
    } catch (err) {
      console.warn(`  XLSX parse failed for ${item.file_name}: ${err.message}`);
    }
  } else if (isDocxItem(item)) {
    try {
      pages = await docxToPages(fileBuffer);
      text = pages.join('\n').substring(0, 100000);
    } catch (err) {
      console.warn(`  DOCX parse failed for ${item.file_name}: ${err.message}`);
    }
  } else if (item.mime_type === 'image/png' || item.mime_type === 'image/jpeg' || item.mime_type === 'image/jpg') {
    try {
      const ext = item.mime_type === 'image/png' ? 'png' : 'jpg';
      const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'dox-ocr-'));
      const imgPath = path.join(tmpDir, `image.${ext}`);
      fs.writeFileSync(imgPath, Buffer.from(fileBuffer));
      detectAndRotateImage(imgPath);
      try {
        const result = execFileSync('tesseract', [imgPath, 'stdout', '--psm', '1'], {
          timeout: 60_000,
          stdio: ['pipe', 'pipe', 'pipe'],
        });
        text = result.toString('utf-8').trim();
        if (text) {
          text = text.substring(0, 100000);
          pages = [text];
        }
      } catch (err) {
        console.warn(`  OCR failed for ${item.file_name}: ${err.message}`);
      }
      try {
        fs.unlinkSync(imgPath);
        fs.rmdirSync(tmpDir);
      } catch { /* best-effort */ }
    } catch (err) {
      console.warn(`  Image OCR setup failed: ${err.message}`);
    }
  }

  return { text, pages };
}

// =============================================================================
// Extraction profile loading (Phase P3)
// =============================================================================

/**
 * Load a unified extraction profile for a queue item.
 *
 * The profile is keyed on the UNIFIED (supplier_id, document_type_id) pair —
 * connectors and uploads now resolve the same way. Resolution order for the
 * new 'order' / 'shipment' kinds:
 *   1. source_id present → GET /api/sources/:id/profile (the endpoint itself
 *      now resolves by the source's supplier+doctype and returns
 *      field_mappings + extraction_instructions).
 *   2. else supplier_id + document_type_id present →
 *      GET /api/extraction-instructions?supplier_id=&document_type_id= which
 *      returns { instructions, field_mappings } for that exact pair.
 *
 * Always returns a safe object (null field_mappings ⇒ caller uses the default
 * prompt). Never throws — extraction must always proceed.
 *
 * For 'coa' / null kinds this is unused: the COA path keeps TODAY'S exact
 * resolution (supplier name-resolve, fetchReviewerInstructions, examples,
 * learned prefs) inline in processCoaItem — untouched.
 */
async function loadExtractionProfile(item) {
  const kind = item.output_kind || 'coa';
  const profile = {
    kind,
    field_mappings: null,
    extraction_instructions: '',
    supplier_id: item.supplier_id || null,
    document_type_id: item.document_type_id || null,
  };

  if (kind !== 'order' && kind !== 'shipment') return profile;

  if (item.source_id) {
    try {
      const res = await fetch(
        `${DOX_API_URL}/api/sources/${encodeURIComponent(item.source_id)}/profile`,
        { headers }
      );
      if (res.ok) {
        const data = await res.json();
        profile.field_mappings = data.field_mappings || null;
        profile.extraction_instructions =
          typeof data.extraction_instructions === 'string' ? data.extraction_instructions : '';
        if (data.supplier_id) profile.supplier_id = data.supplier_id;
        if (data.document_type_id) profile.document_type_id = data.document_type_id;
        console.log(
          `  Source profile loaded for ${item.source_id} ` +
          `(supplier=${profile.supplier_id}, doctype=${profile.document_type_id}, ` +
          `mappings=${profile.field_mappings ? 'yes' : 'none'}, ` +
          `instructions=${profile.extraction_instructions.length} chars)`
        );
      } else {
        console.warn(`  Source profile fetch failed: ${res.status} (using defaults)`);
      }
    } catch (err) {
      console.warn(`  Source profile lookup failed (non-critical): ${err.message}`);
    }
    return profile;
  }

  // No source_id: resolve by (supplier_id, document_type_id) via the
  // instructions endpoint, which also carries the field_mappings for that
  // pair. Needs BOTH ids — the supplier-wide aggregate path of that endpoint
  // returns no field_mappings, so we only call it when both are present.
  if (profile.supplier_id && profile.document_type_id) {
    try {
      const params = new URLSearchParams({
        supplier_id: profile.supplier_id,
        document_type_id: profile.document_type_id,
      });
      if (item.tenant_id) params.set('tenant_id', item.tenant_id);
      const res = await fetch(
        `${DOX_API_URL}/api/extraction-instructions?${params.toString()}`,
        { headers }
      );
      if (res.ok) {
        const data = await res.json();
        profile.field_mappings = data.field_mappings || null;
        profile.extraction_instructions =
          typeof data.instructions === 'string' ? data.instructions : '';
        console.log(
          `  Profile resolved by (supplier=${profile.supplier_id}, ` +
          `doctype=${profile.document_type_id}): ` +
          `mappings=${profile.field_mappings ? 'yes' : 'none'}, ` +
          `instructions=${profile.extraction_instructions.length} chars`
        );
      } else {
        console.warn(`  Extraction-instructions fetch failed: ${res.status} (using defaults)`);
      }
    } catch (err) {
      console.warn(`  Extraction-instructions lookup failed (non-critical): ${err.message}`);
    }
  }

  return profile;
}

// =============================================================================
// Order / shipment text-path Qwen caller (shared by both new kinds)
// =============================================================================

// The model id the router ACTUALLY served on the most recent order/shipment
// text call, including quantization (e.g.
// "unsloth/Qwen3.6-35B-A3B-GGUF:UD-Q5_K_M"). Mirrors the vlm_model convention:
// every extraction should be self-describing so a later grading/parity run can
// prove which model produced it. A past grading pass was scored against the
// wrong quantization because a backend swapped underneath us.
let lastServedTextModel = null;

/**
 * Choose the model to send for `tag` on this attempt.
 *
 * Normal case: the resolver returns the best entry of the tag's preference
 * chain that GET /v1/models says has a healthy upstream. Once a call has
 * failed we (a) force a re-probe rather than waiting out the ~60s health TTL,
 * and (b) skip past any model this document already saw fail — which is what
 * makes the chain get WALKED IN ORDER even when the health endpoint is lying
 * or unreachable but /v1/chat/completions still works.
 *
 * Throws only when nothing in the chain is available (message names the chain).
 */
async function pickModel(tag, failedModels) {
  const res = await resolveModel(tag, process.env, { force: failedModels.size > 0 });
  const list = res.candidates && res.candidates.length ? res.candidates : [res.model];
  const next = list.find((m) => !failedModels.has(m));
  // Everything in the chain has failed at least once — retry the best
  // available rather than giving up outright (it may have been transient).
  return next || res.model;
}

/**
 * Call the text-path Qwen model with a single chunk and a fully-composed
 * system prompt, returning the RAW parsed JSON object (or null on parse
 * failure). Same retry/timeout shape as the COA runTextQwen, but kind-agnostic:
 * the caller owns prompt construction (order vs shipment) and downstream
 * normalization. JSON-only via response_format so the order/shipment shapes
 * come back clean.
 */
async function runRecordsQwen(systemPrompt, userText, fileName) {
  let qwenData;
  const failedModels = new Set();
  let requestedModel = null;
  for (let attempt = 1; attempt <= 2; attempt++) {
    try {
      requestedModel = await pickModel('best', failedModels);
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 1_800_000); // 30 min
      const qwenRes = await fetch(`${QWEN_URL}/v1/chat/completions`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          ...(QWEN_SECRET ? { Authorization: `Bearer ${QWEN_SECRET}` } : {}),
        },
        signal: controller.signal,
        dispatcher: llmDispatcher,
        body: JSON.stringify({
          model: requestedModel,
          temperature: 0,
          max_tokens: 8192,
          response_format: { type: 'json_object' },
          messages: [
            { role: 'system', content: systemPrompt },
            { role: 'user', content: `Subject: ${fileName}\n\n${userText}` },
          ],
        }),
      });
      clearTimeout(timeout);
      if (!qwenRes.ok) {
        const errText = await qwenRes.text().catch(() => '');
        throw new Error(`Qwen HTTP ${qwenRes.status}: ${errText.substring(0, 200)}`);
      }
      qwenData = await qwenRes.json();
      break;
    } catch (err) {
      // Drop the cached health snapshot so the retry re-resolves immediately
      // instead of waiting out the TTL, and blacklist the model we just tried
      // so the retry walks DOWN the preference chain.
      invalidateModelCache(process.env);
      if (requestedModel) failedModels.add(requestedModel);
      if (attempt === 2) throw new Error(`Qwen call failed: ${err.message}`);
      console.warn(`  Qwen retry ${attempt}/2 for ${fileName}: ${err.message}`);
      if (isModelUnavailableError(err.message)) {
        // The router rejected the model outright — a reload wait buys nothing,
        // go straight at the next chain entry.
        console.warn(`  Model "${requestedModel}" unavailable; trying the next in the chain`);
      } else {
        console.warn('  Waiting 60s for model to load...');
        await new Promise(r => setTimeout(r, 60_000));
      }
    }
  }
  // Record the TRUE served id (includes quantization) for the result body.
  lastServedTextModel = noteServedModel('best', requestedModel, qwenData.model);
  let content = qwenData.choices?.[0]?.message?.content || '';
  console.log(`  Qwen response (${content.length} chars): ${content.substring(0, 200)}...`);
  // Strip thinking blocks / code fences the same way parseExtraction does.
  content = content.replace(/<think>[\s\S]*?<\/think>\s*/g, '').trim();
  const fenceMatch = content.match(/^```(?:json)?\s*\n?([\s\S]*?)\n?\s*```$/);
  if (fenceMatch) content = fenceMatch[1].trim();
  try {
    return JSON.parse(content);
  } catch (err) {
    console.warn(`  JSON parse failed: ${err.message}`);
    return null;
  }
}

/**
 * Build the soft-capped text chunks for an order/shipment input. Reuses the
 * COA chunker (buildPageChunks / chunkByRows) so XLSX sheets and multi-page
 * PDFs split the same way, with the same TEXT_MAX_CHUNKS cap and legacy
 * single-truncated fallback.
 */
function buildRecordChunks(text, pages) {
  if (pages.length <= 1) return [text.substring(0, 6000)];
  const chunks = buildPageChunks(pages);
  if (chunks.length === 0) return [text.substring(0, 6000)];
  if (chunks.length > TEXT_MAX_CHUNKS) {
    console.warn(
      `  Records chunking: ${pages.length} page(s)/sheet(s) → ${chunks.length} chunks ` +
      `(cap: ${TEXT_MAX_CHUNKS}) — falling back to legacy 6K-truncation single call`
    );
    return [text.substring(0, 6000)];
  }
  return chunks;
}

// =============================================================================
// Order extraction path (Phase P3)
// =============================================================================

/**
 * Extract orders + customers from a queued order document. Builds the prompt
 * from the connector's field_mappings via the SHARED orderPrompt module
 * (same code the CF connector pipeline runs), runs one Qwen call per chunk,
 * normalizes each chunk with normalizeAiOutput, and merges via mergeOutputs.
 *
 * Posts ai_records = JSON.stringify({orders, customers}) — NO ai_fields. The
 * server-side producer that turns ai_records into entities is Phase P4; here
 * the worker only extracts + posts. Confidence is the LLM self-rating (no
 * template gate — that's the producer's job).
 */
async function processOrderItem(item) {
  const startTime = Date.now();
  console.log(`Processing ORDER ${item.file_name} (${item.id})...`);

  try {
    await postResults(item.id, { processing_status: 'processing' });

    const profile = await loadExtractionProfile(item);
    const haveMappings = hasUsableFieldMappings(profile.field_mappings);

    // Download once up front — every path below needs the bytes (deterministic
    // CSV/XLSX parse OR text extraction for Qwen).
    const fileBuffer = await downloadQueueFile(item);

    // ===== Deterministic paths (no Qwen) when field_mappings exist =====
    // The shared parseCSVAttachment binds columns to the canonical
    // {orders, customers} shape using the profile's field_mappings — the SAME
    // code the CF connector pipeline runs, so output is byte-identical. We use
    // it for CSV (whole file) and XLSX (per-sheet, merged). Falls through to
    // the Qwen path on null/empty mappings OR zero records parsed.
    let orders = null;
    let customers = null;
    let extractedText = '';
    let parseMethod = 'qwen';

    if (haveMappings && isCsvItem(item)) {
      try {
        const out = parseCSVAttachment(
          { fieldMappings: profile.field_mappings },
          { content: fileBuffer }
        );
        if (out && Array.isArray(out.orders) && out.orders.length > 0) {
          orders = out.orders;
          customers = out.customers || [];
          extractedText = new TextDecoder().decode(new Uint8Array(fileBuffer)).substring(0, 100000);
          parseMethod = 'csv-deterministic';
          console.log(
            `  Order CSV (deterministic): ${orders.length} order(s), ${customers.length} customer(s)`
          );
        } else {
          console.log('  CSV deterministic parse yielded 0 orders — falling back to Qwen');
        }
      } catch (err) {
        console.warn(`  CSV deterministic parse failed (${err.message}) — falling back to Qwen`);
      }
    } else if (haveMappings && isXlsxItem(item)) {
      try {
        const sheets = xlsxToSheets(fileBuffer);
        const sheetOutputs = [];
        const textBlocks = [];
        for (const sheet of sheets) {
          textBlocks.push(`=== SHEET: ${sheet.name} ===\n${sheet.csv}`);
          // parseCSVAttachment consumes an ArrayBuffer and splits on comma/tab,
          // so feed the comma-rendered CSV (not the pipe LLM rendering).
          const content = new TextEncoder().encode(sheet.csvComma).buffer;
          const out = parseCSVAttachment(
            { fieldMappings: profile.field_mappings },
            { content }
          );
          sheetOutputs.push({
            orders: out.orders || [],
            customers: out.customers || [],
            errors: out.errors || [],
          });
          console.log(
            `  Sheet "${sheet.name}" (deterministic): ` +
            `${(out.orders || []).length} order(s), ${(out.customers || []).length} customer(s)`
          );
        }
        const mergedSheets = mergeOutputs(sheetOutputs);
        if (mergedSheets.orders.length > 0) {
          orders = mergedSheets.orders;
          customers = mergedSheets.customers;
          extractedText = textBlocks.join('\n').substring(0, 100000);
          parseMethod = 'xlsx-deterministic';
          console.log(
            `  Order XLSX (deterministic): ${sheets.length} sheet(s) → ` +
            `${orders.length} order(s), ${customers.length} customer(s)`
          );
        } else {
          console.log('  XLSX deterministic parse yielded 0 orders — falling back to Qwen');
        }
      } catch (err) {
        console.warn(`  XLSX deterministic parse failed (${err.message}) — falling back to Qwen`);
      }
    }

    // ===== Qwen fallback path (no usable mappings, or deterministic yielded 0) =====
    if (orders == null) {
      const fileBufferCopy = fileBuffer.slice(0);

      // field_mappings may be null when no profile resolved — fall back to the
      // shared default-mappings prompt so a prompt always builds.
      const basePrompt = profile.field_mappings
        ? buildParsingPrompt(profile.field_mappings)
        : getDefaultParsingPrompt();
      const systemPrompt = prependConnectorInstructions(basePrompt, profile.extraction_instructions);

      const outputs = [];

      if (isXlsxItem(item)) {
        // Per-sheet isolation: run one extraction PER SHEET and merge, so
        // late-alphabet rows on big workbooks aren't dropped by concatenating
        // everything into one chunker stream. Mirrors parseXLSXAttachment in
        // functions/lib/connectors/email.ts.
        let sheets = [];
        try {
          sheets = xlsxToSheets(fileBuffer);
        } catch (err) {
          console.warn(`  XLSX parse failed for ${item.file_name}: ${err.message}`);
        }
        const textBlocks = [];
        for (const sheet of sheets) {
          textBlocks.push(`=== SHEET: ${sheet.name} ===\n${sheet.csv}`);
          // Chunk THIS sheet alone so a single huge sheet still splits safely.
          const sheetPages = [`=== SHEET: ${sheet.name} ===\n${sheet.csv}`];
          const sheetText = sheetPages[0];
          const chunks = buildRecordChunks(sheetText, sheetPages);
          for (let i = 0; i < chunks.length; i++) {
            console.log(
              `  Qwen call sheet "${sheet.name}" ${i + 1}/${chunks.length} (${chunks[i].length} chars)`
            );
            const raw = await runRecordsQwen(systemPrompt, chunks[i], item.file_name);
            if (raw) {
              const { orders: o, customers: c } = normalizeAiOutput(raw);
              outputs.push({ orders: o, customers: c, errors: [] });
            }
          }
        }
        extractedText = textBlocks.join('\n').substring(0, 100000);
        if (textBlocks.length === 0) {
          await postResults(item.id, {
            processing_status: 'error',
            error_message: `Could not extract text from ${item.mime_type} file for order extraction.`,
          });
          console.log(`  Skipped ${item.file_name}: no usable sheets`);
          return;
        }
      } else {
        // Non-XLSX: PDF / CSV-without-mappings / DOCX / image. Single text
        // stream through the chunker, exactly as before.
        const { text, pages } = await extractTextAndPages(item, fileBuffer, fileBufferCopy);
        if (!text || text.trim().length === 0) {
          await postResults(item.id, {
            processing_status: 'error',
            error_message: `Could not extract text from ${item.mime_type} file for order extraction.`,
          });
          console.log(`  Skipped ${item.file_name}: no text extracted`);
          return;
        }
        extractedText = text.substring(0, 100000);
        const chunks = buildRecordChunks(text, pages);
        console.log(`  Order extraction: ${pages.length} page(s) → ${chunks.length} chunk(s)`);
        for (let i = 0; i < chunks.length; i++) {
          console.log(`  Qwen call ${i + 1}/${chunks.length} (${chunks[i].length} chars)`);
          const raw = await runRecordsQwen(systemPrompt, chunks[i], item.file_name);
          if (raw) {
            const { orders: o, customers: c } = normalizeAiOutput(raw);
            outputs.push({ orders: o, customers: c, errors: [] });
          }
        }
      }

      const merged = mergeOutputs(outputs);
      orders = merged.orders;
      customers = merged.customers;
    }

    // Confidence = min LLM self-rating across orders (honest worst-case for the
    // reviewer). No template gate — the P4 producer owns that decision.
    let confidence = null;
    for (const o of orders) {
      const c = clampConfidence(o._confidence);
      if (typeof c === 'number') confidence = confidence == null ? c : Math.min(confidence, c);
    }

    await postResults(item.id, {
      processing_status: 'ready',
      extracted_text: extractedText,
      ai_records: JSON.stringify({ orders, customers }),
      confidence,
      summary: `Extracted ${orders.length} order(s), ${customers.length} customer(s)`,
      // Which text model actually served this run (null when the deterministic
      // CSV mapping path handled it and no LLM call was made).
      text_model: lastServedTextModel,
    });

    const elapsed = ((Date.now() - startTime) / 1000).toFixed(1);
    console.log(`  Done (order/${parseMethod}): ${item.file_name} — ${orders.length} order(s), ${customers.length} customer(s), ${elapsed}s`);
  } catch (err) {
    console.error(`  Error processing order ${item.file_name}:`, err.message);
    await postResults(item.id, {
      processing_status: 'error',
      error_message: err.message,
    }).catch(() => {});
  }
}

// =============================================================================
// Shipment extraction path (Phase P3)
// =============================================================================

const SHIPMENT_PROMPT = `/no_think
You are a shipment/fulfillment report parser. Extract shipment line records from the input.
The input may be a shipping manifest, fulfillment export, BOL detail, or a spreadsheet of shipped lots.

Extract every shipment line into a "shipments" array. Each shipment object has:
  - order_number   (REQUIRED) — the order/invoice/sale identifier this shipment fulfills.
  - product_name   — product description.
  - product_code   — product/item code or SKU.
  - lot_number     (REQUIRED) — the lot/batch/run number shipped.
  - quantity       — quantity shipped (number; negatives allowed for adjustments).
  - status         — fulfillment status if present (e.g. "shipped", "picked", "backordered").

Rules:
- Emit ONE shipment object per shipped line. A single order with three shipped
  lots becomes three shipment objects, all sharing that order_number.
- If a row has no order_number OR no lot_number, DROP it — those are the two
  required keys and a row missing either is not a usable shipment record.
- Do NOT fabricate order_number or lot_number from adjacent columns. If a value
  is not clearly present, leave optional fields null and drop the row if a
  required field is missing.
- ALWAYS emit \`_confidence\` on every shipment — a single number between 0.0 and
  1.0 reflecting how sure you are about that record. Be honest; a low confidence
  flag a human can investigate is FAR better than a fabricated record.
- Return valid JSON only, no explanation.

Return JSON in this exact shape:
{ "shipments": [ { "order_number": "...", "product_name": "...", "product_code": "...", "lot_number": "...", "quantity": 0, "status": "...", "_confidence": 0.0 } ] }`;

/**
 * Extract shipments from a queued shipment document. Minimal new prompt (above),
 * one Qwen call per chunk, drops rows missing order_number or lot_number, posts
 * ai_records = JSON.stringify({shipments}). Confidence = min LLM self-rating
 * across surviving rows. P4 owns turning these into entities.
 */
async function processShipmentItem(item) {
  const startTime = Date.now();
  console.log(`Processing SHIPMENT ${item.file_name} (${item.id})...`);

  try {
    await postResults(item.id, { processing_status: 'processing' });

    const fileBuffer = await downloadQueueFile(item);

    const profile = await loadExtractionProfile(item);
    const systemPrompt = prependConnectorInstructions(SHIPMENT_PROMPT, profile.extraction_instructions);

    const shipments = [];
    let confidence = null;
    let extractedText = '';

    // Drain one Qwen response's shipments[] into the accumulator, applying the
    // same required-field validation regardless of which input path produced
    // the chunk. Shipments have no deterministic field-mapping parser (the
    // shared parser emits orders/customers, a different schema), so shipments
    // always go through Qwen — but per-sheet for XLSX so big workbooks don't
    // drop late rows.
    const drainShipments = (raw) => {
      if (!raw || !Array.isArray(raw.shipments)) return;
      for (const s of raw.shipments) {
        const orderNumber = s && typeof s.order_number === 'string' ? s.order_number.trim() : '';
        const lotNumber = s && typeof s.lot_number === 'string' ? s.lot_number.trim() : '';
        if (!orderNumber || !lotNumber) continue;
        const conf = clampConfidence(s._confidence);
        if (typeof conf === 'number') confidence = confidence == null ? conf : Math.min(confidence, conf);
        shipments.push({
          order_number: orderNumber,
          product_name: s.product_name != null ? String(s.product_name) : null,
          product_code: s.product_code != null ? String(s.product_code) : null,
          lot_number: lotNumber,
          quantity: s.quantity != null ? s.quantity : null,
          status: s.status != null ? String(s.status) : null,
          _confidence: conf,
        });
      }
    };

    if (isXlsxItem(item)) {
      // Per-sheet isolation: extract each sheet independently and merge, so
      // late-alphabet rows on big workbooks aren't dropped by concatenating
      // every sheet into one chunker stream.
      let sheets = [];
      try {
        sheets = xlsxToSheets(fileBuffer);
      } catch (err) {
        console.warn(`  XLSX parse failed for ${item.file_name}: ${err.message}`);
      }
      if (sheets.length === 0) {
        await postResults(item.id, {
          processing_status: 'error',
          error_message: `Could not extract text from ${item.mime_type} file for shipment extraction.`,
        });
        console.log(`  Skipped ${item.file_name}: no usable sheets`);
        return;
      }
      const textBlocks = [];
      for (const sheet of sheets) {
        const block = `=== SHEET: ${sheet.name} ===\n${sheet.csv}`;
        textBlocks.push(block);
        const chunks = buildRecordChunks(block, [block]);
        for (let i = 0; i < chunks.length; i++) {
          console.log(
            `  Qwen call sheet "${sheet.name}" ${i + 1}/${chunks.length} (${chunks[i].length} chars)`
          );
          drainShipments(await runRecordsQwen(systemPrompt, chunks[i], item.file_name));
        }
      }
      extractedText = textBlocks.join('\n').substring(0, 100000);
    } else {
      const fileBufferCopy = fileBuffer.slice(0);
      const { text, pages } = await extractTextAndPages(item, fileBuffer, fileBufferCopy);
      if (!text || text.trim().length === 0) {
        await postResults(item.id, {
          processing_status: 'error',
          error_message: `Could not extract text from ${item.mime_type} file for shipment extraction.`,
        });
        console.log(`  Skipped ${item.file_name}: no text extracted`);
        return;
      }
      extractedText = text.substring(0, 100000);
      const chunks = buildRecordChunks(text, pages);
      console.log(`  Shipment extraction: ${pages.length} page(s) → ${chunks.length} chunk(s)`);
      for (let i = 0; i < chunks.length; i++) {
        console.log(`  Qwen call ${i + 1}/${chunks.length} (${chunks[i].length} chars)`);
        drainShipments(await runRecordsQwen(systemPrompt, chunks[i], item.file_name));
      }
    }

    await postResults(item.id, {
      processing_status: 'ready',
      extracted_text: extractedText,
      ai_records: JSON.stringify({ shipments }),
      confidence,
      summary: `Extracted ${shipments.length} shipment line(s)`,
      // Which text model actually served this run (see text_model above).
      text_model: lastServedTextModel,
    });

    const elapsed = ((Date.now() - startTime) / 1000).toFixed(1);
    console.log(`  Done (shipment): ${item.file_name} — ${shipments.length} shipment line(s), ${elapsed}s`);
  } catch (err) {
    console.error(`  Error processing shipment ${item.file_name}:`, err.message);
    await postResults(item.id, {
      processing_status: 'error',
      error_message: err.message,
    }).catch(() => {});
  }
}

/**
 * Download a queue item's file with the same 3-attempt retry the COA path uses.
 * Extracted so the order/shipment paths share it without touching the COA
 * branch's inline copy.
 */
async function downloadQueueFile(item) {
  let fileBuffer;
  for (let attempt = 1; attempt <= 3; attempt++) {
    try {
      const fileRes = await fetch(`${DOX_API_URL}/api/queue/${item.id}/file`, {
        headers: { 'X-API-Key': DOX_API_KEY },
      });
      if (!fileRes.ok) throw new Error(`File download failed: ${fileRes.status}`);
      fileBuffer = await fileRes.arrayBuffer();
      return fileBuffer;
    } catch (err) {
      if (attempt === 3) throw err;
      console.warn(`  Retry ${attempt}/3 for ${item.file_name}: ${err.message}`);
      await new Promise(r => setTimeout(r, 2000 * attempt));
    }
  }
}

/**
 * Output-kind dispatcher (Phase P3). The single extraction engine now serves
 * three OUTPUT kinds:
 *   - 'coa' (and null/unknown) → the original COA/document path, UNCHANGED.
 *   - 'order'                  → order/customer extraction via the shared
 *                                orderPrompt module; posts ai_records.
 *   - 'shipment'               → shipment/lot extraction; posts ai_records.
 *
 * The COA branch below is the entire pre-P3 processItem, renamed to
 * processCoaItem and otherwise byte-identical — same prompt builders, text/VLM
 * paths, chunker, confidence, and ai_fields/tables result body. The dispatcher
 * only chooses which path to run; it never edits the COA path's internals.
 */
async function processItem(item) {
  const kind = item.output_kind || 'coa';
  if (kind === 'order') return await processOrderItem(item);
  if (kind === 'shipment') return await processShipmentItem(item);
  return await processCoaItem(item);
}

async function processCoaItem(item) {
  const startTime = Date.now();
  console.log(`Processing ${item.file_name} (${item.id})...`);

  try {
    // Mark as processing
    await postResults(item.id, { processing_status: 'processing' });

    // Download file (with retry)
    let fileBuffer;
    for (let attempt = 1; attempt <= 3; attempt++) {
      try {
        const fileRes = await fetch(`${DOX_API_URL}/api/queue/${item.id}/file`, {
          headers: { 'X-API-Key': DOX_API_KEY },
        });
        if (!fileRes.ok) {
          throw new Error(`File download failed: ${fileRes.status}`);
        }
        fileBuffer = await fileRes.arrayBuffer();
        break;
      } catch (err) {
        if (attempt === 3) throw err;
        console.warn(`  Retry ${attempt}/3 for ${item.file_name}: ${err.message}`);
        await new Promise(r => setTimeout(r, 2000 * attempt));
      }
    }

    // Extract text based on mime type.
    //
    // `text`  is the single concatenated string used for the extracted_text DB
    //         column and the isTextGarbled / 6K-truncation legacy paths.
    // `pages` is the per-page array used by buildPageChunks() for multi-page
    //         Qwen calls. For non-PDF inputs (or PDFs that fall back to OCR)
    //         it's a single-element array so the downstream chunker treats
    //         them as a one-chunk doc identical to today's behavior.
    let text = null;
    let pages = [];

    // Keep a copy of fileBuffer for OCR fallback (unpdf may detach the ArrayBuffer)
    const fileBufferCopy = fileBuffer.slice(0);
    // And another copy for VLM page rendering (if enabled) — unpdf's
    // getDocumentProxy also detaches the array buffer it's given.
    const fileBufferForVlm = fileBuffer.slice(0);

    if (item.mime_type === 'application/pdf') {
      try {
        const { extractText } = await import('unpdf');
        // mergePages: false → array of per-page strings so the chunker can
        // build size-aware multi-page Qwen calls. Earlier behavior was
        // mergePages: true, which silently truncated pages 3+ after a 6K cap.
        const result = await extractText(new Uint8Array(fileBuffer), { mergePages: false });
        // Coerce defensively — older unpdf builds returned a string here.
        const rawPages = Array.isArray(result.text)
          ? result.text.map(p => (p == null ? '' : String(p)))
          : (result.text ? [String(result.text)] : []);
        if (rawPages.length > 0 && rawPages.some(p => p.trim().length > 0)) {
          pages = rawPages;
          // `text` mirrors what unpdf's `mergePages: true` used to produce:
          // pages joined with "\n" and ALL whitespace collapsed to single
          // spaces. We preserve that collapsing so the legacy 6K-truncation
          // fast path, isTextGarbled() check, and extracted_text DB column
          // all see byte-identical inputs to pre-chunking behavior. The
          // un-collapsed per-page text lives in `pages[]` for the chunker,
          // where whitespace matters for table layout.
          text = rawPages.join('\n').replace(/\s+/g, ' ').substring(0, 100000);
        }
      } catch (err) {
        console.warn(`PDF extraction failed for ${item.file_name}:`, err.message);
      }

      // Check if unpdf output is garbled (columns merged without whitespace)
      if (text && text.trim().length > 0 && isTextGarbled(text)) {
        console.log(`  Text looks garbled (avg word len too high), trying OCR for ${item.file_name}...`);
        text = null; // fall through to OCR path below
        pages = [];
      }

      // OCR fallback for scanned/image-based PDFs. OCR returns one big string
      // with no usable page boundaries, so we wrap it as a single-element
      // pages[] — the chunker then routes it through the legacy 6K-truncation
      // fast path (we don't want to blow context on OCR'd images).
      if (!text || text.trim().length === 0) {
        console.log(`  No text from unpdf, trying OCR for ${item.file_name}...`);
        const ocrText = ocrPdf(fileBufferCopy);
        if (ocrText) {
          console.log(`  OCR extracted ${ocrText.length} chars`);
          text = ocrText.substring(0, 100000);
          pages = [text];
        }
      }
    } else if (
      item.mime_type === 'text/plain' ||
      item.mime_type === 'text/csv' ||
      item.mime_type === 'application/json'
    ) {
      text = new TextDecoder().decode(new Uint8Array(fileBuffer)).substring(0, 100000);
      pages = [text];
    } else if (isXlsxItem(item)) {
      // XLSX is text-shaped: each non-/inactive/ sheet → pipe-separated CSV
      // pushed as a pages[] entry so the existing chunker treats sheets like
      // pages. No OCR / VLM. Mirrors parseXLSXAttachment in
      // functions/lib/connectors/email.ts.
      try {
        pages = xlsxToPages(fileBuffer);
        text = pages.join('\n').substring(0, 100000);
      } catch (err) {
        console.warn(`  XLSX parse failed for ${item.file_name}: ${err.message}`);
      }
    } else if (isDocxItem(item)) {
      // DOCX is text-shaped: mammoth.extractRawText → one page through the
      // chunker. No OCR / VLM. Same handling as the order/shipment path's
      // extractTextAndPages so a Word COA extracts instead of erroring.
      try {
        pages = await docxToPages(fileBuffer);
        text = pages.join('\n').substring(0, 100000);
      } catch (err) {
        console.warn(`  DOCX parse failed for ${item.file_name}: ${err.message}`);
      }
    } else if (item.mime_type === 'image/png' || item.mime_type === 'image/jpeg' || item.mime_type === 'image/jpg') {
      // OCR standalone images via tesseract
      try {
        const ext = item.mime_type === 'image/png' ? 'png' : 'jpg';
        const tmpDir = fs.mkdtempSync(path.join(os.tmpdir(), 'dox-ocr-'));
        const imgPath = path.join(tmpDir, `image.${ext}`);
        fs.writeFileSync(imgPath, Buffer.from(fileBuffer));

        // Auto-rotate image if needed before OCR
        detectAndRotateImage(imgPath);

        try {
          const result = execFileSync('tesseract', [
            imgPath, 'stdout', '--psm', '1'
          ], { timeout: 60_000, stdio: ['pipe', 'pipe', 'pipe'] });
          text = result.toString('utf-8').trim();
          if (text) {
            console.log(`  OCR extracted ${text.length} chars from image`);
            text = text.substring(0, 100000);
            pages = [text];
          }
        } catch (err) {
          console.warn(`  OCR failed for ${item.file_name}: ${err.message}`);
        }

        // Cleanup
        try {
          fs.unlinkSync(imgPath);
          fs.rmdirSync(tmpDir);
        } catch { /* best-effort */ }
      } catch (err) {
        console.warn(`  Image OCR setup failed: ${err.message}`);
      }
    }

    if (!text || text.trim().length === 0) {
      await postResults(item.id, {
        processing_status: 'error',
        error_message: `Could not extract text from ${item.mime_type} file. ${item.mime_type.startsWith('image/') ? 'OCR failed or produced no text.' : 'Unsupported file format for text extraction.'}`,
      });
      console.log(`  Skipped ${item.file_name}: no text extracted`);
      return;
    }

    // Try to guess supplier from filename for better example matching
    let guessedSupplier = null;
    const supplierMatch = item.file_name.match(/^[\(\d\)\s]*([A-Za-z][A-Za-z\s&.]+?)[\s-]+(COA|BOL|SDS|cert|lot|spec)/i);
    if (supplierMatch) {
      guessedSupplier = supplierMatch[1].trim();
    }

    // Fetch few-shot examples for this tenant/doctype
    let examples = [];
    try {
      examples = await fetchExtractionExamples(item.tenant_id, item.document_type_id, guessedSupplier);
      if (examples.length > 0) {
        console.log(`  Using ${examples.length} few-shot example(s) for prompt`);
      }
    } catch {
      // Non-critical — continue without examples
    }

    // Fetch reviewer-authored natural-language instructions and learned
    // Phase 3 preferences for this (supplier, document_type) pair. Resolves
    // supplier_id once via the same heuristic both helpers need. Both fall
    // back to no-ops on missing inputs / failure — extraction must always
    // proceed. See migration 0035 + /api/extraction-instructions and
    // /api/learned-preferences.
    let reviewerInstructions = '';
    let learnedPreferences = null;
    let resolvedSupplierIdForLearning = null;
    // The model id the router ACTUALLY served for this document's text path
    // (set by runTextQwen). Posted as result_body.text_model — the text-path
    // mirror of the existing vlm_model column.
    let servedTextModel = null;
    // Tenant-level extraction context (the editable "industry layer"). Fetched
    // once per item; when null the prompt builders fall back to the hardcoded
    // dairy default. Combo reviewer instructions still stack on top of this.
    const tenantContext = await fetchTenantContext(item.tenant_id);
    try {
      const supplierName = item.supplier || guessedSupplier || null;
      resolvedSupplierIdForLearning = await resolveSupplierIdByName(item.tenant_id, supplierName);
      if (!resolvedSupplierIdForLearning) {
        console.log(
          `  Reviewer instructions: no supplier match for "${supplierName || '(none)'}" ` +
          `— skipping instructions + learned hints`
        );
      } else {
        // Note: item.document_type_id may be null here (it's promoted only
        // AFTER extraction). We pass it through anyway — the API falls back
        // to supplier-wide guidance when no doctype is supplied.
        reviewerInstructions = await fetchReviewerInstructions(
          item.tenant_id,
          resolvedSupplierIdForLearning,
          item.document_type_id
        );
        if (reviewerInstructions) {
          console.log(
            `  Reviewer instructions loaded: ${reviewerInstructions.length} chars ` +
            `(supplier="${supplierName}" id=${resolvedSupplierIdForLearning}, ` +
            `doctype=${item.document_type_id || 'unresolved→supplier-wide'})`
          );
        } else {
          console.log(
            `  Reviewer instructions: none on file for supplier="${supplierName}" ` +
            `id=${resolvedSupplierIdForLearning} (doctype=${item.document_type_id || 'unresolved'})`
          );
        }
        learnedPreferences = await fetchLearnedPreferences(
          item.tenant_id,
          resolvedSupplierIdForLearning,
          item.document_type_id
        );
        if (learnedPreferences && Object.keys(learnedPreferences.fields || {}).length > 0) {
          console.log(
            `  Learned preferences loaded: ${Object.keys(learnedPreferences.fields).length} field(s) ` +
            `(supplier=${supplierName}, doctype=${item.document_type_id})`
          );
        }
      }
    } catch (err) {
      console.warn(`  Reviewer instructions: lookup failed (non-critical): ${err.message}`);
    }

    // Helper: call the text-path model with a single chunk of document text.
    // Returns a `parsed` object or throws. The model is resolved per call from
    // the `best` preference chain against what the router says is healthy.
    async function runTextQwen(llmText) {
      let qwenData;
      const failedModels = new Set();
      let requestedModel = null;
      for (let attempt = 1; attempt <= 2; attempt++) {
        try {
          requestedModel = await pickModel('best', failedModels);
          const controller = new AbortController();
          const timeout = setTimeout(() => controller.abort(), 1_800_000); // 30 min
          const qwenRes = await fetch(`${QWEN_URL}/v1/chat/completions`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              ...(QWEN_SECRET ? { Authorization: `Bearer ${QWEN_SECRET}` } : {}),
            },
            signal: controller.signal,
            dispatcher: llmDispatcher,
            body: JSON.stringify({
              model: requestedModel,
              temperature: 0,
              max_tokens: 16384,
              messages: [
                {
                  role: 'system',
                  content: prependFilenameHint(
                    prependAttentionBias(
                      prependReviewerInstructions(buildPrompt(examples, tenantContext), reviewerInstructions),
                      learnedPreferences
                    ),
                    item.file_name
                  ),
                },
                {
                  role: 'user',
                  content: `<document>\n${llmText}\n</document>\n\nExtract ALL structured data from this document. Return JSON only. /no_think`,
                },
              ],
            }),
          });
          clearTimeout(timeout);
          if (!qwenRes.ok) {
            const errText = await qwenRes.text().catch(() => '');
            throw new Error(`Qwen HTTP ${qwenRes.status}: ${errText.substring(0, 200)}`);
          }
          qwenData = await qwenRes.json();
          break;
        } catch (err) {
          invalidateModelCache(process.env);
          if (requestedModel) failedModels.add(requestedModel);
          if (attempt === 2) throw new Error(`Qwen call failed: ${err.message}`);
          console.warn(`  Qwen retry ${attempt}/2 for ${item.file_name}: ${err.message}`);
          if (isModelUnavailableError(err.message)) {
            console.warn(`  Model "${requestedModel}" unavailable; trying the next in the chain`);
          } else {
            console.warn('  Waiting 60s for model to load...');
            await new Promise(r => setTimeout(r, 60_000));
          }
        }
      }
      // Capture what actually served this chunk — persisted as text_model.
      servedTextModel = noteServedModel('best', requestedModel, qwenData.model);
      lastServedTextModel = servedTextModel;
      const content = qwenData.choices?.[0]?.message?.content || '';
      console.log(`  Qwen response (${content.length} chars): ${content.substring(0, 200)}...`);
      return parseExtraction(content);
    }

    // Shadow-mode capture of the raw per-chunk parses + their page ranges so
    // processCoaItem can run mergeCoaRecords() AFTER extraction. Populated by
    // runTextPath() on every branch (single-call, single-chunk, multi-chunk,
    // truncation fallback). Only read when COA_RECORDS_MODE !== 'off'.
    let coaRecordsCapture = { parsedChunks: [], chunkPageRanges: [], truncated: false };

    // Dispatcher: route to either the legacy 6K-truncation single-call path
    // (single-page docs, OCR fallbacks, image-OCR — byte-identical to pre-
    // chunking behavior) or the multi-page chunker. Returns a `parsed`
    // object. Used by BOTH the primary text path and the VLM-primary
    // fallback path so multi-page docs never silently drop pages 3+.
    async function runTextPath() {
      // Single-page (or single-string) fast path: identical behavior to
      // the pre-chunking worker — same 6K truncation, same single Qwen
      // call, same log output, same parsed shape.
      if (pages.length <= 1) {
        const llmText = text.substring(0, 6000);
        const parsed1 = await runTextQwen(llmText);
        coaRecordsCapture = { parsedChunks: [parsed1], chunkPageRanges: [[1]], truncated: false };
        return parsed1;
      }

      // PAGE-FIRST chunking: one chunk per PAGE (never grouped). Each page is
      // a self-sufficient single-page COA = one product; running one call per
      // page is what prevents the v1 collapse (model returning only one product
      // and dropping the rest). A page too large for one call is sub-chunked but
      // its sub-chunks stay tagged with the same page number so they recombine
      // into that one page's product.
      let pageChunks = buildPerPageChunks(pages);

      // Empty chunks would only happen if every page was whitespace; treat
      // like the single-page fast path against `text` (which already has
      // whatever signal there is).
      if (pageChunks.length === 0) {
        const llmText = text.substring(0, 6000);
        const parsed0 = await runTextQwen(llmText);
        coaRecordsCapture = { parsedChunks: [parsed0], chunkPageRanges: [[1]], truncated: false };
        return parsed0;
      }

      // Hard cap on distinct PAGES (not chunks). A COA bundle can have many
      // pages; the cap is generous (TEXT_MAX_PAGES_COA). If a doc somehow
      // exceeds it, process the first N pages and LOG that pages were dropped —
      // never silently truncate the bundle into one call.
      const distinctPages = [...new Set(pageChunks.map((c) => c.page))];
      if (distinctPages.length > TEXT_MAX_PAGES_COA) {
        const keptPages = new Set(distinctPages.slice(0, TEXT_MAX_PAGES_COA));
        const droppedPages = distinctPages.filter((p) => !keptPages.has(p));
        console.warn(
          `  Per-page COA: ${distinctPages.length} pages exceeds cap ${TEXT_MAX_PAGES_COA} — ` +
          `processing pages ${[...keptPages].join(',')} and DROPPING pages ${droppedPages.join(',')}`
        );
        pageChunks = pageChunks.filter((c) => keptPages.has(c.page));
      }

      // Single-chunk fast path (a one-page doc reaching here, e.g. a multi-page
      // PDF where only one page had text): one Qwen call, return parsed
      // directly. The records payload is still assembled from coaRecordsCapture.
      if (pageChunks.length === 1) {
        const parsedS = await runTextQwen(pageChunks[0].chunk);
        coaRecordsCapture = {
          parsedChunks: [parsedS],
          chunkPageRanges: [[pageChunks[0].page]],
          truncated: false,
        };
        return parsedS;
      }

      // Per-page path — one Qwen call per page. Each call sees ONE page = ONE
      // product; mergeCoaRecords concatenates them with NO cross-page merge.
      console.log(`  Per-page COA: ${distinctPages.length} page(s) → ${pageChunks.length} call(s)`);
      const parsedChunks = [];
      for (let i = 0; i < pageChunks.length; i++) {
        console.log(`  Qwen call ${i + 1}/${pageChunks.length} (page ${pageChunks[i].page}, ${pageChunks[i].chunk.length} chars)`);
        parsedChunks.push(await runTextQwen(pageChunks[i].chunk));
      }
      coaRecordsCapture = {
        parsedChunks,
        chunkPageRanges: pageChunks.map((c) => [c.page]),
        truncated: false,
      };
      // Flat merge still drives ai_fields/tables (unchanged). The records
      // payload is assembled separately from coaRecordsCapture in shadow mode.
      return mergeTextExtractions(parsedChunks);
    }

    // ===== VLM dual-run dispatcher =====
    // In 'off' mode:     only the text path runs (unchanged legacy behavior).
    // In 'dual' mode:    text path is primary, VLM runs in parallel after and
    //                    its result is saved to the vlm_* columns for review.
    // In 'vlm' mode:     VLM is primary; skip the text Qwen call entirely.
    //                    On VLM failure, fall back to the text path.
    let parsed;
    let vlmResult = null;   // always holds the VLM output (or null)
    let vlmError = null;    // stringified VLM error (if any)
    let vlmDurationMs = null;
    let vlmStartedAt = null;

    // Helper: run VLM, time it, capture error. Never throws.
    async function runVlmSafe() {
      const vlmStart = Date.now();
      vlmStartedAt = new Date().toISOString();
      try {
        const res = await extractWithVLM(
          fileBufferForVlm,
          prependAttentionBias(
            prependReviewerInstructions(buildVlmPrompt(examples, tenantContext), reviewerInstructions),
            learnedPreferences
          ),
          'Extract all structured data from the document image(s). Return JSON only.',
          item.file_name
        );
        vlmDurationMs = Date.now() - vlmStart;
        // Canonicalize VLM fields the same way as text-path fields.
        const canonicalizedVlm = canonicalizeFields(res.fields || {});
        if (canonicalizedVlm.supplier_name && isLikelyAddress(canonicalizedVlm.supplier_name)) {
          canonicalizedVlm.supplier_name = null;
        }
        // Strip null / empty / whitespace-only padding the VLM tends to emit
        // for canonical fields it didn't actually see in the image.
        res.fields = compactFields(canonicalizedVlm);
        console.log(`  VLM done: ${res.pageCount} page(s), ${Object.keys(res.fields).length} fields, ${((vlmDurationMs) / 1000).toFixed(1)}s`);
        return res;
      } catch (err) {
        vlmDurationMs = Date.now() - vlmStart;
        vlmError = err.message || String(err);
        console.warn(`  VLM failed: ${vlmError}`);
        return null;
      }
    }

    const canRunVlm = QWEN_VLM_MODE !== 'off' && item.mime_type === 'application/pdf';

    // Canonicalize a VLM result into the same `parsed` shape the text path
    // produces. Shared by pass 1 and the post-extraction re-extract below so
    // both passes go through identical normalization.
    const parsedFromVlm = (res) => ({
      fields: res.fields,
      tables: res.tables,
      products: res.products,
      summary: res.summary,
      confidence: res.confidence,
      documentType: res.documentType,
    });
    // Canonicalize text-path fields in place (mutates the parsed object).
    const canonicalizeTextParsed = (p) => {
      const canonicalized = canonicalizeFields(p.fields || {});
      if (canonicalized.supplier_name && isLikelyAddress(canonicalized.supplier_name)) {
        canonicalized.supplier_name = null;
      }
      p.fields = compactFields(canonicalized);
      return p;
    };

    // Which extraction routine produced the primary `parsed`? The
    // post-extraction re-extract (two-pass instruction application) reuses the
    // SAME routine so cost/behavior are unchanged aside from the new prompt.
    // 'vlm'  → re-run runVlmSafe(); 'text' → re-run runTextPath().
    let primaryPath = null;

    if (QWEN_VLM_MODE === 'vlm' && canRunVlm) {
      // VLM-primary mode: run VLM first, fall back to text on failure.
      vlmResult = await runVlmSafe();
      if (vlmResult) {
        parsed = parsedFromVlm(vlmResult);
        primaryPath = 'vlm';
      } else {
        console.log('  VLM primary failed — falling back to text path');
        parsed = canonicalizeTextParsed(await runTextPath());
        primaryPath = 'text';
      }
    } else {
      // 'off' or 'dual' mode: text path is primary.
      parsed = canonicalizeTextParsed(await runTextPath());
      primaryPath = 'text';

      // In dual mode, now run VLM and capture its separate result.
      if (QWEN_VLM_MODE === 'dual' && canRunVlm) {
        console.log('  Running VLM dual-pass...');
        vlmResult = await runVlmSafe();
      }
    }

    // ===== Two-pass reviewer-instruction application =====
    // Pass 1 (above) only applied reviewer instructions when the supplier was
    // known UPFRONT (item.supplier or a filename match). Manual imports with
    // date-only filenames (e.g. "5-27-26 CREAM HG.pdf") carry no supplier, so
    // resolveSupplierIdByName() returned null and `reviewerInstructions` stayed
    // empty — the model extracted UNGUIDED even though it then identified the
    // supplier (e.g. "ANDERSEN DAIRY INC."). Now that pass 1 resolved a
    // supplier_name, re-resolve the supplier and, if guidance exists that
    // wasn't already in the pass-1 prompt, re-extract ONCE with it applied.
    //
    // Hard guard: at most one re-extraction (no loops) — only when instructions
    // are actually found. Most docs already had instructions (or have none),
    // so this is zero extra cost: exactly one Qwen call as today. A second call
    // happens only when a known-instruction supplier is detected late.
    if (!reviewerInstructions) {
      try {
        // parsed.fields.supplier_name is already canonicalized + address-
        // stripped by pass 1's canonicalize step, matching how the existing
        // code derives the supplier name.
        const lateSupplierName = parsed.fields?.supplier_name || null;
        const lateSupplierId = await resolveSupplierIdByName(item.tenant_id, lateSupplierName);
        if (lateSupplierId) {
          const lateInstructions = await fetchReviewerInstructions(
            item.tenant_id,
            lateSupplierId,
            item.document_type_id
          );
          if (lateInstructions && lateInstructions.trim()) {
            console.log(
              `  Re-extracting with reviewer instructions for supplier ` +
              `"${lateSupplierName}" (resolved post-extraction): ` +
              `${lateInstructions.length} chars`
            );
            // Promote the late-resolved supplier for learned-preference capture
            // and feed the guidance into the (lexically-closed-over) prompt
            // builders used by runTextPath()/runVlmSafe().
            reviewerInstructions = lateInstructions;
            if (!resolvedSupplierIdForLearning) {
              resolvedSupplierIdForLearning = lateSupplierId;
            }
            // Re-run the SAME path that produced the primary parsed, with the
            // instructions now in scope. Exactly one re-extraction.
            if (primaryPath === 'vlm') {
              const reVlm = await runVlmSafe();
              if (reVlm) {
                vlmResult = reVlm;
                parsed = parsedFromVlm(reVlm);
              } else {
                console.warn('  Re-extract (VLM) failed — keeping pass-1 result');
              }
            } else {
              parsed = canonicalizeTextParsed(await runTextPath());
            }
          }
        }
      } catch (err) {
        // Best-effort: a failed re-extraction must never block posting the
        // pass-1 result.
        console.warn(`  Post-extraction instruction re-extract failed (non-critical): ${err.message}`);
      }
    }

    const supplier = parsed.fields?.supplier_name || null;

    // Compute confidence score (on primary path only)
    const confidenceScore = computeConfidenceScore(parsed.confidence, parsed.fields || {}, parsed.tables || []);

    // Resolve document type if AI guessed one and queue item has no doc type set.
    // Only PROMOTE (write document_type_id) on an exact name/slug match —
    // substring / acronym hits are still recorded in document_type_guess for
    // the reviewer to confirm but won't silently rewrite the queue row.
    let resolvedDocTypeId = item.document_type_id || null;
    let docTypeMatchType = null;
    const docTypeGuess = parsed.documentType || null;

    if (docTypeGuess && !resolvedDocTypeId) {
      try {
        const match = await fuzzyMatchDocType(docTypeGuess, item.tenant_id);
        if (match) {
          docTypeMatchType = match.matchType;
          if (match.matchType === 'exact') {
            resolvedDocTypeId = match.id;
            console.log(
              `  Doctype promoted: guess="${docTypeGuess}" matched doctype ${match.id} (exact)`
            );
          } else {
            console.log(
              `  Doctype guess matched doctype ${match.id} (${match.matchType}) — leaving document_type_id null for reviewer to confirm`
            );
          }
        }
      } catch (err) {
        console.warn(`  Doc type matching failed:`, err.message);
      }
    }

    // Post results
    const resultBody = {
      processing_status: 'ready',
      extracted_text: text.substring(0, 100000),
      ai_fields: JSON.stringify(parsed.fields || {}),
      ai_confidence: parsed.confidence || 'low',
      confidence_score: confidenceScore,
      // Doc-R1: LLM self-rated numeric confidence (0..1, null if absent).
      // Distinct from confidence_score (the deterministic heuristic). This
      // is the signal the auto-approve gate compares against the tenant
      // threshold. See migration 0062 + functions/api/queue/[id]/results.ts.
      confidence: parsed.confidenceNum,
      product_names: JSON.stringify(parsed.products || []),
      tables: JSON.stringify(parsed.tables || []),
      summary: parsed.summary || '',
      supplier: supplier,
      document_type_guess: docTypeGuess,
    };

    if (resolvedDocTypeId && !item.document_type_id) {
      resultBody.document_type_id = resolvedDocTypeId;
    }

    // Anti-silent-degradation: record WHICH text model actually produced this
    // extraction, including quantization. Mirrors resultBody.vlm_model below.
    // Backends flap and quantization materially changes correctness, so every
    // extraction must be self-describing for later grading / parity runs.
    if (servedTextModel) {
      resultBody.text_model = servedTextModel;
    }

    // Attach VLM columns when VLM ran (success or failure).
    if (canRunVlm && (vlmResult || vlmError)) {
      // Served model when the call got that far, otherwise the model we
      // resolved and attempted; null only when resolution itself failed.
      resultBody.vlm_model = lastVlmModel;
      resultBody.vlm_duration_ms = vlmDurationMs;
      resultBody.vlm_extracted_at = vlmStartedAt;
      if (vlmResult) {
        resultBody.vlm_extracted_fields = JSON.stringify(vlmResult.fields || {});
        resultBody.vlm_extracted_tables = JSON.stringify(vlmResult.tables || []);
        // Map high/medium/low to a numeric for vlm_confidence (REAL column).
        resultBody.vlm_confidence =
          vlmResult.confidence === 'high' ? 0.9 :
          vlmResult.confidence === 'medium' ? 0.6 : 0.3;
        resultBody.vlm_error = null;
      } else {
        resultBody.vlm_extracted_fields = null;
        resultBody.vlm_extracted_tables = null;
        resultBody.vlm_confidence = null;
        resultBody.vlm_error = vlmError;
      }
    }

    // Phase 3: attach learned_field_hints sidecar from the Phase 2 capture
    // tables. Only fields with confidence >= 0.8 graduate; the UI uses these
    // to pre-fill values + render a "from N past reviews" badge.
    const learnedHints = buildLearnedFieldHints(learnedPreferences);
    if (learnedHints) {
      resultBody.learned_field_hints = JSON.stringify(learnedHints);
    }

    // Phase 3: per-field uncertainty payload — heuristic + dual-mode
    // disagreement. UI sorts >= 0.7 fields under a "needs your eyes" banner.
    // In 'vlm' primary mode parsed.fields IS vlmResult.fields — feed only
    // one side so we don't compare the same payload to itself.
    const dualSidesDistinct = QWEN_VLM_MODE === 'dual' && vlmResult && vlmResult.fields;
    const uncertainty = computeUncertaintyPayload(
      parsed.fields || {},
      dualSidesDistinct ? vlmResult.fields : {}
    );
    if (Object.keys(uncertainty).length > 0) {
      resultBody.uncertainty = JSON.stringify(uncertainty);
    }

    // ===== Multi-record COA (shadow mode) =====
    // Assemble the per-chunk extractions into a CoaRecordsPayload and, when the
    // doc GENUINELY carries >= 2 records, post it as ai_records ALONGSIDE the
    // flat ai_fields/tables above. Single-record docs post EXACTLY as today (no
    // ai_records) so the common case is byte-identical. The flat result
    // (mergeTextExtractions) still drives ai_fields regardless. P1 treats
    // 'shadow' and 'on' identically for posting; the review/approve wiring that
    // consumes ai_records is P3/P4. coaRecordsCapture is only populated when the
    // text path ran (it doesn't run in VLM-primary success); when empty we post
    // exactly as today.
    if (COA_RECORDS_MODE !== 'off' && coaRecordsCapture.parsedChunks.length > 0) {
      try {
        const recordsPayload = mergeCoaRecords(
          coaRecordsCapture.parsedChunks,
          coaRecordsCapture.chunkPageRanges,
          { truncated: coaRecordsCapture.truncated }
        );
        if (recordsPayload.records.length >= 2) {
          resultBody.ai_records = JSON.stringify(recordsPayload);
          console.log(
            `  COA records (${COA_RECORDS_MODE}): ${recordsPayload.records.length} records ` +
            `(${recordsPayload.record_cardinality}/${recordsPayload.record_key_basis}) — posting ai_records`
          );
        }
      } catch (recErr) {
        // Shadow assembly must NEVER fail the post. Fall through with flat-only.
        console.warn(`  COA records assembly failed (non-critical): ${recErr.message}`);
      }
    }

    await postResults(item.id, resultBody);

    const elapsed = ((Date.now() - startTime) / 1000).toFixed(1);
    console.log(`  Done: ${item.file_name} (${Math.round(confidenceScore * 100)}% confidence, ${elapsed}s)`);
  } catch (err) {
    console.error(`  Error processing ${item.file_name}:`, err.message);
    await postResults(item.id, {
      processing_status: 'error',
      error_message: err.message,
    }).catch(() => {});
  }
}

// === Field canonicalization ===

const FIELD_ALIASES = {
  supplier_name: ['supplier', 'vendor', 'manufacturer', 'company', 'from', 'shipped_by'],
  customer_name: ['customer', 'sold_to', 'ship_to', 'buyer', 'consignee'],
  lot_number: ['lot_no', 'lot_num', 'lot', 'batch_number', 'batch_no', 'batch', 'run_number', 'lot_code'],
  // D1: the sublot qualifies the lot and is its own field. Every spelling the
  // model emits must land on the single canonical `sub_lot_code` so the flat
  // path can carry it (and so recordsFromPage / computeRecordLotKey see it).
  sub_lot_code: ['sub_lot_number', 'sub_lot_no', 'sub_lot', 'sublot', 'sublot_code', 'sublot_number', 'sub_lot_num'],
  po_number: ['po', 'purchase_order', 'purchase_order_number', 'po_no'],
  product_name: ['product', 'item', 'material', 'description', 'item_description'],
  product_code: ['item_code', 'sku', 'material_code', 'item_number', 'item_no'],
  expiration_date: ['exp_date', 'best_by', 'use_by', 'best_before', 'sell_by', 'bb_date'],
  code_date: ['production_date', 'pack_date', 'mfg_date', 'manufacture_date', 'date_of_manufacture'],
  ship_date: ['shipping_date', 'date_shipped'],
  net_weight: ['weight', 'net_wt'],
  order_number: ['order_no', 'sales_order', 'reference_number', 'ref_number'],
  grade: ['quality_grade', 'usda_grade'],
  plant_number: ['plant_no', 'facility_number', 'facility_id', 'plant_id'],
};

function canonicalizeFields(fields) {
  const reverseMap = {};
  for (const [canonical, aliases] of Object.entries(FIELD_ALIASES)) {
    for (const alias of aliases) {
      reverseMap[alias] = canonical;
    }
  }
  const result = {};
  for (const [key, value] of Object.entries(fields)) {
    const canonical = reverseMap[key] || key;
    if (!(canonical in result) || result[canonical] == null) {
      result[canonical] = value;
    }
  }
  return result;
}

// === Address detection ===

function isLikelyAddress(value) {
  if (!value || typeof value !== 'string') return false;
  const v = value.trim();
  const streetPattern = /^\d+\s+(N\.?|S\.?|E\.?|W\.?|North|South|East|West|Main)\b/i;
  const unitStreetPattern = /^[A-Z0-9#]+\s+\d+\s+\w/i;
  const stateZipPattern = /\b[A-Z]{2}\s+\d{5}(-\d{4})?\b/;
  const streetSuffixes = /\b(Street|St\.?|Avenue|Ave\.?|Boulevard|Blvd\.?|Road|Rd\.?|Drive|Dr\.?|Lane|Ln\.?|Way|Court|Ct\.?|Place|Pl\.?)\b/i;
  if ((streetPattern.test(v) || unitStreetPattern.test(v)) && (stateZipPattern.test(v) || streetSuffixes.test(v))) {
    return true;
  }
  if (stateZipPattern.test(v) && streetSuffixes.test(v)) {
    return true;
  }
  return false;
}

// === Garbled text detection ===

function isTextGarbled(text) {
  if (!text || text.length < 100) return false;
  const words = text.split(/\s+/).filter(w => w.length > 0);
  if (words.length === 0) return false;
  const avgWordLen = words.reduce((s, w) => s + w.length, 0) / words.length;
  const whitespaceRatio = (text.match(/\s/g) || []).length / text.length;
  // Long average words + low whitespace = column-merged garbage from bad PDF extraction
  return avgWordLen > 15 || whitespaceRatio < 0.08;
}

// === Document type fuzzy matching ===

/**
 * Fuzzy-match a free-form document type guess against the tenant's catalog.
 * Returns { id, matchType } where matchType is one of:
 *   - 'exact'     — guess matches a doctype name or slug after normalization
 *   - 'substring' — guess is contained in (or contains) a doctype name
 *   - 'acronym'   — guess is the initialism of a multi-word doctype name
 * Returns null when no candidate is found. Callers should only auto-promote
 * the queue item's document_type_id on 'exact' — substring/acronym hits are
 * informative but not safe to commit unattended.
 */
async function fuzzyMatchDocType(guess, tenantId) {
  const res = await fetch(
    `${DOX_API_URL}/api/document-types?tenant_id=${encodeURIComponent(tenantId)}&active=1`,
    { headers }
  );
  if (!res.ok) return null;

  const data = await res.json();
  const docTypes = data.documentTypes || [];
  if (docTypes.length === 0) return null;

  const normalize = (s) => s.toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
  const guessNorm = normalize(guess);

  // Exact name/slug match
  for (const dt of docTypes) {
    if (normalize(dt.name) === guessNorm || dt.slug === guessNorm.replace(/\s+/g, '-')) {
      return { id: dt.id, matchType: 'exact' };
    }
  }

  // Substring match (either direction)
  for (const dt of docTypes) {
    const dtNorm = normalize(dt.name);
    if (guessNorm.includes(dtNorm) || dtNorm.includes(guessNorm)) {
      return { id: dt.id, matchType: 'substring' };
    }
  }

  // Acronym match: "COA" matches "Certificate of Analysis"
  for (const dt of docTypes) {
    const dtNorm = normalize(dt.name);
    const acronym = dtNorm.split(' ').map(w => w[0]).join('');
    if (acronym === guessNorm || guessNorm === acronym) {
      return { id: dt.id, matchType: 'acronym' };
    }
  }

  return null;
}

// === Prompt (same content as functions/lib/llm.ts) ===

const BASE_PROMPT = `You are a document data extraction assistant specializing in supply chain and compliance documents including Certificates of Analysis (COAs), Bills of Lading, Spec Sheets, Safety Data Sheets, and invoices.

DOCUMENT TYPES:
- Certificate of Analysis (COA): Lab/QA results proving a product batch meets specifications. Structure: header info (supplier, customer, dates, lot) + test results table + approval.
- Bill of Lading (BOL): Shipping document with carrier, origin, destination, weights.
- Spec Sheet: Product specification with allowable ranges for tests.
- Invoice / PO: Purchase order or invoice with line items, quantities, prices.
- Safety Data Sheet (SDS): Chemical safety information.

FIELD EXTRACTION RULES:
1. Use these EXACT canonical field names (snake_case):
   - supplier_name — company/organization that PRODUCED, TESTED, or SHIPPED the product. This is typically the company on the letterhead, the lab that ran the tests, or the "From" entity. NOT the customer/recipient. If only an address is visible with no company name, look for the company name in: letterhead, "Approved by" signatures, facility name, or document footer. Set to null only if truly unidentifiable.
   - customer_name — company RECEIVING the product. Often labeled "Ship To", "Customer", "Sold To", or "Attention". If a company name appears prominently but is clearly the recipient (e.g., appears after "Ship To:"), it is the customer, NOT the supplier.
   - product_name — full product name (e.g., "Unsalted Sweet Cream Butter 68#")
   - product_code — supplier's internal product/item code or SKU
   - lot_number — lot, batch, or run number
   - sub_lot_code — the sub-lot code that QUALIFIES lot_number (labels: "Sub Lot Number", "Sub Lot", "Sublot", "SL"). Usually 2 digits. It is a SEPARATE field: never concatenate it into lot_number and never drop it. Extract it whenever the page prints one — INCLUDING when the page has only ONE lot and ONE sublot. A lot number without its sublot does not identify the material.
   - po_number — purchase order number
   - code_date — production/pack/code date
   - expiration_date — expiration, best-by, use-by, or sell-by date
   - ship_date — date shipped
   - grade — quality grade (e.g., "Grade A", "Grade AA", "US Extra")
   - plant_number — facility ID or plant number
   - net_weight — net weight with units
   - order_number — sales order or reference number

2. For dates: normalize to YYYY-MM-DD. Two-digit years mean 2000s (e.g., '26 = 2026, 03/08/26 = 2026-03-08). Julian dates (e.g., "6094") mean day 094 of 2026 — convert when identifiable. If ambiguous, keep as-is.

3. DO NOT include: addresses, phone/fax/email, page numbers, print dates, header/footer boilerplate, signatures, titles, disclaimers, individual test values (those go in tables).

4. FILENAME CONTEXT: The filename hint (<filename_hint> in the system prompt) is provided ONLY for supplier identification context. NEVER extract lot_number, code_date, production_date, expiration_date, product_code, or sub_lot_number from the filename. If those values aren't in the document body, return null.

5. SUPPLIER vs CUSTOMER: A common error is confusing supplier and customer. The supplier PRODUCES the product; the customer RECEIVES it. If "MEDOSWEET FARMS" appears after "Ship To:", it is the customer_name, not the supplier_name. The company at the TOP of the document (letterhead, header) is usually the supplier.

TABLE EXTRACTION RULES:
1. Extract ALL tabular data found in the document. Preserve every column present — do not drop columns.
2. Name tables descriptively: "test_results", "line_items", "physical_properties", "microbiological_analysis", "sensory_analysis", etc.
3. Use the column headers exactly as they appear in the document. If no headers exist, infer them from context.
4. For COA test results, common columns include: test, test_method, unit_of_measure, specification, result, units, pass_fail — but extract whatever columns are present.
5. Preserve units (CFU/mL, %, mg/kg, etc.) and pass/fail values as written.
6. Multiple distinct tables in the document → separate entries for each (e.g., physical tests and microbiological tests should be separate tables).
7. Keep row order as it appears in the document.

OCR / SCANNED DOCUMENT HANDLING:
- If text appears garbled, do your best but set _confidence appropriately low
  (e.g. 0.3-0.5). Common OCR errors: l↔1, O↔0, rn↔m. Infer correct values from
  context. Partially readable values: include what you can and append "(?)".

CONFIDENCE CALIBRATION:
- ALWAYS emit \`_confidence\` at the top level — a single number between 0.0
  and 1.0 reflecting how sure you are about the extraction as a whole.
  Calibration:
    1.0  — every required field was unambiguously present in the source.
    0.9  — minor uncertainty (one optional field guessed).
    0.7  — the threshold below which a human will review. Use this when a
           required field was inferred rather than read directly (e.g. you
           split a composite cell), a label was non-standard, the source
           format was unusual, or OCR garbled the text in spots.
    0.5  — a required field was guessed from limited context.
    0.0  — you fabricated a value; the source did not actually contain this.
  Be honest. A low confidence flag a human can investigate is FAR better
  than fabricating a high-confidence record.

Return JSON with:
{
  "fields": { ... },
  "tables": [{ "name": "string", "headers": [...], "rows": [[...]] }],
  "products": ["product name 1", ...],
  "summary": "one-sentence description",
  "_confidence": 0.0-1.0,
  "document_type": "Certificate of Analysis" | "Bill of Lading" | etc.
}

SINGLE-PAGE COA — ONE PRODUCT (records, additive — keep emitting the flat fields/tables/products/_confidence above for back-compat):
The input you are given is ONE complete single-page COA for ONE product (it has its own full header: supplier, item#, lot#, plant, date). Extract that one product and ALL of its lots/sublots as a "records" array — ONE record per lot/sublot. A single lot → exactly one record. Do NOT invent more than one product; there is only one product on this page.
{
  "records": [
    {
      "fields": { "lot_code": "...", "sub_lot_code": "...", "product_name": "...", "product_code": "...", "expiration_date": "...", ... },
      "tables": [ ...this lot/sublot's own test-result table(s)... ],
      "groups": { "yeast_mold": { ... }, "sensory": { ... } }
    }
  ],
  "record_cardinality": "single" | "multi_lot",
  "record_key_basis": "lot" | "lot+sublot",
  "page_metadata": { ...fields CONSTANT across every record on THIS page (e.g. supplier_name, product_name, product_code, coa_number, manufacturer)... }
}
RULES for records:
- This page is ONE product. Emit ONE record PER LOT and PER SUBLOT of that product. If the product has 4 sublots, that is 4 records (record_key_basis "lot+sublot"). If it has exactly one lot, that is one record (record_cardinality "single").
- SUBLOTS ARE OFTEN COLUMNS IN A TRANSPOSED MATRIX. A "Sub Lot Number" (or "Sublot") row lists the sublot codes left-to-right, e.g. "Sub Lot Number 14 13 12", and each following test/attribute row (Butterfat, Moisture, pH, Weight, Quantity, Production Date, ...) gives that row's value for each sublot in the SAME left-to-right column order. When you see this, emit ONE record PER SUBLOT COLUMN: read DOWN each column to collect that sublot's value for every test. The lot_code is usually shared across all columns; each column's "Sub Lot Number" value is that record's sub_lot_code. Do NOT collapse a multi-column sublot matrix into one flat record.
- Put fields that vary between this page's lots/sublots in each record's "fields"; put fields constant across them (including this page's product) in "page_metadata". Do not duplicate constant fields into every record.
- This is ONE page of what may be a larger PO/EDI bundle of single-page COAs — extract ONLY this page's product. The assembler concatenates pages; it NEVER merges your records with another page's, so do not worry about other pages.
- Specs verbatim, never derive pass/fail, lab consumables are never product data — the same domain rules as above apply inside each record.
- Omit "records" ONLY when the page has exactly ONE lot AND ONE sublot (a single result). In THAT case you MUST still report the sublot in the FLAT "sub_lot_code" field — the flat field set has a sub_lot_code slot precisely so a single-sublot page never loses it. A printed sublot code is NEVER optional: it goes in records[].fields.sub_lot_code when you emit records, and in the flat sub_lot_code when you do not. If there are MULTIPLE sublots — even all under the same lot number — you MUST emit one record per sublot; never collapse multiple sublots into flat fields.`;

const DAIRY_FOOD_INDUSTRY_PROMPT = `
ORG CONTEXT:
[Describe your organization and what these documents are for — edit this. e.g. "We are a dairy distributor managing supplier Certificates of Analysis for regulatory compliance. Lot traceability is critical; every document must be tied to a lot."]

INDUSTRY CONTEXT — Dairy & Food:
- Common COA tests: Standard Plate Count (SPC), coliform, E. coli, yeast & mold, somatic cell count, butterfat %, moisture %, pH, acidity, temperature
- Grade designations: Grade A, Grade AA, US Extra, USDA grades
- Plant/facility numbers: USDA plant numbers (e.g., "Plant 42-1234")
- Code dates may use Julian format (YDDD where Y=last digit of year, DDD=day)
- Net weights: common units are lbs, gallons, kg

DAIRY COA DOMAIN RULES (hard rules — follow exactly):
- Lab consumables are NEVER product data. Reagent / control / buffer lot numbers (e.g. 3M Petrifilm CC/AC/BUFFER lots and their expirations), dilution rows, plate-incubation tables, and incubator temperatures must never be bound to a product field. A reagent lot mistaken for the product's lot is the single worst error.
- Certification / legal boilerplate numbers are reference, not results. Numbers inside raw-milk certification clauses or regulatory citations (e.g. "standard plate count 100,000 per ml", "somatic cell 400,000 per ml") are reference thresholds, NOT this product's measured values. Do not extract them as results.
- Capture specifications verbatim; NEVER derive pass/fail. Copy the spec string exactly as printed. Leave pass/fail empty unless the document itself prints an explicit verdict — the human decides conformance.
- Result is not the spec. When a table has Spec and Result columns, the measured value is the Result; never report the spec/limit as the result.
- Lot is the most important field and keys every record. If there is no explicit lot label but a CODE DATE / DATE CODE is present, it may serve as the lot — capture it as the lot, and also keep it in its own date field.
- A missing required pathogen result (Listeria, Salmonella) is a GAP, not a pass — return null; do not infer absence.
- Capture yeast/mold and sensory (flavor / color / odor) exactly as printed — never auto-combine, split, or collapse them.
- Normalize dates to YYYY-MM-DD; when numeric order is genuinely ambiguous (e.g. 03/04/26 could be Mar or Apr), keep as-is rather than guess.

EXAMPLE — Dairy COA extraction:
Input: "Darigold Inc. COA for Grade AA Butter 68#, Lot L26-0842, PO PO-44821, Packed 03/15/26, Best By 09/15/26, Plant 42-1234. Tests: Fat >80% result 81.2% Pass, Moisture <16% result 15.4% Pass, Coliform <10 CFU/g result <1 Pass, SPC <20000 CFU/g result 4500 Pass"

Output:
{
  "fields": {
    "supplier_name": "Darigold Inc.",
    "product_name": "Grade AA Butter 68#",
    "lot_number": "L26-0842",
    "po_number": "PO-44821",
    "code_date": "2026-03-15",
    "expiration_date": "2026-09-15",
    "grade": "Grade AA",
    "plant_number": "42-1234",
    "net_weight": "68 lbs"
  },
  "tables": [{
    "name": "test_results",
    "headers": ["test", "test_method", "specification", "result", "units", "pass_fail"],
    "rows": [
      ["Fat Content", "SMEDP 15.122", ">80%", "81.2", "%", "Pass"],
      ["Moisture", "SMEDP 15.122", "<16%", "15.4", "%", "Pass"],
      ["Coliform", "AOAC 989.10", "<10", "<1", "CFU/g", "Pass"],
      ["Standard Plate Count", "AOAC 989.10", "<20,000", "4,500", "CFU/g", "Pass"]
    ]
  }],
  "products": ["Grade AA Butter 68#"],
  "summary": "COA for Darigold Grade AA Butter lot L26-0842, all tests pass.",
  "_confidence": 0.95,
  "document_type": "Certificate of Analysis"
}`;

function buildPrompt(examples = [], tenantContext = null) {
  let prompt = BASE_PROMPT + '\n\n' + (tenantContext || DAIRY_FOOD_INDUSTRY_PROMPT);

  if (examples.length > 0) {
    prompt += '\n\nPREVIOUS CORRECTIONS FOR THIS SUPPLIER/DOCUMENT TYPE:';
    prompt += '\nLearn from these past corrections. The "corrected" output is what the human verified as correct.\n';

    for (const ex of examples) {
      const inputSnippet = (ex.input_text || '').substring(0, 500);
      const corrected = ex.corrected_output || ex.ai_output || '{}';

      prompt += `\nExample input (truncated):\n${inputSnippet}\n`;
      prompt += `Corrected extraction:\n${corrected}\n`;
    }

    prompt += '\nUse these examples to guide your extraction. Match the field names and formatting from the corrections.';
  }

  return prompt;
}

// === VLM (Vision-Language Model) dual-run helpers ===
//
// These render PDF pages to PNG via unpdf and send them as an OpenAI-style
// multimodal chat completion to a Qwen2.5-VL model served at QWEN_URL.
// Text path remains the primary source of truth in 'dual' mode; VLM results
// are saved alongside for human side-by-side review in the UI.

/**
 * Render up to `maxPages` pages of a PDF to PNG buffers via unpdf.
 * Throws if the PDF exceeds the page cap (VRAM on the 10GB GPU is tight
 * and each 1500x2000 page costs real tokens).
 * Returns an array of { pageNumber, png } objects.
 */
async function renderPdfPagesToPng(pdfBuffer, maxPages) {
  const { getDocumentProxy, renderPageAsImage } = await import('unpdf');

  // getDocumentProxy may detach the underlying ArrayBuffer, so make a copy
  // for the numPages read and a fresh copy per renderPageAsImage call.
  const probe = new Uint8Array(pdfBuffer.slice(0));
  const pdf = await getDocumentProxy(probe);
  const numPages = pdf.numPages;

  if (numPages > maxPages) {
    throw new Error(
      `VLM skipped: PDF has ${numPages} pages, exceeds cap of ${maxPages}`
    );
  }

  const pages = [];
  for (let n = 1; n <= numPages; n++) {
    try {
      // scale: 2.0 produces roughly 1500x2000+ px for a US Letter page.
      // renderPageAsImage returns a Uint8Array of PNG bytes.
      // canvasImport is required in Node — unpdf ships no default canvas.
      const pngBytes = await renderPageAsImage(
        new Uint8Array(pdfBuffer.slice(0)),
        n,
        { scale: 2.0, canvasImport: () => import('@napi-rs/canvas') }
      );
      const png = Buffer.from(pngBytes);

      // Safety check for the 2x2-pixel minimum that crashes llama.cpp with
      // GGML_ASSERT (see Windows GPU infra step 1 for the original crash).
      // A real rendered page is always thousands of bytes; anything tiny
      // here means the renderer silently produced a garbage image.
      if (png.length < 100) {
        throw new Error(
          `VLM skipped: page ${n} produced a ${png.length}-byte PNG (likely < 2x2 pixels)`
        );
      }

      pages.push({ pageNumber: n, png });
    } catch (err) {
      // Wrap so the caller knows which page failed.
      throw new Error(`VLM render failed on page ${n}: ${err.message}`);
    }
  }

  return pages;
}

/**
 * Build the VLM-flavored system prompt.
 * Same output schema as the text-path prompt so downstream parsing,
 * canonicalization, and confidence scoring work unchanged, but with
 * VLM-specific rules that lean on the model's ability to read the image
 * directly (no OCR garble to worry about).
 */
function buildVlmPrompt(examples = [], tenantContext = null) {
  const VLM_HEADER = `You are a document data extraction assistant looking at an IMAGE of the document (no OCR text — you read the pixels directly).

VLM-SPECIFIC RULES:
- You are looking at an image of the document. Read each column by its physical position on the page.
- Extract values column-by-column, left-to-right, preserving column boundaries.
- Never merge or infer values from adjacent columns.
- Customer names do NOT end in numbers — strip trailing digits that bleed in from weight/count columns. If you see "ACME FOODS 705" the name is "ACME FOODS".
- When a header row and a data row are visually aligned, trust the alignment — do not shift values sideways.
- If a cell is blank in the image, leave the field null. Do NOT fabricate values from neighboring columns.

DOCUMENT TYPES:
- Certificate of Analysis (COA): Lab/QA results proving a product batch meets specifications. Structure: header info (supplier, customer, dates, lot) + test results table + approval.
- Bill of Lading (BOL): Shipping document with carrier, origin, destination, weights.
- Spec Sheet: Product specification with allowable ranges for tests.
- Invoice / PO: Purchase order or invoice with line items, quantities, prices.
- Safety Data Sheet (SDS): Chemical safety information.

FIELD EXTRACTION RULES:
1. Use these EXACT canonical field names (snake_case):
   - supplier_name — company/organization that PRODUCED, TESTED, or SHIPPED the product. Typically on the letterhead, the lab that ran the tests, or the "From" entity. NOT the customer/recipient. If only an address is visible with no company name, look for the company name in: letterhead, "Approved by" signatures, facility name, or document footer. Set to null only if truly unidentifiable.
   - customer_name — company RECEIVING the product. Often labeled "Ship To", "Customer", "Sold To", or "Attention". Strip trailing digits (see VLM rules above).
   - product_name — full product name (e.g., "Unsalted Sweet Cream Butter 68#")
   - product_code — supplier's internal product/item code or SKU
   - lot_number — lot, batch, or run number
   - sub_lot_code — the sub-lot code that QUALIFIES lot_number (labels: "Sub Lot Number", "Sub Lot", "Sublot", "SL"). Usually 2 digits. It is a SEPARATE field: never concatenate it into lot_number and never drop it. Extract it whenever the page prints one — INCLUDING when the page has only ONE lot and ONE sublot.
   - po_number — purchase order number. ONLY populate if an explicit "PO", "P.O.", or "Purchase Order" label is visible in the image. Do NOT infer or fabricate from adjacent columns.
   - code_date — production/pack/code date
   - expiration_date — expiration, best-by, use-by, or sell-by date
   - ship_date — date shipped
   - grade — quality grade (e.g., "Grade A", "Grade AA", "US Extra")
   - plant_number — facility ID or plant number
   - net_weight — net weight with units
   - order_number — sales order or reference number

2. For dates: normalize to YYYY-MM-DD. Two-digit years mean 2000s (e.g., '26 = 2026, 03/08/26 = 2026-03-08). Julian dates (e.g., "6094") mean day 094 of 2026 — convert when identifiable. If ambiguous, keep as-is.

3. DO NOT include: addresses, phone/fax/email, page numbers, print dates, header/footer boilerplate, signatures, titles, disclaimers, individual test values (those go in tables).

4. FILENAME CONTEXT: The filename hint (<filename_hint> in the system prompt) is provided ONLY for supplier identification context. NEVER extract lot_number, code_date, production_date, expiration_date, product_code, or sub_lot_number from the filename. If those values aren't in the image body, return null.

5. SUPPLIER vs CUSTOMER: A common error is confusing supplier and customer. The supplier PRODUCES the product; the customer RECEIVES it. The company at the TOP of the document (letterhead, header) is usually the supplier.

TABLE EXTRACTION RULES:
1. Extract ALL tabular data visible in the image. Preserve every column present — do not drop columns.
2. Name tables descriptively: "test_results", "line_items", "physical_properties", "microbiological_analysis", etc.
3. Use the column headers exactly as they appear visually. If no headers exist, infer them from context.
4. For COA test results, common columns include: test, test_method, unit_of_measure, specification, result, units, pass_fail.
5. Preserve units (CFU/mL, %, mg/kg, etc.) and pass/fail values as written.
6. Multiple distinct tables in the image → separate entries for each.
7. Keep row order as it appears visually.

CONFIDENCE CALIBRATION:
- ALWAYS emit \`_confidence\` at the top level — a single number between 0.0
  and 1.0 reflecting how sure you are about the extraction as a whole.
  Calibration:
    1.0  — every required field was unambiguously present in the image.
    0.9  — minor uncertainty (one optional field guessed).
    0.7  — the threshold below which a human will review. Use this when a
           required field was inferred rather than read directly (e.g. you
           split a composite cell), the label was non-standard, the layout
           was unusual, or the image was hard to read in places.
    0.5  — a required field was guessed from limited context.
    0.0  — you fabricated a value; the image did not actually contain this.
  Be honest. A low confidence flag a human can investigate is FAR better
  than fabricating a high-confidence record.

Return JSON with:
{
  "fields": { ... },
  "tables": [{ "name": "string", "headers": [...], "rows": [[...]] }],
  "products": ["product name 1", ...],
  "summary": "one-sentence description",
  "_confidence": 0.0-1.0,
  "document_type": "Certificate of Analysis" | "Bill of Lading" | etc.
}`;

  let prompt = VLM_HEADER + '\n\n' + (tenantContext || DAIRY_FOOD_INDUSTRY_PROMPT);

  if (examples.length > 0) {
    prompt += '\n\nPREVIOUS CORRECTIONS FOR THIS SUPPLIER/DOCUMENT TYPE:';
    prompt += '\nLearn from these past corrections. The "corrected" output is what the human verified as correct.\n';

    for (const ex of examples) {
      const inputSnippet = (ex.input_text || '').substring(0, 500);
      const corrected = ex.corrected_output || ex.ai_output || '{}';
      prompt += `\nExample input (truncated):\n${inputSnippet}\n`;
      prompt += `Corrected extraction:\n${corrected}\n`;
    }

    prompt += '\nUse these examples to guide your extraction. Match the field names and formatting from the corrections.';
  }

  return prompt;
}

/**
 * Extract structured fields from a PDF via the Qwen VLM (vision) model.
 * Renders each page to PNG, sends them all in a single multimodal
 * chat-completion request, parses the JSON response with parseExtraction().
 *
 * Throws on any failure — callers handle fallback to the text path.
 */
async function extractWithVLM(pdfBuffer, systemPrompt, userPrompt, fileName) {
  // Resolve BEFORE rendering pages so a dead vision chain fails fast and the
  // caller falls back to the text path without burning a PDF render.
  lastVlmModel = null;
  const vlmModel = await pickVlmModel();
  lastVlmModel = vlmModel;

  const pages = await renderPdfPagesToPng(pdfBuffer, QWEN_VLM_MAX_PAGES);

  const userContent = [
    { type: 'text', text: userPrompt },
  ];
  for (const p of pages) {
    userContent.push({
      type: 'image_url',
      image_url: { url: `data:image/png;base64,${p.png.toString('base64')}` },
    });
  }

  const payload = {
    model: vlmModel,
    temperature: 0.1,
    max_tokens: 8192,
    messages: [
      { role: 'system', content: prependFilenameHint(systemPrompt, fileName) },
      { role: 'user', content: userContent },
    ],
  };

  // Same retry/timeout pattern as the text-path Qwen call.
  let qwenData;
  let lastErr;
  for (let attempt = 1; attempt <= 2; attempt++) {
    try {
      const controller = new AbortController();
      const timeout = setTimeout(() => controller.abort(), 1_800_000); // 30 min
      const qwenRes = await fetch(`${QWEN_URL}/v1/chat/completions`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          ...(QWEN_SECRET ? { Authorization: `Bearer ${QWEN_SECRET}` } : {}),
        },
        signal: controller.signal,
        dispatcher: llmDispatcher,
        body: JSON.stringify(payload),
      });
      clearTimeout(timeout);
      if (!qwenRes.ok) {
        const errText = await qwenRes.text().catch(() => '');
        throw new Error(`VLM HTTP ${qwenRes.status}: ${errText.substring(0, 200)}`);
      }
      qwenData = await qwenRes.json();
      break;
    } catch (err) {
      lastErr = err;
      if (attempt === 2) throw new Error(`VLM call failed: ${err.message}`);
      console.warn(`  VLM retry ${attempt}/2: ${err.message}`);
      await new Promise(r => setTimeout(r, 60_000));
    }
  }

  // Record what the router ACTUALLY served (quantization included) rather than
  // what we asked for — the whole point of the provenance columns.
  lastVlmModel = noteServedModel('vision', vlmModel, qwenData && qwenData.model);

  const content = qwenData?.choices?.[0]?.message?.content || '';
  if (!content) {
    throw new Error(`VLM returned empty response${lastErr ? ` (last error: ${lastErr.message})` : ''}`);
  }

  const parsed = parseExtraction(content);
  return {
    fields: parsed.fields || {},
    tables: parsed.tables || [],
    products: parsed.products || [],
    summary: parsed.summary || '',
    confidence: parsed.confidence || 'low',
    documentType: parsed.documentType || null,
    pageCount: pages.length,
  };
}

// === Response parser (same logic as functions/lib/llm.ts) ===

function parseExtraction(content) {
  content = (content || '').trim();

  // Strip Qwen3 <think>...</think> blocks (thinking model artifacts)
  content = content.replace(/<think>[\s\S]*?<\/think>\s*/g, '').trim();

  // Strip markdown code fences
  const fenceMatch = content.match(/^```(?:json)?\s*\n?([\s\S]*?)\n?\s*```$/);
  if (fenceMatch) {
    content = fenceMatch[1].trim();
  }

  let parsed;
  try {
    parsed = JSON.parse(content);
  } catch {
    return { fields: {}, tables: [], products: [], summary: '', confidence: 'low' };
  }

  const products = Array.isArray(parsed.products) ? parsed.products : [];
  // _confidence may be either:
  //   - a number in [0, 1] (new Doc-R1 calibration) — preferred
  //   - one of 'high' / 'medium' / 'low' (legacy)
  // We always derive both a numeric value (confidenceNum, may be null) and
  // a legacy bucket string (confidence) so the existing downstream code
  // (ai_confidence column, confidence-bucket heuristic) keeps working
  // unchanged. The numeric value is what flows to the auto-approve gate.
  let confidenceNum = null;
  let confidence = 'low';
  if (typeof parsed._confidence === 'number' && isFinite(parsed._confidence)) {
    confidenceNum = Math.max(0, Math.min(1, parsed._confidence));
    confidence = confidenceNum >= 0.8 ? 'high' : confidenceNum >= 0.5 ? 'medium' : 'low';
  } else if (typeof parsed._confidence === 'string') {
    const v = parsed._confidence.toLowerCase();
    if (v === 'high' || v === 'medium' || v === 'low') {
      confidence = v;
      // Coarse mapping so the auto-approve gate still has SOMETHING usable
      // when an older model output the legacy string form.
      confidenceNum = v === 'high' ? 0.9 : v === 'medium' ? 0.6 : 0.3;
    }
  }
  const tables = Array.isArray(parsed.tables) ? parsed.tables : [];
  const summary = typeof parsed.summary === 'string' ? parsed.summary : '';
  const documentType = typeof parsed.document_type === 'string' ? parsed.document_type : null;

  // Multi-record COA shape (optional — older / single-product responses won't
  // carry these). Passed through untouched for mergeCoaRecords() to assemble
  // across chunks; the flat fields/tables above still drive ai_fields.
  const records = Array.isArray(parsed.records) ? parsed.records : null;
  const recordCardinality =
    typeof parsed.record_cardinality === 'string' ? parsed.record_cardinality : null;
  const recordKeyBasis =
    typeof parsed.record_key_basis === 'string' ? parsed.record_key_basis : null;
  const pageMetadata =
    parsed.page_metadata && typeof parsed.page_metadata === 'object' && !Array.isArray(parsed.page_metadata)
      ? parsed.page_metadata
      : null;

  // Build fields.
  //
  // Three shapes arrive here:
  //   1. { fields: {...} }            — the documented shape; use it verbatim.
  //   2. { records: [...], page_metadata: {...} } with NO flat `fields` block —
  //      a records-only response. Reconstruct the flat view the SAME way the
  //      records producer does (page_metadata ∪ record.fields, record wins) so
  //      ai_fields is not empty. A single-record page gives a faithful flat
  //      view; a multi-record page contributes page_metadata only, because a
  //      flat view of several different lots would be a lie.
  //   3. anything else                — legacy: treat the top level as fields.
  //
  // The records keys are RESERVED in every branch: before this they fell into
  // case 3 and were stringified into ai_fields as literal "[object Object]".
  const fields = {};
  const reservedKeys = new Set([
    'fields', 'tables', 'products', 'summary', '_confidence', 'document_type',
    'records', 'record_cardinality', 'record_key_basis', 'page_metadata',
  ]);
  let rawFields;
  if (typeof parsed.fields === 'object' && parsed.fields !== null && !Array.isArray(parsed.fields)) {
    rawFields = parsed.fields;
  } else if (pageMetadata || (records && records.length > 0)) {
    const soleRecordFields =
      records && records.length === 1 && records[0] &&
      typeof records[0].fields === 'object' && records[0].fields !== null &&
      !Array.isArray(records[0].fields)
        ? records[0].fields
        : {};
    rawFields = { ...(pageMetadata || {}), ...soleRecordFields };
  } else {
    rawFields = parsed;
  }

  for (const [key, value] of Object.entries(rawFields)) {
    if (key.startsWith('_') || reservedKeys.has(key)) continue;
    // Never stringify a nested object/array into a scalar field — that is what
    // produced "[object Object]" values. Structured data belongs in tables /
    // records, not in the flat field map.
    if (typeof value === 'object' && value !== null) continue;
    fields[key] = value === undefined || value === null ? null : String(value);
  }

  return {
    fields: flattenFields(fields),
    tables,
    products,
    summary,
    confidence,
    confidenceNum,
    documentType,
    // Multi-record COA passthrough (null when the model didn't emit them).
    records,
    recordCardinality,
    recordKeyBasis,
    pageMetadata,
  };
}

// === Flatten nested objects/arrays in extracted fields ===

function flattenFields(fields) {
  const result = {};
  for (const [key, value] of Object.entries(fields)) {
    if (value === null || value === undefined) {
      result[key] = null;
    } else if (typeof value === 'string' || typeof value === 'number' || typeof value === 'boolean') {
      result[key] = String(value);
    } else if (Array.isArray(value)) {
      // If array of simple values, join them
      if (value.every(v => typeof v === 'string' || typeof v === 'number')) {
        result[key] = value.join(', ');
      } else {
        // Complex array — stringify it
        result[key] = JSON.stringify(value);
      }
    } else if (typeof value === 'object') {
      // Flatten nested object: { customer: { name: "ACME", city: "LA" } }
      // becomes: { customer_name: "ACME", customer_city: "LA" }
      for (const [subKey, subValue] of Object.entries(value)) {
        if (subValue !== null && subValue !== undefined) {
          result[`${key}_${subKey}`] = typeof subValue === 'object' ? JSON.stringify(subValue) : String(subValue);
        }
      }
    }
  }
  return result;
}

// === Confidence score (same logic as functions/lib/confidence.ts) ===

function computeConfidenceScore(aiConfidence, extractedFields, tables = []) {
  // Lower base weights — LLM self-assessment is unreliable
  let score = aiConfidence === 'high' ? 0.85 : aiConfidence === 'medium' ? 0.55 : 0.25;

  const fields = extractedFields || {};
  const nonNullFields = Object.entries(fields).filter(([, v]) => v != null && String(v).trim() !== '');

  // Bonus for finding data (up to +0.08)
  score += Math.min(nonNullFields.length * 0.01, 0.08);

  // Reward key document fields being present (+0.02 each, up to +0.06)
  const keyFields = ['supplier_name', 'product_name', 'lot_number'];
  for (const key of keyFields) {
    if (fields[key] != null && String(fields[key]).trim() !== '') {
      score += 0.02;
    }
  }

  // Reward having at least one date field (+0.02)
  const hasDate = Object.entries(fields).some(
    ([k, v]) => k.includes('date') && v != null && String(v).trim() !== ''
  );
  if (hasDate) score += 0.02;

  // Reward having test results table with actual rows (+0.03)
  const hasTestResults = tables.some(
    t => t.rows && t.rows.length > 0 && t.headers && t.headers.length > 0
  );
  if (hasTestResults) score += 0.03;

  // Penalize date fields that don't look like dates (-0.08 each)
  for (const [key, value] of Object.entries(fields)) {
    if (value && key.includes('date')) {
      const v = String(value);
      const looksLikeDate =
        /\d{4}[-/]\d{1,2}[-/]\d{1,2}/.test(v) ||
        /\d{1,2}[-/]\d{1,2}[-/]\d{2,4}/.test(v);
      if (!looksLikeDate) {
        score -= 0.08;
      }
    }
  }

  // Penalize very short lot numbers (-0.05)
  const lotValue = fields['lot_number'];
  if (lotValue && String(lotValue).trim().length < 3) {
    score -= 0.05;
  }

  // Penalize uncertainty markers (-0.05 each)
  for (const [, value] of nonNullFields) {
    if (String(value).includes('(?)')) {
      score -= 0.05;
    }
  }

  return Math.max(0, Math.min(1, score));
}

// =============================================================================
// PARITY DRY-RUN MODE (read-only) — see bin/parity-coa
// =============================================================================
//
// Activated ONLY when process.env.PARITY_ITEM_IDS is set (a comma-separated
// list of processing_queue item ids). When that env var is UNSET, control flow
// below is unchanged: the normal poller (`loop()`) runs exactly as it does in
// production. The guard sits immediately before the startup logs + loop() call
// so the byte-identical normal path is preserved.
//
// runParityMode RE-EXTRACTS each item through the CURRENT COA extraction
// sequence — mirroring processCoaItem's order/branches and calling the SAME
// module-level helpers (extractTextAndPages, fetchExtractionExamples,
// resolveSupplierIdByName, fetchReviewerInstructions, fetchLearnedPreferences,
// buildPrompt/buildVlmPrompt + the prepend chain, parseExtraction,
// canonicalizeFields, isLikelyAddress, compactFields, buildPageChunks,
// mergeTextExtractions, extractWithVLM). It NEVER claims the item (no
// processing_status flip) and NEVER POSTs results — it only GETs the item +
// its file, runs extraction, and prints the fresh `extracted_fields` (the same
// object the worker would have stored in the `ai_fields` column) to stdout.
//
// The text-path Qwen request below is reconstructed to be byte-identical to
// processCoaItem's nested runTextQwen (same model/temperature/max_tokens, same
// prepend chain, same user message, same parseExtraction). It is duplicated
// here ONLY because runTextQwen is a closure inside processCoaItem and cannot
// be called from the outside; the PROMPT/PARSE logic itself comes entirely
// from the shared helpers, not a rewrite.

async function fetchQueueItem(id) {
  const res = await fetch(`${DOX_API_URL}/api/queue/${encodeURIComponent(id)}`, { headers });
  if (!res.ok) {
    const text = await res.text().catch(() => '');
    throw new Error(`GET /api/queue/${id} failed: ${res.status} ${text.substring(0, 160)}`);
  }
  const data = await res.json();
  if (!data || !data.item) throw new Error(`GET /api/queue/${id}: no item in response`);
  return data.item;
}

async function runParityMode() {
  const ids = (process.env.PARITY_ITEM_IDS || '')
    .split(',')
    .map(s => s.trim())
    .filter(Boolean);

  console.error(`[parity] read-only re-extraction of ${ids.length} item(s)`);
  console.error(`[parity] API=${DOX_API_URL} Qwen=${QWEN_URL} VLM=${QWEN_VLM_MODE}`);

  for (const id of ids) {
    try {
      const item = await fetchQueueItem(id);

      // ---- Download the file (read-only GET) ----
      const fileBuffer = await downloadQueueFile(item);
      // Copies: unpdf detaches the ArrayBuffer it's given (matches processCoaItem).
      const fileBufferCopy = fileBuffer.slice(0);
      const fileBufferForVlm = fileBuffer.slice(0);

      // ---- Text + pages extraction (SAME branches as processCoaItem) ----
      // extractTextAndPages is the shared extractor whose PDF/OCR/text/CSV/
      // XLSX/DOCX/image branches are line-for-line identical to the COA path's
      // inline extractor; reusing it keeps the parity run faithful without
      // duplicating that block.
      const { text, pages } = await extractTextAndPages(item, fileBuffer, fileBufferCopy);

      if (!text || text.trim().length === 0) {
        process.stdout.write(JSON.stringify({
          id,
          error: `no text extracted from ${item.mime_type}`,
        }) + '\n');
        continue;
      }

      // ---- Supplier guess + examples + reviewer instructions + learned prefs
      // (mirrors processCoaItem's pass-1 resolution exactly) ----
      let guessedSupplier = null;
      const supplierMatch = (item.file_name || '').match(
        /^[\(\d\)\s]*([A-Za-z][A-Za-z\s&.]+?)[\s-]+(COA|BOL|SDS|cert|lot|spec)/i
      );
      if (supplierMatch) guessedSupplier = supplierMatch[1].trim();

      let examples = [];
      try {
        examples = await fetchExtractionExamples(item.tenant_id, item.document_type_id, guessedSupplier);
      } catch { /* non-critical */ }

      let reviewerInstructions = '';
      let learnedPreferences = null;
      let resolvedSupplierIdForLearning = null;
      // Tenant-level extraction context (editable "industry layer"); null →
      // prompt builders fall back to the hardcoded dairy default. Combo reviewer
      // instructions still stack on top of this.
      const tenantContext = await fetchTenantContext(item.tenant_id);
      try {
        const supplierName = item.supplier || guessedSupplier || null;
        resolvedSupplierIdForLearning = await resolveSupplierIdByName(item.tenant_id, supplierName);
        if (resolvedSupplierIdForLearning) {
          reviewerInstructions = await fetchReviewerInstructions(
            item.tenant_id, resolvedSupplierIdForLearning, item.document_type_id
          );
          learnedPreferences = await fetchLearnedPreferences(
            item.tenant_id, resolvedSupplierIdForLearning, item.document_type_id
          );
        }
      } catch { /* non-critical */ }

      // ---- Local Qwen text caller — byte-identical request to runTextQwen ----
      // (see header note: closure can't be reused; prompt/parse come from the
      // shared helpers).
      const runTextQwen = async (llmText) => {
        let qwenData;
        const failedModels = new Set();
        let requestedModel = null;
        for (let attempt = 1; attempt <= 2; attempt++) {
          try {
            requestedModel = await pickModel('best', failedModels);
            const controller = new AbortController();
            const timeout = setTimeout(() => controller.abort(), 1_800_000);
            const qwenRes = await fetch(`${QWEN_URL}/v1/chat/completions`, {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                ...(QWEN_SECRET ? { Authorization: `Bearer ${QWEN_SECRET}` } : {}),
              },
              signal: controller.signal,
              dispatcher: llmDispatcher,
              body: JSON.stringify({
                model: requestedModel,
                temperature: 0,
                max_tokens: 16384,
                messages: [
                  {
                    role: 'system',
                    content: prependFilenameHint(
                      prependAttentionBias(
                        prependReviewerInstructions(buildPrompt(examples, tenantContext), reviewerInstructions),
                        learnedPreferences
                      ),
                      item.file_name
                    ),
                  },
                  {
                    role: 'user',
                    content: `<document>\n${llmText}\n</document>\n\nExtract ALL structured data from this document. Return JSON only. /no_think`,
                  },
                ],
              }),
            });
            clearTimeout(timeout);
            if (!qwenRes.ok) {
              const errText = await qwenRes.text().catch(() => '');
              throw new Error(`Qwen HTTP ${qwenRes.status}: ${errText.substring(0, 200)}`);
            }
            qwenData = await qwenRes.json();
            break;
          } catch (err) {
            invalidateModelCache(process.env);
            if (requestedModel) failedModels.add(requestedModel);
            if (attempt === 2) throw new Error(`Qwen call failed: ${err.message}`);
            if (!isModelUnavailableError(err.message)) {
              await new Promise(r => setTimeout(r, 60_000));
            }
          }
        }
        lastServedTextModel = noteServedModel('best', requestedModel, qwenData.model);
        const content = qwenData.choices?.[0]?.message?.content || '';
        return parseExtraction(content);
      };

      // ---- Text-path dispatcher: same chunking branches as runTextPath ----
      const runTextPath = async () => {
        if (pages.length <= 1) return await runTextQwen(text.substring(0, 6000));
        const chunks = buildPageChunks(pages);
        if (chunks.length === 0) return await runTextQwen(text.substring(0, 6000));
        if (chunks.length > TEXT_MAX_CHUNKS) return await runTextQwen(text.substring(0, 6000));
        if (chunks.length === 1) return await runTextQwen(chunks[0]);
        const parsedChunks = [];
        for (let i = 0; i < chunks.length; i++) {
          parsedChunks.push(await runTextQwen(chunks[i]));
        }
        return mergeTextExtractions(parsedChunks);
      };

      // ---- Canonicalization helpers — identical to processCoaItem ----
      const canonicalizeTextParsed = (p) => {
        const canonicalized = canonicalizeFields(p.fields || {});
        if (canonicalized.supplier_name && isLikelyAddress(canonicalized.supplier_name)) {
          canonicalized.supplier_name = null;
        }
        p.fields = compactFields(canonicalized);
        return p;
      };
      const parsedFromVlm = (res) => ({
        fields: res.fields, tables: res.tables, products: res.products,
        summary: res.summary, confidence: res.confidence, documentType: res.documentType,
      });

      const canRunVlm = QWEN_VLM_MODE !== 'off' && item.mime_type === 'application/pdf';
      const runVlmSafe = async () => {
        try {
          const res = await extractWithVLM(
            fileBufferForVlm,
            prependAttentionBias(
              prependReviewerInstructions(buildVlmPrompt(examples, tenantContext), reviewerInstructions),
              learnedPreferences
            ),
            'Extract all structured data from the document image(s). Return JSON only.',
            item.file_name
          );
          const canonicalizedVlm = canonicalizeFields(res.fields || {});
          if (canonicalizedVlm.supplier_name && isLikelyAddress(canonicalizedVlm.supplier_name)) {
            canonicalizedVlm.supplier_name = null;
          }
          res.fields = compactFields(canonicalizedVlm);
          return res;
        } catch {
          return null;
        }
      };

      // ---- Primary extraction (same VLM-mode branches as processCoaItem) ----
      let parsed;
      let primaryPath = null;
      if (QWEN_VLM_MODE === 'vlm' && canRunVlm) {
        const vlmResult = await runVlmSafe();
        if (vlmResult) { parsed = parsedFromVlm(vlmResult); primaryPath = 'vlm'; }
        else { parsed = canonicalizeTextParsed(await runTextPath()); primaryPath = 'text'; }
      } else {
        parsed = canonicalizeTextParsed(await runTextPath());
        primaryPath = 'text';
        // 'dual' mode runs VLM too, but it does NOT alter the primary `parsed`
        // (it only fills vlm_* columns), so for the ai_fields parity compare we
        // skip the extra dual VLM call.
      }

      // ---- Two-pass reviewer-instruction re-extract (same guard/branch) ----
      if (!reviewerInstructions) {
        try {
          const lateSupplierName = parsed.fields?.supplier_name || null;
          const lateSupplierId = await resolveSupplierIdByName(item.tenant_id, lateSupplierName);
          if (lateSupplierId) {
            const lateInstructions = await fetchReviewerInstructions(
              item.tenant_id, lateSupplierId, item.document_type_id
            );
            if (lateInstructions && lateInstructions.trim()) {
              reviewerInstructions = lateInstructions;
              if (primaryPath === 'vlm') {
                const reVlm = await runVlmSafe();
                if (reVlm) parsed = parsedFromVlm(reVlm);
              } else {
                parsed = canonicalizeTextParsed(await runTextPath());
              }
            }
          }
        } catch { /* non-critical */ }
      }

      // ---- Print the fresh extraction. `extracted_fields` matches the object
      // processCoaItem posts as ai_fields (JSON.stringify(parsed.fields)). ----
      process.stdout.write(JSON.stringify({
        id,
        extracted_fields: parsed.fields || {},
        // Which model + quantization actually produced this parity result, so
        // a grading pass can never be silently scored against the wrong one.
        text_model: lastServedTextModel,
      }) + '\n');
    } catch (err) {
      process.stdout.write(JSON.stringify({
        id,
        error: err && err.message ? err.message : String(err),
      }) + '\n');
    }
  }
}

// === Main loop ===

// PARITY GUARD: when PARITY_ITEM_IDS is set, do the read-only dry-run and exit
// WITHOUT starting the poller. When unset, control falls through to the normal
// startup + loop() below, byte-identical to production.
if (process.env.PARITY_ITEM_IDS) {
  runParityMode()
    .then(() => process.exit(0))
    .catch((err) => {
      console.error('[parity] fatal:', err && err.message ? err.message : err);
      process.exit(1);
    });
  return;
}


// =============================================================================
// Model preflight
// =============================================================================

/**
 * Resolve every model tag this worker will use and log the outcome plainly:
 * which model each tag landed on, and whether that was a downgrade from the
 * chain's first choice.
 *
 * Policy: NEVER abort just because we are on a lower tier — a degraded model
 * beats no processing. Abort only when a chain is ENTIRELY unavailable (the
 * router answered and none of the chain's entries have a healthy upstream),
 * because then every extraction would fail one at a time anyway.
 *
 * If the router itself is unreachable the probe result is "unknown", not
 * "empty": we log that and start anyway, since per-call resolution will pick
 * the right model as soon as the router answers.
 */
async function preflightModels() {
  // 'vision' only matters when the VLM path can run.
  const tags = ['best'];
  if (QWEN_VLM_MODE !== 'off') tags.push('vision');

  console.log('  Models:');
  const failures = [];
  for (const tag of tags) {
    // 'vision' resolves against VLM_ENV so a QWEN_VLM_MODEL pin is reported
    // here exactly like any other override instead of as a separate knob.
    const tagEnv = tag === 'vision' ? VLM_ENV : process.env;
    const chain = chainFor(tag, tagEnv);
    try {
      const res = await resolveModel(tag, tagEnv, { force: true });
      if (res.source === 'override') {
        const via = tag === 'vision' && QWEN_VLM_MODEL_PIN
          ? 'QWEN_VLM_MODEL'
          : `QWEN_MODEL_${tag.toUpperCase()}`;
        console.log(`    ${tag}: ${res.model}  (PINNED via ${via})`);
      } else if (res.source === 'unverified') {
        console.warn(
          `    ${tag}: ${res.model}  (UNVERIFIED — ${QWEN_URL}/v1/models did not answer; ` +
          `will attempt chain ${chain.join(' > ')})`
        );
      } else if (res.degraded) {
        console.warn(
          `    ${tag}: ${res.model}  (DEGRADED — wanted ${res.preferred}; ` +
          `chain ${chain.join(' > ')})`
        );
      } else {
        console.log(`    ${tag}: ${res.model}  (best available)`);
      }
    } catch (err) {
      failures.push(`${tag}: ${err.message}`);
      console.error(`    ${tag}: UNAVAILABLE — ${err.message}`);
    }
  }
  if (failures.length > 0) {
    console.error('');
    console.error('Error: no usable model for tag(s) — refusing to start.');
    for (const f of failures) console.error(`  ${f}`);
    process.exit(1);
  }
}

console.log(`Dox process worker started`);
console.log(`  API: ${DOX_API_URL}`);
console.log(`  Qwen: ${QWEN_URL}`);
console.log(`  VLM mode: ${QWEN_VLM_MODE}${QWEN_VLM_MODE !== 'off' ? ` (model=${QWEN_VLM_MODEL_PIN || `vision chain: ${chainFor('vision', VLM_ENV).join(' > ')}`}, max_pages=${QWEN_VLM_MAX_PAGES})` : ''}`);
console.log(`  Poll interval: ${POLL_INTERVAL / 1000}s`);

// Self-scheduling loop with exponential backoff on consecutive failures.
// Backoff doubles on each failure (POLL_INTERVAL, 2x, 4x, ...) capped at 5
// minutes, and resets to POLL_INTERVAL on the next successful poll. This
// prevents the worker from hammering the API (and burning CF requests) when
// /api/queue starts returning errors in a loop.
let consecutiveFailures = 0;
const MAX_BACKOFF_MS = 5 * 60 * 1000;
async function loop() {
  let success = false;
  try {
    success = await poll();
  } catch (err) {
    // poll() already catches internally, but belt-and-suspenders in case a
    // future change lets something slip through.
    console.error(`[worker] poll threw (attempt ${consecutiveFailures + 1}):`, err?.message || err);
    success = false;
  }
  if (success) {
    consecutiveFailures = 0;
  } else {
    consecutiveFailures++;
  }
  const backoff = consecutiveFailures === 0
    ? POLL_INTERVAL
    : Math.min(POLL_INTERVAL * Math.pow(2, consecutiveFailures - 1), MAX_BACKOFF_MS);
  if (consecutiveFailures > 0) {
    console.warn(`[worker] next poll in ${(backoff / 1000).toFixed(0)}s (failure #${consecutiveFailures})`);
  }
  setTimeout(loop, backoff);
}

// Preflight the model tags BEFORE the first poll so a degraded (or entirely
// missing) backend is visible in the startup banner rather than discovered one
// failed extraction at a time.
preflightModels()
  .then(() => {
    console.log('');
    loop();
  })
  .catch((err) => {
    console.error('[worker] model preflight crashed:', err && err.message ? err.message : err);
    process.exit(1);
  });

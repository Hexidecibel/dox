#!/usr/bin/env node
/* eslint-disable no-console */
/**
 * bin/seed-doctype-extraction-instructions — starter guidance for the
 * DOCUMENT-TYPE layer of the extraction prompt stack (migration 0098), applied
 * to a tenant that ALREADY EXISTS.
 *
 * THE TEXTS ARE NOT IN THIS FILE. They live in starter-packs/fsqa.json, as
 * `document_types[].extraction_instructions`, and a new tenant gets them from
 * `bin/create-tenant`. This script is the path for a tenant created before the
 * pack carried them, or whose types were named by hand — which is why the
 * per-tenant NAME MATCHING stays here while the opinions do not.
 *
 * WHY A SCRIPT AND NOT A MIGRATION
 * --------------------------------
 * These are OPINIONS about how to read a document, not schema. A tenant is
 * meant to edit them, and a migration that overwrote an edited row on the next
 * deploy would be worse than no seed at all. So: run it once, deliberately, per
 * tenant — the same reason starter packs are rendered by bin/render-starter-pack
 * rather than applied by 0080.
 *
 * WHAT IT WRITES
 * --------------
 * One row per matched document type in `document_type_extraction_instructions`.
 * Eleven types, chosen because the incoming corpus is heaviest in them:
 * Certificate of Analysis, Certificate of Insurance, Letter of Guarantee,
 * Allergen Statement, Specification Sheet, Organic Certificate, Kosher
 * Certificate, Gluten-Free Certificate, 3rd Party Audit Certificate, Safety
 * Data Sheet, Country of Origin Statement.
 *
 * WHAT IT WILL NOT DO
 *   - Overwrite guidance somebody has already written. A type that already has
 *     a non-empty row is reported as "kept" and skipped. --overwrite forces it,
 *     knowingly.
 *   - Create a document type. A type the tenant does not have is reported and
 *     skipped: inventing one would put an unused type in the picker forever.
 *   - Write anything without --apply.
 *
 * WHAT THE TEXT MAY AND MAY NOT SAY
 * ---------------------------------
 * Every string in the pack describes WHERE a value sits and WHAT to pull out.
 * None of them tells the model what a page says. That boundary is not stylistic: TABLE
 * EXTRACTION RULE 14 ("never supply a unit, spec or verdict the document did not
 * print") exists because a result carrying an invented unit cannot be matched
 * against a configured limit and is dropped from spec checking with nobody
 * told. Guidance that reads as "results on this certificate are in ppm" would
 * hand the model exactly that licence, so where a threshold or unit is involved
 * these texts say "as printed" and say it explicitly.
 *
 * Usage:
 *   bin/seed-doctype-extraction-instructions --tenant <id>                  # dry run
 *   bin/seed-doctype-extraction-instructions --tenant <id> --apply          # LOCAL write
 *   bin/seed-doctype-extraction-instructions --tenant <id> --remote --apply # PROD
 *
 * Flags:
 *   --tenant ID    tenant to seed (required)
 *   --apply        actually write. Without it this is a dry run.
 *   --remote, -r   target PRODUCTION D1 (with --apply, prompts first)
 *   --overwrite    replace existing non-empty guidance too
 *   --sql          print the SQL it would run and exit
 *   -h, --help     this help
 */

const fs = require('fs');
const os = require('os');
const path = require('path');
const crypto = require('crypto');
const { execFileSync } = require('child_process');

const { query, PROJECT_ROOT, DEFAULT_DB } = require('./lib/d1');

/**
 * WHICH document types this script claims, and what it calls them.
 *
 * THE TEXTS THEMSELVES LIVE IN THE STARTER PACK, NOT HERE. They used to be
 * inlined below, which meant the pack and this script were two copies of the
 * same ten opinions, free to drift the moment one of them was edited. The pack
 * is now the single source: `starter-packs/fsqa.json` carries
 * `document_types[].extraction_instructions`, `bin/lib/starter-packs.mjs`
 * validates it, and both `bin/create-tenant` (for a NEW tenant) and this script
 * (for an EXISTING one) read the same string.
 *
 * WHAT STAYS HERE IS THE MATCHING. `match` is the list of document-type names
 * this entry claims in a REAL tenant, normalized before comparison — a live
 * tenant's types were named by a human, not by the pack ("Spec Sheet" vs
 * "Specification Sheet"), so the alias list is about that tenant and has no
 * business in the vocabulary. A type is claimed by the FIRST entry that matches
 * it, so the lists must not overlap.
 *
 * `pack_slug` is the document_types slug in starter-packs/fsqa.json. A slug
 * that is not in the pack, or is in the pack with no instructions, is a hard
 * error: silently seeding nine of ten types is how a tenant ends up with one
 * document type nobody can explain the extraction of.
 */
const PACK_FILE = path.join(PROJECT_ROOT, 'starter-packs', 'fsqa.json');

const PACK_ENTRIES = [
  {
    label: 'Certificate of Analysis',
    pack_slug: 'certificate-of-analysis',
    match: ['certificate of analysis', 'coa', 'c of a', 'certificate of analysis (coa)'],
  },
  {
    label: 'Certificate of Insurance',
    pack_slug: 'certificate-of-insurance',
    match: ['certificate of insurance', 'coi', 'insurance certificate'],
  },
  {
    label: 'Letter of Guarantee',
    pack_slug: 'letter-of-guarantee',
    match: ['letter of guarantee', 'continuing guarantee', 'guaranty letter'],
  },
  {
    label: 'Allergen Statement',
    pack_slug: 'allergen-statement',
    match: ['allergen statement', 'allergen declaration', 'allergen matrix'],
  },
  {
    label: 'Specification Sheet',
    pack_slug: 'specification-sheet',
    match: ['specification sheet', 'spec sheet', 'product specification'],
  },
  {
    label: 'Organic Certificate',
    pack_slug: 'organic-certificate',
    match: ['organic certificate', 'organic certification', 'nop certificate'],
  },
  {
    label: 'Kosher Certificate',
    pack_slug: 'kosher-certificate',
    match: ['kosher certificate', 'kosher certification', 'kosher letter'],
  },
  {
    label: 'Gluten-Free Certificate',
    pack_slug: 'gluten-free-certificate',
    match: ['gluten-free certificate', 'gluten free certificate', 'gluten-free certification'],
  },
  {
    label: '3rd Party Audit Certificate',
    pack_slug: '3rd-party-audit-certificate',
    match: [
      '3rd party audit certificate',
      'third party audit certificate',
      'gfsi certificate',
      'audit certificate',
    ],
  },
  {
    label: 'Safety Data Sheet',
    pack_slug: 'safety-data-sheet',
    match: ['safety data sheet', 'sds', 'msds', 'material safety data sheet'],
  },
  {
    label: 'Country of Origin Statement',
    pack_slug: 'country-of-origin-statement',
    match: ['country of origin statement', 'country of origin', 'coo statement', 'origin statement'],
  },
];

/** Resolve every entry's instructions out of the pack. Throws on a mismatch. */
function loadPack() {
  let json;
  try {
    json = JSON.parse(fs.readFileSync(PACK_FILE, 'utf8'));
  } catch (err) {
    console.error(`Could not read ${PACK_FILE}: ${err.message}`);
    process.exit(1);
  }
  const bySlug = new Map();
  for (const dt of json.document_types || []) {
    if (dt.slug) bySlug.set(dt.slug, dt);
  }
  return PACK_ENTRIES.map((entry) => {
    const dt = bySlug.get(entry.pack_slug);
    if (!dt) {
      console.error(
        `starter-packs/fsqa.json has no document type "${entry.pack_slug}" (for ${entry.label}).`
      );
      process.exit(1);
    }
    const raw = dt.extraction_instructions;
    // The pack accepts a string or an array of lines; both mean the same thing.
    const instructions = Array.isArray(raw) ? raw.join('\n') : typeof raw === 'string' ? raw : '';
    if (!instructions.trim()) {
      console.error(
        `starter-packs/fsqa.json: "${entry.pack_slug}" has no extraction_instructions (for ${entry.label}).`
      );
      process.exit(1);
    }
    return { ...entry, instructions };
  });
}

const PACK = loadPack();

// --- args -------------------------------------------------------------------

const opts = { apply: false, remote: false, overwrite: false, sql: false };
const argv = process.argv.slice(2);
for (let i = 0; i < argv.length; i++) {
  switch (argv[i]) {
    case '--tenant':
      opts.tenant = argv[++i];
      break;
    case '--apply':
      opts.apply = true;
      break;
    case '--remote':
    case '-r':
      opts.remote = true;
      break;
    case '--overwrite':
      opts.overwrite = true;
      break;
    case '--sql':
      opts.sql = true;
      break;
    case '-h':
    case '--help':
      opts.help = true;
      break;
    default:
      console.error(`Unknown arg: ${argv[i]}`);
      process.exit(2);
  }
}

if (opts.help) {
  console.log(fs.readFileSync(__filename, 'utf8').split('\n').slice(2, 62).join('\n'));
  process.exit(0);
}
if (!opts.tenant) {
  console.error('--tenant <id> is required. Use --help for usage.');
  process.exit(2);
}

// --- helpers ----------------------------------------------------------------

/** Same normalization the doc-type fuzzy matcher uses: case and punctuation out. */
function normalize(s) {
  return String(s || '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, ' ')
    .trim();
}

/** SQLite string literal. Everything here is authored text, but quote it anyway. */
function sqlStr(s) {
  return `'${String(s).replace(/'/g, "''")}'`;
}

/** Matches functions/lib/db.ts generateId() closely enough for a seed row. */
function generateId() {
  return crypto.randomBytes(16).toString('hex');
}

function assertTenant(tenant, remote) {
  const rows = query(`SELECT id, name FROM tenants WHERE id = '${tenant}'`, { remote });
  if (rows.length === 0) {
    console.error(`No tenant "${tenant}" in this database. Check the id, or the --remote flag.`);
    process.exit(1);
  }
  return rows[0];
}

/**
 * The write path. bin/lib/d1.js is READ-ONLY by design; this mirrors
 * bin/import-spec-limits — render to a file and hand it to wrangler, so no SQL
 * is glued into a shell command line.
 */
function execSql(statements, remote) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'dox-dt-instructions-'));
  const file = path.join(dir, 'seed-doctype-extraction-instructions.sql');
  fs.writeFileSync(file, `${statements.join('\n')}\n`, 'utf8');
  try {
    execFileSync(
      'npx',
      ['wrangler', 'd1', 'execute', DEFAULT_DB, remote ? '--remote' : '--local', `--file=${file}`],
      { cwd: PROJECT_ROOT, stdio: ['ignore', 'pipe', 'pipe'], maxBuffer: 64 * 1024 * 1024 }
    );
  } catch (err) {
    const stderr = err.stderr ? err.stderr.toString() : '';
    throw new Error(`Writing to D1 failed. The SQL is at ${file}\n${stderr || err.message}`);
  }
  fs.rmSync(dir, { recursive: true, force: true });
}

function promptSync(question) {
  process.stdout.write(question);
  const buf = Buffer.alloc(1024);
  let bytes = 0;
  try {
    bytes = fs.readSync(0, buf, 0, buf.length, null);
  } catch {
    return '';
  }
  return buf.slice(0, bytes).toString('utf8');
}

// --- plan -------------------------------------------------------------------

const tenantRow = assertTenant(opts.tenant, opts.remote);

const docTypes = query(
  `SELECT id, name, active FROM document_types WHERE tenant_id = '${opts.tenant}'`,
  { remote: opts.remote }
);
const existing = query(
  `SELECT document_type_id, instructions FROM document_type_extraction_instructions
    WHERE tenant_id = '${opts.tenant}'`,
  { remote: opts.remote }
);
const existingByType = new Map(existing.map((r) => [r.document_type_id, r.instructions || '']));

const plan = { create: [], replace: [], keep: [], missing: [] };
const claimed = new Set();

for (const entry of PACK) {
  const wanted = new Set(entry.match.map(normalize));
  const hit = docTypes.find((dt) => !claimed.has(dt.id) && wanted.has(normalize(dt.name)));
  if (!hit) {
    plan.missing.push(entry.label);
    continue;
  }
  claimed.add(hit.id);
  const current = existingByType.get(hit.id);
  const target = { entry, docType: hit };
  if (current === undefined) plan.create.push(target);
  else if (!current.trim() || opts.overwrite) plan.replace.push(target);
  else plan.keep.push(target);
}

const writes = [...plan.create, ...plan.replace];

const statements = writes.map(({ entry, docType }) =>
  // ON CONFLICT on the plain UNIQUE(tenant_id, document_type_id) from 0098 —
  // re-running the script is a no-op rather than a constraint error.
  `INSERT INTO document_type_extraction_instructions
     (id, tenant_id, document_type_id, instructions, created_at, updated_at)
   VALUES (${sqlStr(generateId())}, ${sqlStr(opts.tenant)}, ${sqlStr(docType.id)}, ${sqlStr(
     entry.instructions
   )}, datetime('now'), datetime('now'))
   ON CONFLICT(tenant_id, document_type_id) DO UPDATE SET
     instructions = excluded.instructions,
     updated_at   = datetime('now');`
);

if (opts.sql) {
  console.log(statements.join('\n\n'));
  process.exit(0);
}

console.log(`Tenant: ${tenantRow.name} (${opts.tenant})${opts.remote ? '  [REMOTE / PRODUCTION]' : ''}`);
console.log('');
for (const { entry, docType } of plan.create) {
  console.log(`  create   ${entry.label}  ->  ${docType.name}${docType.active ? '' : '  (INACTIVE type)'}`);
}
for (const { entry, docType } of plan.replace) {
  console.log(`  replace  ${entry.label}  ->  ${docType.name}`);
}
for (const { entry } of plan.keep) {
  console.log(`  keep     ${entry.label}  (already authored — use --overwrite to replace)`);
}
for (const label of plan.missing) {
  console.log(`  skip     ${label}  (no such document type in this tenant)`);
}
console.log('');
console.log(
  `${plan.create.length} to create, ${plan.replace.length} to replace, ` +
    `${plan.keep.length} kept, ${plan.missing.length} with no matching type.`
);

if (!opts.apply) {
  console.log('\nDry run. Re-run with --apply to write (add --sql to see the statements).');
  process.exit(0);
}

if (writes.length === 0) {
  console.log('\nNothing to write.');
  process.exit(0);
}

if (opts.remote) {
  const answer = promptSync(
    `\nAbout to WRITE to PRODUCTION D1 for tenant ${opts.tenant}: ` +
      `${plan.create.length} created, ${plan.replace.length} replaced.\n` +
      'Type the tenant id to continue: '
  );
  if (answer.trim() !== opts.tenant) {
    console.error('That did not match. Nothing was written.');
    process.exit(1);
  }
}

execSql(statements, opts.remote);
console.log(`\nWrote ${writes.length} row(s).`);

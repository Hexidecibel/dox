#!/usr/bin/env node
/* eslint-disable no-console */
/**
 * bin/retain-split-originals — how many whole certificates we still hold for
 * documents that were split per lot, and take the reclaim date off them.
 *
 * WHY THIS EXISTS
 *
 * A multi-lot certificate is approved one RECORD at a time: the records path
 * (functions/lib/kinds/coa.ts) files one page-scoped PDF per lot. AJ's ruling
 * for what a customer receives (rules table H2, 2026-10-06) is the opposite --
 * the certificate goes WHOLE -- and the whole file is the Review Queue item's
 * staging object, which that path keeps.
 *
 * It used to keep it with a 90-day reclaim date (`processing_queue.
 * file_retain_until`). Nothing has ever purged on that date, so no original
 * has been lost to it, but a certificate a customer may ask for again next
 * year cannot carry one. New approvals no longer stamp it. This script is for
 * the ones already stamped, and it produces the count promised to AJ.
 *
 * WHAT IT REPORTS, per organization
 *
 *   split documents          active documents filed as one lot's page of a
 *                            larger certificate (extended_metadata.page_scoped)
 *   source certificates      the distinct Review Queue items they were cut from
 *   original kept            of those, the ones whose whole file was retained
 *   original not kept        approved before originals were retained at all:
 *                            the per-lot pages are all there is
 *   no traceable source      split documents whose queue item cannot be named
 *   still carrying a
 *   reclaim date             what --apply would clear
 *
 * "KEPT" IS READ FROM THE RECORD, NOT FROM STORAGE. The database cannot see
 * R2. Retention is a property of the code that ran: before it shipped the
 * staging file was deleted on approval, after it shipped it was kept, and no
 * job has purged since. So an approved source counts as kept when it carries a
 * reclaim date, or had one this script cleared (it leaves an audit row), or
 * was approved on or after the first approval that was ever stamped. The
 * portal itself checks storage per file at the moment it sends
 * (functions/lib/coa-original.ts) and falls back to the per-lot page, saying
 * so, when the original is not there.
 *
 * WHAT IT WILL NOT DO
 *   - Touch a REJECTED item's reclaim date. That 90-day tombstone is a
 *     different rule (migration 0083) and stays.
 *   - Touch a row that is not an approved split source.
 *   - Delete, move or read any file.
 *   - Write anything without --apply. A second --apply writes nothing.
 *
 * Usage:
 *   bin/retain-split-originals --all                              # report, LOCAL
 *   bin/retain-split-originals --tenant <id>                      # report, LOCAL
 *   bin/retain-split-originals --tenant <id> --apply              # LOCAL write
 *   bin/retain-split-originals --all --remote                     # report, PRODUCTION
 *   bin/retain-split-originals --tenant <id> --remote --apply     # prompts first
 *
 * Flags:
 *   --tenant ID     one organization (required with --apply)
 *   --all           every organization (reporting only)
 *   --apply         clear the reclaim dates. Without it this is a dry run.
 *   --remote, -r    target PRODUCTION D1 (with --apply, asks you to type the tenant id)
 *   --yes, -y       skip the production confirmation prompt
 *   --page-size N   D1 paging size (default 500)
 *   --json          emit the report as JSON instead of prose
 *   -h, --help      this help
 */

const fs = require('fs');
const os = require('os');
const path = require('path');
const { execFileSync } = require('child_process');

const { query, queryPaged, PROJECT_ROOT, DEFAULT_DB } = require('./lib/d1');
const {
  CLEARED_ACTION,
  sqlStr,
  queueIdFromExternalRef,
  chunk,
  buildReport,
  applySql,
} = require('./lib/retainSplitOriginals');

function parseArgs(argv) {
  const opts = { tenant: null, all: false, apply: false, remote: false, yes: false, pageSize: 500, json: false };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    switch (a) {
      case '--tenant': opts.tenant = argv[++i]; break;
      case '--all': opts.all = true; break;
      case '--apply': opts.apply = true; break;
      case '--remote':
      case '-r': opts.remote = true; break;
      case '--yes':
      case '-y': opts.yes = true; break;
      case '--page-size': opts.pageSize = Number(argv[++i]); break;
      case '--json': opts.json = true; break;
      case '-h':
      case '--help': printHelp(); process.exit(0); break;
      default:
        console.error(`Unknown argument: ${a}`);
        process.exit(2);
    }
  }
  if (!opts.tenant && !opts.all) {
    console.error('--tenant <id> is required (or --all). Run with --help for usage.');
    process.exit(2);
  }
  if (opts.tenant && !/^[A-Za-z0-9_-]+$/.test(opts.tenant)) {
    console.error('--tenant must be an id: letters, digits, dashes, underscores.');
    process.exit(2);
  }
  if (opts.apply && !opts.tenant) {
    // Writing every organization at once removes the one moment where somebody
    // reads the plan for the one they meant. Apply is per organization, always.
    console.error('--all is a reporting mode. Re-run with --tenant <id> --apply to write one organization.');
    process.exit(2);
  }
  return opts;
}

function printHelp() {
  const lines = fs.readFileSync(__filename, 'utf8').split('\n');
  const end = lines.findIndex((l, i) => i > 2 && l.trim() === '*/');
  console.log(lines.slice(3, end).join('\n').replace(/^ \* ?/gm, ''));
}

function hasColumn(table, column, remote) {
  const rows = query(
    `SELECT COUNT(*) AS n FROM pragma_table_info('${table}') WHERE name = '${column}'`,
    { remote },
  );
  return Number((rows || [])[0]?.n ?? 0) > 0;
}

function execSql(statements, remote, label) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'dox-retain-split-originals-'));
  const file = path.join(dir, `${label}.sql`);
  fs.writeFileSync(file, `${statements.join('\n')}\n`, 'utf8');
  try {
    execFileSync(
      'npx',
      ['wrangler', 'd1', 'execute', DEFAULT_DB, remote ? '--remote' : '--local', `--file=${file}`],
      { cwd: PROJECT_ROOT, stdio: ['ignore', 'pipe', 'pipe'], maxBuffer: 64 * 1024 * 1024 },
    );
  } catch (err) {
    const stderr = err.stderr ? err.stderr.toString() : '';
    throw new Error(`Writing to D1 failed. The SQL is at ${file}\n${stderr || err.message}`);
  }
  fs.rmSync(dir, { recursive: true, force: true });
}

function promptSync(question) {
  process.stdout.write(question);
  let fd;
  try {
    fd = fs.openSync('/dev/tty', 'rs');
  } catch {
    console.error('\nNo terminal to confirm on. Re-run interactively, or pass --yes.');
    process.exit(1);
  }
  const buf = Buffer.alloc(256);
  let out = '';
  for (;;) {
    const n = fs.readSync(fd, buf, 0, buf.length, null);
    if (n === 0) break;
    out += buf.toString('utf8', 0, n);
    if (out.includes('\n')) break;
  }
  fs.closeSync(fd);
  return out.split('\n')[0];
}

/**
 * Read everything the report needs. Pure apart from its reads, so the dry run
 * and the apply are built from the same rows.
 */
function gather(opts) {
  const { remote, pageSize } = opts;
  const hasOrigin = hasColumn('documents', 'origin_queue_id', remote);
  const tenantClause = opts.tenant ? `AND d.tenant_id = ${sqlStr(opts.tenant)}` : '';

  // A document's FIRST version names its source through origin_queue_id /
  // external_ref. A later version written by "Replace existing" came from a
  // different queue item (the portal reads that from the audit log); for a
  // count of certificates on file the first source is the honest floor.
  const { rows: docs } = queryPaged(
    (limit, offset) =>
      `SELECT d.id, d.tenant_id, d.external_ref,
              ${hasOrigin ? 'd.origin_queue_id' : 'NULL AS origin_queue_id'}
         FROM documents d
        WHERE d.status = 'active'
          AND json_valid(d.extended_metadata)
          AND json_extract(d.extended_metadata, '$.page_scoped') = 1
          ${tenantClause}
        ORDER BY d.id LIMIT ${limit} OFFSET ${offset}`,
    { remote, pageSize },
  );

  const sourceOf = new Map();
  for (const d of docs) {
    const id = d.origin_queue_id || queueIdFromExternalRef(d.external_ref);
    sourceOf.set(d.id, id || null);
  }
  const queueIds = [...new Set([...sourceOf.values()].filter(Boolean))];

  const queue = new Map();
  for (const part of chunk(queueIds, 80)) {
    const rows = query(
      `SELECT id, tenant_id, status, file_name, file_size, reviewed_at, file_retain_until
         FROM processing_queue WHERE id IN (${part.map(sqlStr).join(',')})`,
      { remote },
    );
    for (const q of rows) queue.set(q.id, q);
  }

  // Stamps this script already cleared. The audit row is the only place that
  // fact survives once the column is NULL.
  const cleared = new Set();
  const audits = query(
    `SELECT details FROM audit_log WHERE action = ${sqlStr(CLEARED_ACTION)}`,
    { remote },
  );
  for (const a of audits) {
    try {
      for (const id of JSON.parse(a.details).queue_ids || []) cleared.add(id);
    } catch {
      // An unreadable audit row is not evidence.
    }
  }

  // When retention began, by the database's own record: the earliest approval
  // that was ever stamped, across every organization (it is a property of the
  // code that ran, not of one tenant).
  const stampedEver = query(
    `SELECT MIN(reviewed_at) AS t0 FROM processing_queue
      WHERE status = 'approved' AND reviewed_at IS NOT NULL
        AND (file_retain_until IS NOT NULL
             ${cleared.size ? `OR id IN (${[...cleared].slice(0, 500).map(sqlStr).join(',')})` : ''})`,
    { remote },
  );
  const retentionSince = (stampedEver[0] && stampedEver[0].t0) || null;

  const tenants = query('SELECT id, name FROM tenants', { remote });
  const tenantName = new Map(tenants.map((t) => [t.id, t.name]));

  return { docs, sourceOf, queue, cleared, retentionSince, tenantName };
}

function mb(bytes) {
  return `${Math.round((bytes / (1024 * 1024)) * 10) / 10} MB`;
}

function formatReport(rows, data, target) {
  const lines = [];
  lines.push('');
  lines.push(`Whole certificates behind split documents -- ${target}`);
  lines.push(
    data.retentionSince
      ? `  originals have been retained since: ${data.retentionSince} (the first approval ever stamped)`
      : '  no approval has ever been stamped: originals were not being retained in this database',
  );
  lines.push('  "kept" is read from the record; storage is not inspected (see --help).');
  if (rows.length === 0) {
    lines.push('');
    lines.push('  No split documents found.');
    lines.push('');
    return lines;
  }
  for (const r of rows) {
    lines.push('');
    lines.push(`  ${r.tenant_name}  (${r.tenant_id})`);
    lines.push(`    split documents:               ${r.split_documents}`);
    lines.push(`    source certificates:           ${r.source_certificates}`);
    lines.push(`      original kept:               ${r.original_kept}  (${mb(r.original_kept_bytes)})`);
    lines.push(`      original not kept:           ${r.original_not_kept}`);
    if (r.still_in_review) lines.push(`      still in review:             ${r.still_in_review}`);
    lines.push(`    no traceable source:           ${r.no_traceable_source}`);
    lines.push(
      `    still carrying a reclaim date: ${r.carrying_reclaim_date}` +
        (r.soonest_reclaim_date ? `  (soonest ${r.soonest_reclaim_date})` : ''),
    );
  }
  lines.push('');
  const total = rows.reduce((s, r) => s + r.original_kept, 0);
  const sources = rows.reduce((s, r) => s + r.source_certificates, 0);
  lines.push(`  TOTAL: ${total} of ${sources} source certificate(s) kept whole.`);
  lines.push('');
  return lines;
}

function main() {
  const opts = parseArgs(process.argv.slice(2));
  const target = opts.remote ? 'PRODUCTION' : 'local';
  const data = gather(opts);
  const rows = buildReport(data);

  if (opts.json) {
    console.log(JSON.stringify({ target, retention_since: data.retentionSince, tenants: rows }, null, 2));
  } else {
    for (const l of formatReport(rows, data, target)) console.log(l);
  }

  if (!opts.apply) {
    if (!opts.json) console.log('Dry run. Nothing was written. Re-run with --tenant <id> --apply to clear the reclaim dates.');
    return;
  }

  const row = rows.find((r) => r.tenant_id === opts.tenant);
  if (!row || row.to_clear.length === 0) {
    console.log('Nothing to clear for this organization. Nothing was written.');
    return;
  }
  if (opts.remote && !opts.yes) {
    const typed = promptSync(
      `\nThis clears the reclaim date on ${row.to_clear.length} approved source file(s) in PRODUCTION.\n` +
        `No file is touched. Type the tenant id (${opts.tenant}) to continue: `,
    );
    if (typed.trim() !== opts.tenant) {
      console.error('Tenant id did not match. Nothing was written.');
      process.exit(1);
    }
  }
  execSql(applySql(row), opts.remote, `retain-${opts.tenant}`);
  console.log(`Cleared the reclaim date on ${row.to_clear.length} source file(s) for ${row.tenant_name}.`);
}

main();

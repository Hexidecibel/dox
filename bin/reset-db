#!/usr/bin/env bash
# Reset the LOCAL D1 database to a clean, fully-migrated, seeded state.
#
# Usage:
#   ./bin/reset-db            # prompt for confirmation, then reset local D1
#   ./bin/reset-db --yes      # skip the confirmation prompt (for scripts)
#
# What it does:
#   1. Deletes the local wrangler D1 state (.wrangler/state/v3/d1), wiping
#      every local table AND the _migrations tracking rows.
#   2. Re-runs ALL migrations from scratch via bin/migrate (0001 → latest),
#      so the schema is rebuilt cleanly in numeric order.
#   3. Re-seeds the default tenant + admin user via bin/seed.
#
# Why this exists:
#   The local D1 can drift — its _migrations table can claim a migration is
#   applied while the table that migration created is missing (a half-applied
#   or hand-reset DB). When that happens `bin/migrate` aborts on a later
#   migration that depends on the missing table. A clean wipe + full re-migrate
#   is the reliable fix for local dev.
#
# SAFETY: This script is LOCAL ONLY. It deliberately does NOT support --remote.
#   Never point a destructive reset at production D1.
set -euo pipefail
cd "$(dirname "$0")/.."

# Hard refusal: no remote resets, ever, from this script.
for arg in "$@"; do
  case "$arg" in
    --remote|-r|--prod|--production)
      echo "ERROR: bin/reset-db is LOCAL ONLY and will never touch remote/production D1." >&2
      echo "If you truly need to reset prod, do it deliberately and by hand." >&2
      exit 2
      ;;
  esac
done

SKIP_CONFIRM=0
for arg in "$@"; do
  case "$arg" in
    --yes|-y) SKIP_CONFIRM=1 ;;
    -h|--help) sed -n '2,21p' "$0"; exit 0 ;;
    *) echo "Unknown argument: $arg" >&2; exit 2 ;;
  esac
done

D1_STATE_DIR=".wrangler/state/v3/d1"

if [ "$SKIP_CONFIRM" != "1" ]; then
  echo "This will DELETE all LOCAL D1 data ($D1_STATE_DIR) and rebuild from migrations."
  echo "Production/staging are NOT affected."
  read -r -p "Type 'reset' to continue: " reply
  if [ "$reply" != "reset" ]; then
    echo "Aborted."
    exit 1
  fi
fi

echo "==> Wiping local D1 state: $D1_STATE_DIR"
rm -rf "$D1_STATE_DIR"

echo "==> Re-running all migrations (local)"
./bin/migrate

echo "==> Seeding local D1"
./bin/seed

echo "==> Local D1 reset complete."

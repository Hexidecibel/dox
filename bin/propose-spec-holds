#!/usr/bin/env node
/* eslint-disable no-console */
/**
 * bin/propose-spec-holds — list the existing certificates that would have been
 * put on hold at approval, had holds existed then (decision C-005, migration
 * 0139), and place those holds when told to.
 *
 * WHY THIS EXISTS
 *
 * From 0139 on, approving a certificate places a hold when a result is out of
 * spec against a limit marked Critical (rules table B1), or when a presence
 * test on a zero-tolerance analyte was run on a smaller sample than the limit
 * requires (E2). Certificates approved BEFORE 0139 were judged the same way and
 * nothing was held. The migration holds none of them, on purpose: putting a
 * year of certificates on hold is a decision, not a schema change.
 *
 * This script reads the STORED approval-time verdicts (document_spec_checks)
 * and says which documents those verdicts would have held. It re-judges
 * nothing: the verdict, the limit's criticality and the could-not-check
 * category are the ones frozen on the row when a person approved it.
 *
 * WHAT IT NEVER READS AS EVIDENCE
 *
 *   - a row written by the bulk recheck (judgement_origin = 'bulk_recheck');
 *   - a row with no origin recorded (before migration 0103);
 *   - a result on a version that has since been replaced;
 *   - a document that is not active;
 *   - a row with no result identity (before migration 0105).
 *   Each is counted and reported, never silently dropped.
 *
 * ONE THING IS NOT FROZEN: an analyte's category (zero-tolerance or not) is
 * read from spec_tests as it stands today. A zero-tolerance proposal says so.
 *
 * WHAT --apply WRITES
 *
 *   One document_holds row per proposal, placed by nobody (an automatic hold),
 *   with a `document.hold_placed` audit row saying this script placed it. Once
 *   per judged result, ever: a result already held -- or held and since
 *   released by QA -- is not held again. NO EMAIL is sent; the holds appear on
 *   the Holds page, and each stops its certificate leaving until QA or an
 *   administrator releases it with a reason.
 *
 * Usage:
 *   bin/propose-spec-holds --all                           # dry run, LOCAL, every tenant
 *   bin/propose-spec-holds --tenant <id>                   # dry run, LOCAL
 *   bin/propose-spec-holds --tenant <id> --remote          # dry run, PRODUCTION
 *   bin/propose-spec-holds --tenant <id> --apply           # LOCAL write
 *   bin/propose-spec-holds --tenant <id> --remote --apply  # prompts first
 *
 * Flags:
 *   --tenant ID       tenant to read (required unless --all)
 *   --all             every tenant in the database (reporting only; refuses --apply)
 *   --apply           actually place the holds. Without it this is a dry run.
 *   --remote, -r      target PRODUCTION D1 (with --apply, asks you to type the tenant id)
 *   --persist-to DIR  LOCAL only: use the local D1 state under DIR. A git worktree
 *                     has no .wrangler of its own; point this at the main checkout's.
 *   --yes, -y         skip the production confirmation prompt
 *   --json            emit the plan as JSON instead of prose
 *   -h, --help        this help
 */

const fs = require('fs');
const os = require('os');
const path = require('path');
const crypto = require('crypto');
const { execFileSync } = require('child_process');

const { flattenRows, isReadOnly, PROJECT_ROOT, DEFAULT_DB } = require('./lib/d1');
const { planSpecHolds, proposalToSql } = require('./lib/specHoldsPlan');
const { HOLD_SOURCE_LABELS } = require('./lib/shared/holds.js');

function parseArgs(argv) {
  const opts = { tenant: null, all: false, apply: false, remote: false, yes: false, json: false, persistTo: null };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    switch (a) {
      case '--tenant': opts.tenant = argv[++i]; break;
      case '--all': opts.all = true; break;
      case '--apply': opts.apply = true; break;
      case '--remote':
      case '-r': opts.remote = true; break;
      case '--persist-to': opts.persistTo = argv[++i]; break;
      case '--yes':
      case '-y': opts.yes = true; break;
      case '--json': opts.json = true; break;
      case '-h':
      case '--help': printHelp(); process.exit(0); break;
      default:
        console.error(`Unknown argument: ${a}`);
        process.exit(2);
    }
  }
  if (!opts.tenant && !opts.all) {
    console.error('--tenant <id> is required (or --all). Run with --help for usage.');
    process.exit(2);
  }
  if (opts.tenant && !/^[A-Za-z0-9_-]+$/.test(opts.tenant)) {
    console.error('--tenant must be an id: letters, digits, dashes, underscores.');
    process.exit(2);
  }
  if (opts.all && opts.apply) {
    // Holding every tenant's certificates at once removes the one moment where
    // somebody reads the list for the tenant they meant. Apply is per tenant.
    console.error('--all is a reporting mode. Re-run with --tenant <id> --apply to place one tenant\'s holds.');
    process.exit(2);
  }
  if (opts.persistTo !== null && (!opts.persistTo || opts.persistTo.startsWith('--'))) {
    console.error('--persist-to requires a directory.');
    process.exit(2);
  }
  if (opts.persistTo && opts.remote) {
    console.error('--persist-to is for LOCAL D1 only.');
    process.exit(2);
  }
  return opts;
}

function printHelp() {
  const lines = fs.readFileSync(__filename, 'utf8').split('\n');
  const end = lines.findIndex((l, i) => i > 2 && l.trim() === '*/');
  console.log(lines.slice(3, end).join('\n').replace(/^ \* ?/gm, ''));
}

function sqlStr(v) {
  if (v === null || v === undefined) return 'NULL';
  return `'${String(v).replace(/'/g, "''")}'`;
}

/** Where wrangler should look: production, the default local state, or DIR. */
function targetArgs(opts) {
  if (opts.remote) return ['--remote'];
  return opts.persistTo ? ['--local', `--persist-to=${opts.persistTo}`] : ['--local'];
}

/** A read. Refuses anything that is not a SELECT, like bin/lib/d1.js. */
function query(sql, opts) {
  if (!isReadOnly(sql)) throw new Error(`refusing a non-SELECT read: ${String(sql).slice(0, 80)}`);
  let out;
  try {
    out = execFileSync(
      'npx',
      ['wrangler', 'd1', 'execute', DEFAULT_DB, ...targetArgs(opts), '--json', '--command', sql],
      { cwd: PROJECT_ROOT, stdio: ['ignore', 'pipe', 'pipe'], maxBuffer: 256 * 1024 * 1024 },
    ).toString();
  } catch (err) {
    const stderr = err.stderr ? err.stderr.toString() : '';
    const stdout = err.stdout ? err.stdout.toString() : '';
    throw new Error(`d1 query failed: ${stderr || err.message}${stdout ? `\n${stdout}` : ''}`);
  }
  return flattenRows(out);
}

function execSql(statements, opts, label) {
  const dir = fs.mkdtempSync(path.join(os.tmpdir(), 'dox-propose-spec-holds-'));
  const file = path.join(dir, `${label}.sql`);
  fs.writeFileSync(file, `${statements.join('\n')}\n`, 'utf8');
  try {
    execFileSync(
      'npx',
      ['wrangler', 'd1', 'execute', DEFAULT_DB, ...targetArgs(opts), `--file=${file}`],
      { cwd: PROJECT_ROOT, stdio: ['ignore', 'pipe', 'pipe'], maxBuffer: 64 * 1024 * 1024 },
    );
  } catch (err) {
    const stderr = err.stderr ? err.stderr.toString() : '';
    throw new Error(`Writing to D1 failed. The SQL is at ${file}\n${stderr || err.message}`);
  }
  fs.rmSync(dir, { recursive: true, force: true });
}

function promptSync(question) {
  process.stdout.write(question);
  let fd;
  try {
    fd = fs.openSync('/dev/tty', 'rs');
  } catch {
    console.error('\nNo terminal to confirm on. Re-run interactively, or pass --yes.');
    process.exit(1);
  }
  const buf = Buffer.alloc(256);
  let out = '';
  for (;;) {
    const n = fs.readSync(fd, buf, 0, buf.length, null);
    if (n === 0) break;
    out += buf.toString('utf8', 0, n);
    if (out.includes('\n')) break;
  }
  fs.closeSync(fd);
  return out.split('\n')[0];
}

function hasTable(table, opts) {
  const rows = query(`SELECT COUNT(*) AS n FROM sqlite_master WHERE type = 'table' AND name = '${table}'`, opts);
  return Number((rows || [])[0]?.n ?? 0) > 0;
}

function planTenant(tenantId, opts) {
  // Only the rows that could place a hold: a failure or a could-not-check
  // judged against a configured limit. Passes are most of the table.
  const checks = query(
    `SELECT c.id, c.document_id, c.version_number, c.test_name_raw, c.value_raw, c.unit_raw,
            c.verdict, c.reason, c.source, c.limit_snapshot, c.judgement_origin,
            c.result_key, c.result_location,
            st.category AS analyte_category,
            d.title AS document_title, d.status AS document_status, d.current_version,
            s.name AS supplier_name
       FROM document_spec_checks c
       JOIN documents d ON d.id = c.document_id AND d.tenant_id = c.tenant_id
       LEFT JOIN spec_tests st ON st.id = c.spec_test_id AND st.tenant_id = c.tenant_id
       LEFT JOIN suppliers s ON s.id = d.supplier_id AND s.tenant_id = d.tenant_id
      WHERE c.tenant_id = ${sqlStr(tenantId)}
        AND c.source = 'limit'
        AND c.verdict IN ('out_of_spec', 'not_checked')
      ORDER BY d.title, c.id`,
    opts,
  );
  const holds = query(
    `SELECT document_id, source, source_key, released_at
       FROM document_holds WHERE tenant_id = ${sqlStr(tenantId)} AND source_key IS NOT NULL`,
    opts,
  );
  const docIds = [...new Set(checks.map((c) => c.document_id))];
  const lots = [];
  for (let i = 0; i < docIds.length; i += 80) {
    const part = docIds.slice(i, i + 80);
    lots.push(
      ...query(
        `SELECT dl.document_id, l.id AS lot_id, l.lot_number, l.sub_lot_code
           FROM document_lots dl JOIN lots l ON l.id = dl.lot_id AND l.tenant_id = ${sqlStr(tenantId)}
          WHERE dl.document_id IN (${part.map(sqlStr).join(', ')})`,
        opts,
      ),
    );
  }
  return { tenantId, ...planSpecHolds(checks, holds, lots) };
}

function formatPlan(plan, label) {
  const lines = [];
  const s = plan.skipped;
  lines.push('');
  lines.push(`Spec holds -- ${label}`);
  lines.push(`  failures and could-not-checks against a configured limit: ${plan.rows_read}`);
  lines.push(`  usable as evidence (approval, current version, active):   ${plan.rows_considered}`);
  lines.push(`  NOT read as evidence:`);
  lines.push(`    written by the bulk recheck (never holds):              ${s.bulk_recheck}`);
  lines.push(`    no origin recorded (before migration 0103):             ${s.origin_not_recorded}`);
  lines.push(`    on a version since replaced:                            ${s.superseded_version}`);
  lines.push(`    document not active:                                    ${s.document_not_active}`);
  lines.push(`    no result identity (before migration 0105):             ${s.no_result_identity}`);
  lines.push(`  already held, or held and released (left alone):          ${plan.already_placed}`);
  lines.push(`  WOULD BE PLACED:                                          ${plan.proposals.length} hold(s) on ${plan.documents} document(s)`);
  lines.push('');
  for (const source of ['spec_critical', 'zero_tolerance']) {
    const rows = plan.proposals.filter((p) => p.source === source);
    if (rows.length === 0) continue;
    lines.push(`  ${HOLD_SOURCE_LABELS[source]} (${rows.length})`);
    if (source === 'zero_tolerance') {
      lines.push('    (the analyte\'s category is read from spec_tests as it stands TODAY; it is not frozen on the row)');
    }
    for (const p of rows) {
      lines.push(`    ${p.title}${p.supplier_name ? ` -- ${p.supplier_name}` : ''}  [v${p.version}, ${p.lot_label ? `lot ${p.lot_label}` : 'whole certificate'}]`);
      lines.push(`      ${p.reason}`);
    }
    lines.push('');
  }
  return lines;
}

function main() {
  const opts = parseArgs(process.argv.slice(2));
  const targetLabel = opts.remote ? 'PRODUCTION' : 'local';

  if (!hasTable('document_holds', opts)) {
    console.error(
      'This database predates migration 0139 -- there is no document_holds table.\n' +
      'Apply migrations/0139_document_holds.sql on the target first.',
    );
    process.exit(1);
  }

  const tenants = opts.all
    ? query('SELECT id, name FROM tenants ORDER BY name', opts)
    : query(`SELECT id, name FROM tenants WHERE id = ${sqlStr(opts.tenant)}`, opts);
  if (tenants.length === 0) {
    console.error(opts.all ? 'No tenants in this database.' : `No tenant with id ${opts.tenant} in the ${targetLabel} database.`);
    process.exit(1);
  }

  const plans = tenants.map((t) => ({ name: t.name, plan: planTenant(t.id, opts) }));

  if (opts.json) {
    console.log(JSON.stringify({ target: targetLabel, applied: false, tenants: plans.map((p) => ({ name: p.name, ...p.plan })) }, null, 2));
  } else {
    for (const p of plans) for (const line of formatPlan(p.plan, `${p.name} (${p.plan.tenantId}), ${targetLabel}`)) console.log(line);
  }

  if (!opts.apply) {
    if (!opts.json) console.log('Dry run. Nothing was written. Re-run with --tenant <id> --apply to place these holds.');
    return;
  }

  const { plan } = plans[0];
  if (plan.proposals.length === 0) {
    console.log('Nothing to place.');
    return;
  }
  if (opts.remote && !opts.yes) {
    const typed = promptSync(
      `\nThis places ${plan.proposals.length} hold(s) on ${plan.documents} document(s) in PRODUCTION. ` +
      `Each certificate stops leaving until QA releases it.\nType the tenant id (${plan.tenantId}) to continue: `,
    );
    if (typed.trim() !== plan.tenantId) {
      console.error('Not confirmed. Nothing was written.');
      process.exit(1);
    }
  }
  const statements = [];
  for (const p of plan.proposals) {
    statements.push(...proposalToSql(plan.tenantId, p, crypto.randomBytes(16).toString('hex'), sqlStr));
  }
  for (let i = 0; i < statements.length; i += 40) {
    execSql(statements.slice(i, i + 40), opts, `holds-${String(i / 40).padStart(3, '0')}`);
  }
  const after = query(
    `SELECT COUNT(*) AS n FROM document_holds WHERE tenant_id = ${sqlStr(plan.tenantId)} AND released_at IS NULL AND source != 'person'`,
    opts,
  );
  console.log(`Placed. ${Number(after[0]?.n ?? 0)} automatic hold(s) are now active for this tenant (${targetLabel}). No email was sent; they are on the Holds page.`);
}

try {
  main();
} catch (err) {
  console.error(err instanceof Error ? err.message : String(err));
  process.exit(1);
}

#!/usr/bin/env bash
# Clone one tenant (org) + its dependent data into a NEW throwaway test tenant.
#
# Purpose: rehearse the COA "sublot split (Option B)" rollout + the targeted
# multi-sublot reprocess against a real copy of an org's data WITHOUT touching
# the source org. Run the full review -> produce -> match pipeline in the clone,
# verify the new sublot lot_keys against the WMS order lines, THEN do prod.
#
# Usage:
#   ./bin/clone-org --source <tenant_id|name> --name "<new tenant name>" [flags]
#
# Target selection (where the NEW tenant is WRITTEN):
#   (default)        LOCAL D1   (doc-upload-db, no --remote)
#   --staging        STAGING D1 (doc-upload-db-staging --remote; needs .dev.vars)
#   --prod-insert    PROD D1    (doc-upload-db --remote) -- INSERT-ONLY of a NEW
#                    tenant. The source org is NEVER mutated. Requires the extra
#                    --i-understand-prod flag and a typed confirmation.
#
# Source selection (where the org is READ from):
#   (default)              same DB as the target (LOCAL reads LOCAL, etc.).
#   --source-remote        Read the SOURCE org from PROD (doc-upload-db --remote)
#   (alias: --from-prod)   while WRITING to the chosen target (default LOCAL).
#                          Needs .dev.vars for prod creds. This is the
#                          "rehearse prod data in local (new code)" mode: source
#                          SELECTs hit prod (read-only), every INSERT lands local.
#                          TARGET schema is introspected (so only columns the
#                          target actually has are written -- e.g. local's new
#                          lot_scheme / supplier_product_map that prod lacks).
#
# Other flags:
#   --source <id|name>   REQUIRED. Source tenant id, or its exact name.
#   --name "<name>"      REQUIRED. Name for the new (clone) tenant.
#   --slug <slug>        Optional slug for the new tenant (default: derived).
#   --dry-run            Print the per-table row counts it WOULD copy; no writes.
#   --with-recipients    Copy owner_routes RECIPIENTS verbatim (real user_ids /
#                        real email addresses) instead of redacting them.
#                        OFF BY DEFAULT -- see "OWNER ROUTES" below.
#   --yes / -y           Skip the interactive confirmation (still honors prod gate).
#   -h / --help          Show this help.
#
# R2 FILES (v1 decision): the cloned documents/queue rows REUSE the original
#   R2 object keys (file_r2_key / r2_key) verbatim -- no objects are copied.
#   Downloads in the clone READ the original files (read-only reuse). This is
#   safe for a rehearsal: the pipeline never deletes/overwrites source R2 objects
#   by key, and the clone is throwaway. If you later need isolated R2, copy the
#   objects to new keys and rewrite the key columns (deferred; not v1).
#
# SAFETY:
#   - Source org is READ-ONLY in every mode (we only SELECT from its rows).
#   - The clone is built with FRESH ids for every row and a consistent FK
#     id-remap, so it cannot collide with or reference source rows by id.
#   - --dry-run writes nothing. A loud confirmation precedes any write.
#   - Schema is INTROSPECTED at runtime (actual columns per table), so the
#     script tolerates schema drift between local/staging/prod and only copies
#     tables/columns that actually exist in the target DB.
#
# Tables copied (tenant-scoped, FK-safe order) -- skipped if absent in target:
#   suppliers, products, product_suppliers, document_types,
#   requirements, claim_types, claim_type_requirements, supplier_requirements,
#   spec_tests, spec_limits, document_type_extraction_instructions,
#   supplier_extraction_instructions, extraction_examples, extraction_templates,
#   email_domain_mappings, owner_routes (recipients REDACTED by default),
#   assignments, teach_sessions,
#   teach_messages, customers, customer_contacts, documents, document_versions,
#   document_products, lots, document_lots, orders, order_items,
#   lot_match_suggestions, processing_queue (INCLUDING ai_records / ai_fields so
#   the multi-sublot shadow data comes along), reviewer_field_picks,
#   reviewer_field_dismissals, reviewer_table_edits.
#
# CONFIGURATION, NOT JUST CONTENT. The registry vocabulary (requirements /
#   claim_types / claim_type_requirements), the applicability table
#   (supplier_requirements), the spec engine's inputs (spec_tests / spec_limits),
#   the extraction prompt layers and the alert routes are all part of what an org
#   IS. A clone that carried documents but none of these arrived LOOKING
#   configured and EMPTY underneath -- the gap engine answered `not_configured`,
#   spec checking judged nothing, and no alert routed anywhere. That is worse
#   than an obviously bare tenant, because the emptiness is invisible. If you add
#   a new per-tenant configuration table, add it here too.
#
# OWNER ROUTES -- recipients are REDACTED by default (see the node block for the
#   full reasoning). owner_routes rows carry REAL people: a bare email or a
#   portal user, one or the other (0091's CHECK). Copying those verbatim into a
#   demo/rehearsal tenant means the clone can email a real person about documents
#   in an org they have never heard of. So by default the clone keeps the owner
#   LABEL and the row (the structure a human needs to see and refill), replaces
#   the recipient with a per-row `@clone.invalid` placeholder, and sets
#   `active = 0` -- which alert-routing.ts already treats as the off switch, so
#   the clone honestly reports a routing GAP instead of pretending to be routed.
#   `--with-recipients` copies them verbatim; --dry-run always states how many
#   real addresses that would be.
#
# Intentionally NOT copied (non-essential for the COA rehearsal; noted, not
# silently dropped):
#   - users / api_keys / sessions / saved_searches  (global/per-user; the clone
#     reuses the SAME super_admin + tenant users by id, so created_by/uploaded_by
#     FKs still resolve -- see note below).
#   - connectors / connector_runs / connector_processed_keys /
#     connector_extraction_corrections  (intake plumbing; the rehearsal drives
#     review->produce->match, not live connector polling).
#   - records_* module tables (the spreadsheet/records product is orthogonal to COA).
#   - audit_log / email_ingest_log  (history; not needed to exercise the pipeline).
#   - *_fts / *_fts_map / search_reindex_jobs (virtual/shadow; rebuilt by reindex).
#   - document_requirements / document_claims (per-DOCUMENT registry facts: what
#     a given doc SATISFIES / TRIGGERS). NOT configuration, and out of scope for
#     this pass -- but be aware of the consequence: the clone now carries the
#     applicability side (supplier_requirements) WITHOUT the closure side, so a
#     gap report in the clone reads "open" for requirements the source had
#     closed. It is honest rather than wrong, but it is not a faithful copy.
#   - naming_templates: NOT a choice -- the table does not exist. Migration 0014
#     created it and 0018 DROPPED it. It sat in TABLE_ORDER for a long time doing
#     nothing (the tableExists() guard skipped it every run) and was removed on
#     2026-09-03. Do not re-add it; there is no such table to copy from.
#   To pull any of these in later, add them to TABLE_ORDER in the embedded node
#   program below (they follow the same remap pattern).
#
# NOTE on user FKs: created_by / uploaded_by / reviewed_by / updated_by /
#   created_by_user_id point at users. Users are NOT tenant-scoped here and are
#   NOT cloned; the clone REUSES the original user ids verbatim WHEN the target
#   has them. When a source user id is absent from the TARGET (typical in
#   --from-prod: prod user ids don't exist locally), it is remapped to a fallback
#   target user (a super_admin if one exists) so NOT NULL user FKs
#   (documents.created_by, document_versions.uploaded_by) still resolve. Pass
#   --null-user-fks to additionally NULL out nullable user FK columns.
set -euo pipefail
cd "$(dirname "$0")/.."

PROD_DB="doc-upload-db"
STAGING_DB="doc-upload-db-staging"

TARGET="local"          # local | staging | prod  (where WRITES go)
DB="$PROD_DB"
REMOTE_FLAG=""
SOURCE_REMOTE=0         # 1 = read SOURCE from prod (--source-remote / --from-prod)
SOURCE=""
NEW_NAME=""
NEW_SLUG=""
DRY_RUN=0
SKIP_CONFIRM=0
PROD_OK=0
NULL_USER_FKS=0
WITH_RECIPIENTS=0       # 1 = copy owner_routes recipients verbatim (see header)

while [ $# -gt 0 ]; do
  case "$1" in
    --source) SOURCE="${2:-}"; shift 2 ;;
    --name) NEW_NAME="${2:-}"; shift 2 ;;
    --slug) NEW_SLUG="${2:-}"; shift 2 ;;
    --staging) TARGET="staging"; shift ;;
    --prod-insert) TARGET="prod"; shift ;;
    --source-remote|--from-prod) SOURCE_REMOTE=1; shift ;;
    --i-understand-prod) PROD_OK=1; shift ;;
    --null-user-fks) NULL_USER_FKS=1; shift ;;
    --with-recipients) WITH_RECIPIENTS=1; shift ;;
    --dry-run) DRY_RUN=1; shift ;;
    --yes|-y) SKIP_CONFIRM=1; shift ;;
    # Print the leading comment block, whatever length it has grown to. The
    # old form was a hardcoded 'sed -n 2,99p', which both truncated the header
    # and spilled shell code into --help once the header moved.
    -h|--help) awk 'NR>1 && /^#/ {print; next} NR>1 {exit}' "$0"; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; exit 2 ;;
  esac
done

if [ -z "$SOURCE" ]; then echo "ERROR: --source <tenant_id|name> is required." >&2; exit 2; fi
if [ -z "$NEW_NAME" ]; then echo "ERROR: --name \"<new tenant name>\" is required." >&2; exit 2; fi

# --- TARGET (DST) selection: where the INSERTs land + which schema is introspected ---
case "$TARGET" in
  local)   DST_DB="$PROD_DB"; DST_REMOTE=""; TARGET_LABEL="LOCAL D1 ($DST_DB)" ;;
  staging) DST_DB="$STAGING_DB"; DST_REMOTE="--remote"; TARGET_LABEL="STAGING D1 ($DST_DB, remote)" ;;
  prod)
    DST_DB="$PROD_DB"; DST_REMOTE="--remote"; TARGET_LABEL="PROD D1 ($DST_DB, remote) [INSERT-ONLY]"
    if [ "$PROD_OK" != "1" ]; then
      echo "ERROR: --prod-insert requires --i-understand-prod as well." >&2
      echo "       It will INSERT a new tenant into PROD (source is never mutated)." >&2
      exit 2
    fi
    ;;
esac

# --- SOURCE (SRC) selection: where the org's rows are READ from (read-only) ---
if [ "$SOURCE_REMOTE" = "1" ]; then
  # Read the source org from PROD regardless of the (usually LOCAL) target.
  SRC_DB="$PROD_DB"; SRC_REMOTE="--remote"; SOURCE_LABEL="PROD D1 ($SRC_DB, remote) [READ-ONLY]"
else
  # Read the source from the same DB the clone is written to (legacy behavior).
  SRC_DB="$DST_DB"; SRC_REMOTE="$DST_REMOTE"; SOURCE_LABEL="$TARGET_LABEL [READ-ONLY]"
fi

# Back-compat: legacy single-DB vars still used by the final write step.
DB="$DST_DB"; REMOTE_FLAG="$DST_REMOTE"

# Any remote leg (source OR target) needs CF creds from .dev.vars.
if [ -n "$SRC_REMOTE" ] || [ -n "$DST_REMOTE" ]; then
  if [ ! -f .dev.vars ]; then
    echo "ERROR: .dev.vars not found (needed for remote D1 creds)." >&2
    exit 1
  fi
  set -a
  # shellcheck disable=SC1091
  source .dev.vars
  set +a
fi

echo "clone-org"
echo "  source : $SOURCE  <- $SOURCE_LABEL"
echo "  target : $TARGET_LABEL"
echo "  newname: $NEW_NAME"
[ "$DRY_RUN" = "1" ] && echo "  mode   : DRY-RUN (no writes)"
echo

# --- helper: run a SELECT against the SOURCE and return D1 --json on stdout ---
d1_json() {
  npx wrangler d1 execute "$SRC_DB" $SRC_REMOTE --json --command "$1" 2>/dev/null
}

# --- resolve the source tenant id (accept id OR exact name) ---
SRC_TENANT_ID=$(SOURCE_ARG="$SOURCE" node -e '
  const src = process.env.SOURCE_ARG;
  const esc = s => String(s).replace(/'\''/g, "'\'\''");
  // Print a query that matches by id OR name; the shell runs it next.
  process.stdout.write(
    "SELECT id, name, slug FROM tenants WHERE id='\''" + esc(src) + "'\'' OR name='\''" + esc(src) + "'\'' LIMIT 1;"
  );
')
SRC_ROW=$(d1_json "$SRC_TENANT_ID")
RESOLVED=$(printf '%s' "$SRC_ROW" | node -e '
  let d="";process.stdin.on("data",c=>d+=c);process.stdin.on("end",()=>{
    let rows=[];try{rows=(JSON.parse(d)[0]||{}).results||[];}catch{}
    if(!rows.length){console.error("ERROR: source tenant not found.");process.exit(3);}
    const t=rows[0];
    console.log(JSON.stringify({id:t.id,name:t.name,slug:t.slug}));
  });
') || exit 3
SRC_ID=$(printf '%s' "$RESOLVED" | node -e 'let d="";process.stdin.on("data",c=>d+=c);process.stdin.on("end",()=>console.log(JSON.parse(d).id))')
SRC_NAME=$(printf '%s' "$RESOLVED" | node -e 'let d="";process.stdin.on("data",c=>d+=c);process.stdin.on("end",()=>console.log(JSON.parse(d).name))')
echo "Resolved source tenant: $SRC_NAME ($SRC_ID)"
echo

# === The clone engine (node). Reads source rows via repeated wrangler SELECTs,
# === builds the id-remap, and emits a single ordered INSERT script to stdout.
# === In --dry-run it instead prints a per-table count table and exits 0.
CLONE_SQL=$(mktemp)
COUNTS=$(mktemp)
trap 'rm -f "$CLONE_SQL" "$COUNTS"' EXIT

# Export config for the node program. SRC_* drives source-row reads; DST_*
# drives target-schema introspection (which tables/columns exist to write).
export SRC_DB SRC_REMOTE DST_DB DST_REMOTE SRC_ID NEW_NAME NEW_SLUG DRY_RUN NULL_USER_FKS
export WITH_RECIPIENTS COUNTS

node <<'NODE' > "$CLONE_SQL"
const { execFileSync } = require('child_process');
const crypto = require('crypto');
const fs = require('fs');

const SRC_DB = process.env.SRC_DB;
const SRC_REMOTE = process.env.SRC_REMOTE ? ['--remote'] : [];
const DST_DB = process.env.DST_DB;
const DST_REMOTE = process.env.DST_REMOTE ? ['--remote'] : [];
const SRC_ID = process.env.SRC_ID;
const NEW_NAME = process.env.NEW_NAME;
const NEW_SLUG = process.env.NEW_SLUG;
const DRY_RUN = process.env.DRY_RUN === '1';
const NULL_USER_FKS = process.env.NULL_USER_FKS === '1';
const WITH_RECIPIENTS = process.env.WITH_RECIPIENTS === '1';
const COUNTS = process.env.COUNTS;

const newId = () => crypto.randomUUID().replace(/-/g, '');
const sqlStr = v =>
  v === null || v === undefined ? 'NULL' : "'" + String(v).replace(/'/g, "''") + "'";

function runD1(db, remote, command) {
  const out = execFileSync(
    'npx',
    ['wrangler', 'd1', 'execute', db, ...remote, '--json', '--command', command],
    { encoding: 'utf8', maxBuffer: 1 << 30 }
  );
  try { return (JSON.parse(out)[0] || {}).results || []; } catch { return []; }
}

// SOURCE read: the org's actual rows (read-only; may be prod).
const d1 = command => runD1(SRC_DB, SRC_REMOTE, command);
// TARGET read: schema introspection only. We must write ONLY the tables/columns
// the TARGET has -- the local target carries new columns (lot_scheme,
// supplier_product_map) that the prod source lacks, and vice-versa.
const d1dst = command => runD1(DST_DB, DST_REMOTE, command);

function tableExists(name) {
  const r = d1dst(`SELECT name FROM sqlite_master WHERE type='table' AND name='${name}';`);
  return r.length > 0;
}
function columnsOf(name) {
  // PRAGMA via SELECT so --json returns rows. TARGET schema (what we can write).
  const r = d1dst(`SELECT name, "notnull" AS nn FROM pragma_table_info('${name}');`);
  return r.map(c => ({ name: c.name, notnull: Number(c.nn) === 1 }));
}

// FK rewrite map: column name -> which remap table its value should be looked
// up in. Applied per-table. Columns not listed are copied verbatim (except the
// PK 'id' which always gets a fresh id, and tenant_id which becomes the new
// tenant). User FK columns are handled specially (reuse id, or NULL if asked).
const USER_FK_COLS = new Set([
  'created_by', 'uploaded_by', 'reviewed_by', 'updated_by', 'invited_by',
  'created_by_user_id', 'reviewer_id', 'author_id', 'actor_id', 'default_user_id',
  'owner_user_id', 'triggered_by_user_id',
]);

// Users are NOT cloned -- user FK values are reused verbatim. That works only if
// the TARGET has those users. In cross-DB mode (--from-prod) the source's users
// (e.g. a prod user id) typically DON'T exist in the local target, which would
// fail NOT NULL user FKs (documents.created_by, document_versions.uploaded_by).
// So we read the TARGET's user ids and, for any source user id absent there,
// substitute a fallback target user (prefer a super_admin). NULLable columns are
// still NULLed first if --null-user-fks. If the target has NO users at all,
// there's no fallback -- we keep the original id (will fail, as before).
const TARGET_USER_IDS = new Set(
  d1dst('SELECT id FROM users;').map(r => r.id)
);
const USER_FALLBACK =
  (d1dst("SELECT id FROM users WHERE role='super_admin' ORDER BY id LIMIT 1;")[0] || {}).id ||
  (d1dst('SELECT id FROM users ORDER BY id LIMIT 1;')[0] || {}).id ||
  null;
function resolveUserFk(v) {
  if (v == null) return v;
  if (TARGET_USER_IDS.has(v)) return v;       // exists in target -> keep
  if (USER_FALLBACK) return USER_FALLBACK;    // missing -> remap to a target user
  return v;                                   // no users in target -> keep (will fail)
}

// Per-table: FK columns that reference tables we deliberately DON'T clone
// (connectors / connector_runs -- intake plumbing, see header). Their source
// values dangle in the target, so NULL them when the column is nullable. If a
// dropped FK were NOT NULL we'd keep the id (and fail loudly) rather than guess.
const DROP_FK = {
  orders: new Set(['connector_id', 'connector_run_id', 'source_id']),
  documents: new Set(['source_id']),
  processing_queue: new Set(['source_id', 'connector_id']),
};

// Per-table: map of FK-column -> source remap-table key.
const FK = {
  products:                       { supplier_id: 'suppliers' },
  product_suppliers:              { product_id: 'products', supplier_id: 'suppliers' },
  document_types:                 { supplier_id: 'suppliers' },
  // Registry vocabulary + applicability (0080 / 0087). requirements, claim_types
  // and spec_tests have no FK but tenants, so they need no entry here.
  claim_type_requirements:        { claim_type_id: 'claim_types', requirement_id: 'requirements' },
  supplier_requirements:          { supplier_id: 'suppliers', requirement_id: 'requirements' },
  // spec_limits' three scope columns are all NULLABLE (0084) -- an all-NULL scope
  // is the tenant-wide default. The remap below only rewrites non-NULL values,
  // so a tenant-wide limit stays tenant-wide.
  spec_limits:                    { spec_test_id: 'spec_tests', supplier_id: 'suppliers', document_type_id: 'document_types', product_id: 'products' },
  document_type_extraction_instructions: { document_type_id: 'document_types' },
  supplier_extraction_instructions:{ supplier_id: 'suppliers', document_type_id: 'document_types' },
  extraction_examples:            { document_type_id: 'document_types' },
  extraction_templates:           { supplier_id: 'suppliers', document_type_id: 'document_types' },
  email_domain_mappings:          { default_document_type_id: 'document_types' },
  assignments:                    { supplier_id: 'suppliers', document_type_id: 'document_types' },
  teach_sessions:                 { supplier_id: 'suppliers', document_type_id: 'document_types' },
  teach_messages:                 { session_id: 'teach_sessions' },
  customer_contacts:              { customer_id: 'customers' },
  documents:                      { document_type_id: 'document_types', supplier_id: 'suppliers' },
  document_versions:              { document_id: 'documents' },
  document_products:              { document_id: 'documents', product_id: 'products' },
  lots:                           { supplier_id: 'suppliers', product_id: 'products' },
  document_lots:                  { document_id: 'documents', lot_id: 'lots' },
  orders:                         { customer_id: 'customers' },
  order_items:                    { order_id: 'orders', product_id: 'products', coa_document_id: 'documents', lot_id: 'lots' },
  lot_match_suggestions:          { order_item_id: 'order_items', document_id: 'documents', lot_id: 'lots' },
  processing_queue:               { document_type_id: 'document_types', supplier_id: 'suppliers', template_id: 'extraction_templates' },
  reviewer_field_picks:           { queue_item_id: 'processing_queue', supplier_id: 'suppliers', document_type_id: 'document_types' },
  reviewer_field_dismissals:      { queue_item_id: 'processing_queue', supplier_id: 'suppliers', document_type_id: 'document_types' },
  reviewer_table_edits:           { queue_item_id: 'processing_queue', supplier_id: 'suppliers', document_type_id: 'document_types' },
};

// How to scope each table's source rows. Direct = has tenant_id. Otherwise we
// scope by a parent id-set already remapped.
const SCOPE = {
  teach_messages:        { via: 'session_id', parent: 'teach_sessions' },
  customer_contacts:     { via: 'customer_id', parent: 'customers' },
  document_versions:     { via: 'document_id', parent: 'documents' },
  document_products:     { via: 'document_id', parent: 'documents' },
  document_lots:         { via: 'document_id', parent: 'documents' },
  order_items:           { via: 'order_id', parent: 'orders' },
};

// --- owner_routes: a route is a REAL PERSON, and a clone is not their tenant ---
//
// 0091's CHECK is `(user_id IS NOT NULL) <> (email IS NOT NULL)`: every route
// points at exactly one recipient, either a portal user or a bare address (a
// broker, a site manager -- people who will never have an account, which is why
// documents.owner was never converted into a user FK).
//
// Copying those verbatim is the one thing in this script that can reach OUTSIDE
// the database. A clone exists to be experimented on: someone runs the renewal
// job against it, or presses the notify button, and a real person gets mail
// about documents in an org they have never heard of, from a tenant named
// "CMF Rehearse". That is not a rehearsal, it is a live send.
//
// So the DEFAULT copies the STRUCTURE and not the RECIPIENTS:
//   - owner_key / owner_label survive verbatim. They are the part a human needs
//     to see -- the clone shows that 'QA', 'Insurance' and 'Purchasing' are the
//     owners this org routes by, and which documents name them.
//   - the recipient is replaced with a per-row placeholder at `clone.invalid`
//     (RFC 2606 reserves .invalid; it can never resolve or deliver). Per-ROW,
//     not per-label, because several rows may share one label and the unique
//     index is (tenant_id, owner_key, COALESCE(user_id, email)) -- one shared
//     placeholder would collapse three routes into one failed INSERT.
//   - `active = 0`. This is the important half. alert-routing.ts requires
//     `r.active = 1` and documents that flag as "the off switch" for a bare
//     address, so an inactive route is NOT a recipient: the clone reports a
//     routing GAP (`via: 'unrouted'` + an expirations.routing_gap audit row)
//     instead of silently believing it is routed. Redaction alone would have
//     recreated this script's original sin at a smaller scale -- something that
//     LOOKS configured with nothing real behind it.
//
// `--with-recipients` opts back into the verbatim copy for the case that
// justifies it: cloning an org for that same org's own staff to look at.
// --dry-run always prints how many real addresses are involved either way.
const ownerRouteAudit = { total: 0, portal_users: 0, bare_emails: 0, copied: WITH_RECIPIENTS };

// Per-row placeholder recipient. Keeps the owner key legible so the redaction
// is obvious on sight in the Owner Routes screen, and stays unique per row.
function redactedRecipient(row, i) {
  const base = String(row.owner_key || row.owner_label || 'owner')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '') || 'owner';
  return `${base}-${i + 1}@clone.invalid`;
}

// FK-safe insertion order.
//
// Dependency edges that dictate the CONFIGURATION block below (per SCHEMA.md):
//   requirements / claim_types / spec_tests    -> tenants only
//   claim_type_requirements                    -> claim_types + requirements
//   supplier_requirements                      -> suppliers + requirements
//   spec_limits                                -> spec_tests, and optionally
//                                                 suppliers / document_types /
//                                                 products via its scope columns
//   document_type_extraction_instructions      -> document_types
//   owner_routes                               -> users (or a bare email)
// suppliers / products / document_types are already above, so the whole block
// slots in after them and before anything document-shaped.
const TABLE_ORDER = [
  'suppliers',
  'products',
  'product_suppliers',
  'document_types',
  // --- configuration: what the org IS, not what it has stored ---
  'requirements',
  'claim_types',
  'claim_type_requirements',
  'supplier_requirements',
  'spec_tests',
  'spec_limits',
  'document_type_extraction_instructions',
  'supplier_extraction_instructions',
  'extraction_examples',
  'extraction_templates',
  'email_domain_mappings',
  'owner_routes',
  'assignments',
  'teach_sessions',
  'teach_messages',
  'customers',
  'customer_contacts',
  'documents',
  'document_versions',
  'document_products',
  'lots',
  'document_lots',
  'orders',
  'order_items',
  'lot_match_suggestions',
  'processing_queue',
  'reviewer_field_picks',
  'reviewer_field_dismissals',
  'reviewer_table_edits',
];

// remap[table] = Map(oldId -> newId)
const remap = {};
const counts = [];
const sqlLines = [];

// --- new tenant row ---
const newTenantId = newId();
const tcols = tableExists('tenants') ? columnsOf('tenants') : [];
const srcTenant = d1(`SELECT * FROM tenants WHERE id='${SRC_ID.replace(/'/g, "''")}' LIMIT 1;`)[0] || {};
{
  // Always write id/name/slug; for other target columns, only write what the
  // source tenant row actually has (target-only columns keep their DEFAULT).
  const SYNTH_T = new Set(['id', 'name', 'slug', 'created_at', 'updated_at']);
  const colNames = tcols
    .map(c => c.name)
    .filter(c => SYNTH_T.has(c) || Object.prototype.hasOwnProperty.call(srcTenant, c));
  const vals = colNames.map(c => {
    if (c === 'id') return sqlStr(newTenantId);
    if (c === 'name') return sqlStr(NEW_NAME);
    if (c === 'slug') {
      const slug = NEW_SLUG || ('clone-' + (srcTenant.slug || 'org') + '-' + newTenantId.slice(0, 6));
      return sqlStr(slug);
    }
    if (c === 'created_at' || c === 'updated_at') return "datetime('now')";
    return sqlStr(srcTenant[c]);
  });
  sqlLines.push(`INSERT INTO tenants (${colNames.map(n => '"' + n + '"').join(', ')}) VALUES (${vals.join(', ')});`);
}
counts.push({ table: 'tenants', rows: 1 });

const idEsc = SRC_ID.replace(/'/g, "''");

for (const table of TABLE_ORDER) {
  remap[table] = new Map();
  if (!tableExists(table)) { counts.push({ table, rows: 0, note: 'absent' }); continue; }
  const cols = columnsOf(table);
  const colNames = cols.map(c => c.name);
  const hasTenant = colNames.includes('tenant_id');

  // Build the source-row query (scoped to tenant directly or via parent set).
  let rows = [];
  const scope = SCOPE[table];
  if (hasTenant) {
    rows = d1(`SELECT * FROM ${table} WHERE tenant_id='${idEsc}';`);
  } else if (scope && remap[scope.parent]) {
    const parentIds = [...remap[scope.parent].keys()];
    if (parentIds.length === 0) { counts.push({ table, rows: 0 }); continue; }
    const inList = parentIds.map(id => "'" + String(id).replace(/'/g, "''") + "'").join(',');
    rows = d1(`SELECT * FROM ${table} WHERE ${scope.via} IN (${inList});`);
  } else {
    // No tenant_id and no known parent scope -> skip (can't safely scope).
    counts.push({ table, rows: 0, note: 'no-scope-skip' });
    continue;
  }

  // Audit owner_routes BEFORE the zero-row bail, so --dry-run can state the
  // real-recipient count in both the redacting and the --with-recipients case.
  if (table === 'owner_routes') {
    ownerRouteAudit.total = rows.length;
    for (const r of rows) {
      if (r.user_id != null) ownerRouteAudit.portal_users++;
      else if (r.email != null) ownerRouteAudit.bare_emails++;
    }
    counts.push({
      table,
      rows: rows.length,
      // No note on an empty table -- "recipients redacted" next to a 0 reads as
      // a claim about rows that do not exist.
      note: rows.length === 0
        ? undefined
        : WITH_RECIPIENTS ? 'recipients COPIED VERBATIM' : 'recipients redacted + active=0',
    });
  } else {
    counts.push({ table, rows: rows.length });
  }
  if (rows.length === 0) continue;

  // First pass: allocate new ids so self/cross refs within the batch resolve.
  for (const r of rows) remap[table].set(r.id, newId());

  const fkMap = FK[table] || {};
  const dropFk = DROP_FK[table] || new Set();
  // The target may carry columns the SOURCE row lacks (e.g. local's new
  // lot_scheme / supplier_product_map that prod doesn't have). For those, OMIT
  // the column from the INSERT so the TARGET's own DEFAULT (e.g. lot_scheme
  // NOT NULL DEFAULT 'auto') applies, instead of writing NULL. Always emit the
  // synthesized columns (id / tenant_id) even if absent in the source.
  const SYNTH = new Set(['id', 'tenant_id']);
  // Placeholder recipient per owner_routes row (see redactedRecipient above).
  // Built here rather than inline so the index is stable and unique per row.
  const routeRedaction =
    table === 'owner_routes' && !WITH_RECIPIENTS
      ? new Map(rows.map((r, i) => [r.id, redactedRecipient(r, i)]))
      : null;
  // Redaction REWRITES these three rather than copying them, so they must be
  // emitted whether or not the source row object carried the key. A user-shaped
  // route whose `email` key went missing would otherwise be written with
  // neither recipient and trip 0091's CHECK for the whole file.
  if (routeRedaction) { SYNTH.add('user_id'); SYNTH.add('email'); SYNTH.add('active'); }
  for (const r of rows) {
    const writeCols = colNames.filter(c => SYNTH.has(c) || Object.prototype.hasOwnProperty.call(r, c));
    const vals = writeCols.map(c => {
      if (c === 'id') return sqlStr(remap[table].get(r.id));
      if (c === 'tenant_id') return sqlStr(newTenantId);
      // owner_routes recipient policy. Handled HERE, ahead of the generic user-FK
      // rules, for two reasons: user_id is not in USER_FK_COLS (other tables use
      // that name for things this policy must not touch), and --null-user-fks
      // must never be allowed to NULL it -- a route with neither user_id nor
      // email violates 0091's CHECK and the whole file would fail.
      if (table === 'owner_routes') {
        if (routeRedaction) {
          // Redacting: force the row into the email shape with a dead address.
          if (c === 'user_id') return 'NULL';
          if (c === 'email') return sqlStr(routeRedaction.get(r.id));
          if (c === 'active') return '0';
        } else if (c === 'user_id') {
          // --with-recipients: keep the user, but the id has to exist in the
          // TARGET or the FK dangles (typical in --from-prod). resolveUserFk
          // substitutes a target user; it never returns NULL for a non-NULL
          // input, so the CHECK stays satisfied.
          return sqlStr(resolveUserFk(r[c]));
        }
      }
      if (c === 'created_at' || c === 'updated_at') {
        return r[c] == null ? 'NULL' : sqlStr(r[c]);
      }
      // FK columns referencing un-cloned tables (connectors etc.): NULL them
      // when nullable so they don't dangle. NOT NULL -> keep id (will fail loud).
      if (dropFk.has(c)) {
        const col = cols.find(x => x.name === c);
        if (!col || !col.notnull) return 'NULL';
        return sqlStr(r[c]);
      }
      // user FK columns: reuse id, or NULL nullable ones if requested, or remap
      // to a target user when the source id is absent from the target.
      if (USER_FK_COLS.has(c)) {
        if (NULL_USER_FKS) {
          const col = cols.find(x => x.name === c);
          if (col && !col.notnull) return 'NULL';
        }
        return sqlStr(resolveUserFk(r[c]));
      }
      // mapped FK columns -> look up the remapped id (fall back to original if
      // the referenced row wasn't in our scope, e.g. a cross-table value we
      // didn't clone; that keeps a valid reference to the source row).
      if (fkMap[c] != null) {
        const tgt = fkMap[c];
        if (r[c] != null && remap[tgt] && remap[tgt].has(r[c])) {
          return sqlStr(remap[tgt].get(r[c]));
        }
        return sqlStr(r[c]);
      }
      return sqlStr(r[c]);
    });
    sqlLines.push(`INSERT INTO ${table} (${writeCols.map(n => '"' + n + '"').join(', ')}) VALUES (${vals.join(', ')});`);
  }
}

// Persist the per-table counts for the bash side to render.
fs.writeFileSync(COUNTS, JSON.stringify({ newTenantId, counts, ownerRouteAudit }));

if (DRY_RUN) {
  // Emit nothing to the SQL file in dry-run.
  process.stdout.write('');
} else {
  process.stdout.write(
    'PRAGMA defer_foreign_keys=ON;\n' + sqlLines.join('\n') + '\n'
  );
}
NODE

# --- render counts ---
echo "Per-table row counts to copy (source tenant -> new tenant):"
node -e '
  const fs=require("fs");
  const {newTenantId,counts,ownerRouteAudit}=JSON.parse(fs.readFileSync(process.env.COUNTS,"utf8"));
  let total=0;
  for(const c of counts){
    const note=c.note?("  ("+c.note+")"):"";
    console.log("  "+c.table.padEnd(38)+String(c.rows).padStart(6)+note);
    if(c.table!=="tenants") total+=c.rows;
  }
  console.log("  "+"".padEnd(38)+"------");
  console.log("  "+"TOTAL (excl. tenant row)".padEnd(38)+String(total).padStart(6));

  // Say out loud how many REAL addresses this run would put in the clone. This
  // is the one number in the whole report that describes something able to
  // leave the database, so it gets its own paragraph rather than a column.
  const a=ownerRouteAudit||{total:0,portal_users:0,bare_emails:0,copied:false};
  const real=(a.portal_users||0)+(a.bare_emails||0);
  console.log("\n  owner_routes recipients:");
  if(a.total===0){
    console.log("    none -- the source tenant has no owner routes.");
  } else if(a.copied){
    console.log("    "+real+" REAL recipient(s) WOULD BE COPIED VERBATIM ("+a.bare_emails+" bare email address(es), "+a.portal_users+" portal user(s)).");
    console.log("    --with-recipients is set. The clone CAN email these people. Drop the flag to redact.");
  } else {
    console.log("    0 real email addresses would be copied.");
    console.log("    "+a.total+" route(s) cloned as label + structure only: recipient replaced with a");
    console.log("    dead @clone.invalid placeholder and active=0, so the clone routes NOTHING.");
    console.log("    ("+a.bare_emails+" bare email address(es) and "+a.portal_users+" portal user(s) in the source would be");
    console.log("     copied if you passed --with-recipients.)");
  }
  console.log("\n  new tenant id (would be): "+newTenantId);
'
echo

if [ "$DRY_RUN" = "1" ]; then
  echo "DRY-RUN complete. No rows written. Re-run without --dry-run to clone."
  exit 0
fi

if [ ! -s "$CLONE_SQL" ]; then
  echo "Nothing to write (empty clone script). Aborting." >&2
  exit 1
fi

if [ "$SKIP_CONFIRM" != "1" ]; then
  echo "About to WRITE the clone into: $TARGET_LABEL"
  echo "  source org: $SRC_NAME ($SRC_ID)   (READ-ONLY, never modified)"
  echo "  new tenant: $NEW_NAME"
  if [ "$TARGET" = "prod" ]; then
    read -r -p "Type 'clone-to-prod' to insert the new tenant into PROD: " reply
    [ "$reply" = "clone-to-prod" ] || { echo "Aborted."; exit 1; }
  else
    read -r -p "Type 'clone' to continue: " reply
    [ "$reply" = "clone" ] || { echo "Aborted."; exit 1; }
  fi
fi

echo "Writing clone..."
npx wrangler d1 execute "$DB" $REMOTE_FLAG --file="$CLONE_SQL"
echo
echo "Done. The clone tenant '$NEW_NAME' now exists on $TARGET_LABEL."
echo "R2: cloned docs reuse the ORIGINAL r2 keys (read-only reuse) -- see header."
echo "Next: run the Option B pipeline + bin/reprocess-multisublot against this tenant."

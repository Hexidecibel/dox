CLOUDFLARE_API_TOKEN = { ref = "inf://dev/doc-upload-site/CLOUDFLARE_API_TOKEN", target_vault = "cush", target_item = "doc-upload-site" }
CLOUDFLARE_ACCOUNT_ID = { ref = "inf://dev/doc-upload-site/CLOUDFLARE_ACCOUNT_ID", target_vault = "cush", target_item = "doc-upload-site" }
CLOUDFLARE_ZONE_ID_SUPDOX = { ref = "inf://dev/doc-upload-site/CLOUDFLARE_ZONE_ID_SUPDOX", target_vault = "cush", target_item = "doc-upload-site" }
